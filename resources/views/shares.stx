<script server>
/*
 * Your farm shares.
 *
 * One screen, one question: is a box coming, and when. Pausing is the control
 * that matters most and gets the most room, because a member who cannot easily
 * pause for a holiday cancels instead, and a cancelled member is one the farm
 * has to replace.
 */
const pageTitle = t('meta.shares_title')
const pageDescription = t('meta.shares_description')
const canonicalPath = '/shares'
</script>

<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-3xl" data-stx-content>
      <div class="pt-12 pb-24 sm:pb-40">
        <h1 class="text-[clamp(2rem,4.5vw,3rem)] font-semibold tracking-[-0.035em]">{{ t('shares.title') }}</h1>

        <p class="mt-3 max-w-xl text-[15px] leading-relaxed" style="color: var(--ink-soft)">
          {{ t('shares.lede') }}
        </p>

        {{-- What this page's own script writes, already translated. --}}
        <div hidden data-i18n-strings="{{ JSON.stringify({
          'shares.paused_until': t('shares.paused_until'),
          'shares.next_box': t('shares.next_box'),
          'shares.delivered': t('shares.delivered'),
          'shares.collected': t('shares.collected'),
          'shares.boxes_so_far': t('shares.boxes_so_far', { count: '{count}' }),
        }) }}"></div>

        <p :if="loading()" class="mt-10 text-[15px]" style="color: var(--ink-soft)">{{ t('common.loading') }}…</p>

        <div :if="!loading() && live().length === 0" class="p-8 mt-10 text-center rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
          <p class="text-[15px]" style="color: var(--ink-soft)">{{ t('shares.none') }}</p>
          <a href="/places/cardoon-farm" class="inline-block mt-4 text-[14px] underline underline-offset-4">{{ t('shares.see_farms') }}</a>
        </div>

        <div class="mt-10 space-y-3">
          <div :for="share in live()" class="p-1.5 rounded-[1.5rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
            <div class="p-6 rounded-[calc(1.5rem-0.375rem)]">
              <div class="flex flex-wrap gap-4 justify-between items-baseline">
                <div>
                  <a :href="'/places/' + share.farmSlug" class="text-[16px] font-semibold transition-opacity duration-500 hover:opacity-70">{{ share.farmName }}</a>
                  <p class="mt-1 text-[13px]" style="color: var(--ink-soft)">
                    {{ share.planName }} · {{ money(share.priceCents) }} {{ cadence(share.cadence) }}
                  </p>
                </div>

                <span
                  class="px-2.5 py-1 text-[11px] rounded-full"
                  :style="share.status === 'paused' ? 'border: 1px solid var(--line); color: var(--ink-soft)' : 'background: var(--accent-soft); color: var(--accent)'"
                >{{ share.status === 'paused' ? say('shares.paused_until', 'Paused until') + ' ' + share.pausedUntil : say('shares.next_box', 'Next box') + ' ' + share.nextBoxAt }}</span>
              </div>

              <p class="mt-3 text-[13px]" style="color: var(--ink-soft)">
                {{ share.fulfilment === 'delivery' ? say('shares.delivered', 'Delivered') : say('shares.collected', 'Collected from the farm') }}{{ share.boxesDelivered > 0 ? ' · ' + boxCount(share.boxesDelivered) : '' }}
              </p>

              <div class="flex flex-wrap gap-2 items-center mt-5">
                <button :if="share.status === 'paused'" @click="act(share.id, 'resume')" class="px-4 py-2 text-[13px] font-medium rounded-full transition-all duration-500 active:scale-[0.98]" style="background: var(--ink); color: var(--paper)">{{ t('shares.start_again') }}</button>

                <label :if="share.status !== 'paused'" class="flex gap-2 items-center text-[13px]" style="color: var(--ink-soft)">
                  {{ t('shares.pause_until') }}
                  <input type="date" :value="until()" @input="until.set($event.target.value)" class="px-3 py-1.5 text-[13px] rounded-full" style="background: var(--paper); border: 1px solid var(--line)">
                </label>
                <button :if="share.status !== 'paused'" @click="act(share.id, 'pause')" class="px-4 py-2 text-[13px] rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">{{ t('shares.pause') }}</button>

                <button @click="act(share.id, 'cancel')" class="ml-auto text-[13px] transition-opacity duration-500 hover:opacity-70" style="color: var(--ink-soft)">{{ t('shares.leave') }}</button>
              </div>

              <p :if="error() && erroredOn() === share.id" class="mt-3 text-[13px]" style="color: var(--accent)">{{ error() }}</p>
            </div>
          </div>
        </div>

        <section :if="past().length > 0" class="mt-12">
          <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('shares.ended') }}</h2>
          <ul class="mt-4 space-y-2 text-[14px]">
            <li :for="share in past()" style="color: var(--ink-soft)">{{ share.farmName }} · {{ share.planName }}</li>
          </ul>
        </section>
      </div>
    </main>

    <script client>
      import { money, send, visitorToken } from '../functions/session'

      /*
       * The words this script writes, in the language the server served.
       *
       * The English text is the second argument rather than a fallback to the
       * key, so a string no holder carries reads as English rather than as its
       * own name. The holder is in the markup above; the shared bundle is in
       * partials/head.stx.
       */
      function say(key, english) {
        return window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, english) : english
      }

      /* How many boxes have arrived, with the count where the sentence wants it. */
      function boxCount(boxes) {
        return say('shares.boxes_so_far', '{count} boxes so far').replace('{count}', boxes)
      }

      const shares = state([])
      const loading = state(true)
      const error = state('')
      const erroredOn = state(0)
      const until = state('')

      const live = derived(() => shares().filter(share => share.status !== 'cancelled'))
      const past = derived(() => shares().filter(share => share.status === 'cancelled'))

      function cadence(value) {
        if (value === 'weekly')
          return 'every week'

        if (value === 'biweekly')
          return 'every other week'

        return 'once a month'
      }

      async function load() {
        const { data } = await (await fetch('/api/csa/mine', { headers: { 'x-visitor': visitorToken() } })).json()

        shares.set(data)
        loading.set(false)
      }

      async function act(id, action) {
        const response = await send(`/api/csa/${id}/${action}`, { until: until() })

        if (!response.ok) {
          erroredOn.set(id)
          error.set((await response.json()).message)
          return
        }

        error.set('')
        load()
      }

      load()
    </script>
    @include('footer')
  </body>
</html>
