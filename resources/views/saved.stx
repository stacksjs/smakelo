<script server>
/*
 * Saved places.
 *
 * The list somebody opens when deciding where to eat, so it is a list and not
 * a dashboard. Rendered client-side because the saving happens against a
 * browser token rather than an account: the server has no way to know whose
 * page this is until the browser says so.
 */
const pageTitle = 'Saved - Smakelo'
const pageDescription = 'Places you kept.'
const canonicalPath = '/saved'
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-4xl">
      <div id="saved-root" class="pt-12 pb-24 sm:pb-40">
        <h1 class="text-[clamp(2rem,4.5vw,3rem)] font-semibold tracking-[-0.035em]">Saved</h1>
        <p class="mt-3 text-[15px]" style="color: var(--ink-soft)">Loading…</p>
      </div>
    </main>

    <script client>
      const root = document.getElementById('saved-root')

      const escapeHtml = value => String(value).replace(/[&<>"']/g, ch => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', '\'': '&#39;',
      }[ch]))

      function csrfToken() {
        const match = document.cookie.match(/(?:^|;\s*)X-CSRF-Token=([^;]+)/)
        return match ? decodeURIComponent(match[1]) : ''
      }

      function visitorToken() {
        let token = localStorage.getItem('smakelo.visitor')

        if (!token) {
          token = Array.from(crypto.getRandomValues(new Uint8Array(16)), b => b.toString(16).padStart(2, '0')).join('')
          localStorage.setItem('smakelo.visitor', token)
        }

        return token
      }

      async function load() {
        const response = await fetch('/api/saved', { headers: { 'x-visitor': visitorToken() } })
        const { data } = await response.json()

        root.innerHTML = `
          <h1 class="text-[clamp(2rem,4.5vw,3rem)] font-semibold tracking-[-0.035em]">Saved</h1>
          <p class="mt-3 max-w-xl text-[15px] leading-relaxed" style="color: var(--ink-soft)">
            Kept in this browser. There are no accounts here, so a different
            browser is a different list, and clearing your site data clears it.
          </p>

          ${data.length === 0
            ? `<div class="p-8 mt-10 text-center rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
                 <p class="text-[15px]" style="color: var(--ink-soft)">Nothing saved yet.</p>
                 <a href="/" class="inline-block mt-4 text-[14px] underline underline-offset-4">Go find somewhere</a>
               </div>`
            : `<div class="mt-10 space-y-3">${data.map(card).join('')}</div>`}`

        root.querySelectorAll('[data-unsave]').forEach((button) => {
          button.addEventListener('click', async () => {
            await fetch(`/api/businesses/${button.dataset.unsave}/save`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken(), 'x-visitor': visitorToken() },
              credentials: 'same-origin',
              body: '{}',
            })

            load()
          })
        })
      }

      function card(place) {
        return `
          <div class="p-1.5 rounded-[1.5rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
            <div class="flex flex-wrap gap-4 justify-between items-center p-6 rounded-[calc(1.5rem-0.375rem)]">
              <div class="min-w-0">
                <a href="/places/${place.slug}" class="text-[16px] font-semibold transition-opacity duration-500 hover:opacity-70">${escapeHtml(place.name)}</a>
                <p class="mt-1 text-[13px]" style="color: var(--ink-soft)">
                  ${escapeHtml(place.cuisine)} &middot; ${escapeHtml(place.city)}
                  ${place.ratingCount > 0 ? ` &middot; ${place.ratingAverage} from ${place.ratingCount}` : ''}
                </p>
              </div>

              <div class="flex gap-2 items-center shrink-0">
                ${place.isPartner
                  ? `<a href="/order?business=${place.slug}" class="px-4 py-2 text-[13px] font-medium rounded-full transition-all duration-500" style="background: var(--accent); color: #fff">Order</a>`
                  : `<span class="px-3 py-1 text-[11px] rounded-full" style="border: 1px solid var(--line); color: var(--ink-soft)">Listing only</span>`}
                <button data-unsave="${place.slug}" class="px-3 py-2 text-[13px] transition-opacity duration-500 hover:opacity-70" style="color: var(--ink-soft)">Remove</button>
              </div>
            </div>
          </div>`
      }

      load()
    </script>
  </body>
</html>
