<script server>
/*
 * Saved places.
 *
 * The list somebody opens when deciding where to eat, so it is a list and not
 * a dashboard. Rendered from signals: the markup lives in the markup, and the
 * script only decides what is true.
 */
const pageTitle = 'Saved - Smakelo'
const pageDescription = 'Places you kept.'
const canonicalPath = '/saved'
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-4xl" data-stx-content>
      <div class="pt-12 pb-24 sm:pb-40">
        <h1 class="text-[clamp(2rem,4.5vw,3rem)] font-semibold tracking-[-0.035em]">Saved</h1>

        <p class="mt-3 max-w-xl text-[15px] leading-relaxed" style="color: var(--ink-soft)">
          Kept in this browser. There are no accounts here, so a different
          browser is a different list, and clearing your site data clears it.
        </p>

        <p :if="loading()" class="mt-10 text-[15px]" style="color: var(--ink-soft)">Loading…</p>

        <div :if="!loading() && places().length === 0" class="p-8 mt-10 text-center rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
          <p class="text-[15px]" style="color: var(--ink-soft)">Nothing saved yet.</p>
          <a href="/" class="inline-block mt-4 text-[14px] underline underline-offset-4">Go find somewhere</a>
        </div>

        <div class="mt-10 space-y-3">
          <div :for="place in places()" class="p-1.5 rounded-[1.5rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
            <div class="flex flex-wrap gap-4 justify-between items-center p-6 rounded-[calc(1.5rem-0.375rem)]">
              <div class="flex flex-1 gap-4 items-center min-w-0">
                <div class="cover flex justify-center items-center w-12 h-12 rounded-[0.9rem] shrink-0" :style="'--h: ' + place.hue + '; --h2: ' + place.hueEnd">
                  <i class="cover-mark w-5 h-5" :class="place.iconClass"></i>
                  <img class="cover-photo" :src="place.photoThumb" alt="" loading="lazy" decoding="async" width="160" height="160">
                </div>

                <div class="min-w-0">
                  <a :href="'/places/' + place.slug" class="text-[16px] font-semibold transition-opacity duration-500 hover:opacity-70">{{ place.name }}</a>
                  <p class="mt-1 text-[13px]" style="color: var(--ink-soft)">
                    {{ place.cuisine }} · {{ place.city }}
                  </p>
                  <span :if="place.ratingCount > 0" class="inline-flex gap-1.5 items-center mt-1 text-[12px]">
                    <span class="stars text-[12px]">★★★★★<span :style="'width: ' + (place.ratingAverage / 5 * 100) + '%'">★★★★★</span></span>
                    <span style="color: var(--ink-soft)">{{ place.ratingAverage }} from {{ place.ratingCount }}</span>
                  </span>
                </div>
              </div>

              <div class="flex gap-2 items-center shrink-0">
                <a :if="place.isPartner" :href="'/order?business=' + place.slug" class="px-4 py-2 text-[13px] font-medium rounded-full transition-all duration-500" style="background: var(--accent); color: #fff">Order</a>
                <span :if="!place.isPartner" class="px-3 py-1 text-[11px] rounded-full" style="border: 1px solid var(--line); color: var(--ink-soft)">Listing only</span>
                <button @click="unsave(place.slug)" class="px-3 py-2 text-[13px] transition-opacity duration-500 hover:opacity-70" style="color: var(--ink-soft)">Remove</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script client>
      import { csrfToken, visitorToken } from '../functions/session'

      const places = state([])
      const loading = state(true)

      async function load() {
        const response = await fetch('/api/saved', { headers: { 'x-visitor': visitorToken() } })
        const { data } = await response.json()

        places.set(data)
        loading.set(false)
      }

      async function unsave(slug) {
        await fetch(`/api/businesses/${slug}/save`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken(), 'x-visitor': visitorToken() },
          credentials: 'same-origin',
          body: '{}',
        })

        load()
      }

      load()
    </script>
    @include('footer')
  </body>
</html>
