<script server>
/*
 * Sign in, or make an account.
 *
 * Optional by design. Everything on this site works from a browser token:
 * saved places, orders, reviews, shares. An account binds that token to a
 * person so the same list appears on a second device, which is the only thing
 * it actually buys and so the only thing it is sold as here.
 *
 * One page rather than two. Somebody who does not know whether they have an
 * account should not have to guess which page to be on, and the difference
 * between the two forms is one field.
 */
import { currentLocale, t } from '../../app/Actions/Locale/translate'

/*
 * The strings this page's own script writes, already translated.
 *
 * Built here and carried to the markup on a data attribute, the same way the
 * rest of this app hands the client a payload. Written inline in the markup
 * instead, stx sometimes reads it as a client expression and leaves the
 * literal `{{ JSON.stringify(` in the attribute, which is a page whose script
 * silently falls back to English. The shared strings are in partials/head.stx.
 */
const clientStrings = JSON.stringify({
  'account.title': t('account.title'),
  'account.make_account': t('account.make_account'),
  'account.sign_in': t('account.sign_in'),
  'account.one_moment': t('account.one_moment'),
  'account.make_the_account': t('account.make_the_account'),
  'account.already_have': t('account.already_have'),
  'account.no_account_yet': t('account.no_account_yet'),
  'account.make_one': t('account.make_one'),
  'account.continue_google': t('account.continue_google'),
  'account.continue_apple': t('account.continue_apple'),
  'account.did_not_work': t('account.did_not_work'),
  'account.carries_none': t('account.carries_none'),
  'account.carries_prefix': t('account.carries_prefix'),
  'account.carry_saved': t('account.carry_saved', { count: '{count}' }),
  'account.carry_orders_one': t('account.carry_orders_one', { count: '{count}' }),
  'account.carry_orders_many': t('account.carry_orders_many', { count: '{count}' }),
  'account.carry_reviews_one': t('account.carry_reviews_one', { count: '{count}' }),
  'account.carry_reviews_many': t('account.carry_reviews_many', { count: '{count}' }),
  'account.carry_shares_one': t('account.carry_shares_one', { count: '{count}' }),
  'account.carry_shares_many': t('account.carry_shares_many', { count: '{count}' }),
  'account.tile_saved_one': t('account.tile_saved_one'),
  'account.tile_saved_many': t('account.tile_saved_many'),
  'account.tile_orders_one': t('account.tile_orders_one'),
  'account.tile_orders_many': t('account.tile_orders_many'),
  'account.tile_reviews_one': t('account.tile_reviews_one'),
  'account.tile_reviews_many': t('account.tile_reviews_many'),
  'account.tile_shares_one': t('account.tile_shares_one'),
  'account.tile_shares_many': t('account.tile_shares_many'),
})

const pageTitle = t('meta.account_title')
const pageDescription = t('meta.account_description')
const canonicalPath = '/account'
</script>

<!DOCTYPE html>
<html lang="{{ currentLocale() }}">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-lg" data-stx-content>
      {{-- What this page's own script writes, already translated. --}}
      <div hidden data-i18n-strings="{{ clientStrings }}"></div>
      <div class="pt-14 pb-24 sm:pb-40">
        {{-- Signed in. --}}
        <div :if="user()">
          <div class="cover flex justify-center items-center mb-8 w-20 h-20 rounded-full" style="--h: 24; --h2: 62">
            <span class="cover-mark text-[24px] font-semibold">{{ initials() }}</span>
          </div>

          <h1 class="text-[clamp(1.9rem,4vw,2.5rem)] font-semibold tracking-[-0.03em]">{{ user().name || say('account.title', 'Your account') }}</h1>
          <p class="mt-2 text-[15px]" style="color: var(--ink-soft)">{{ user().email }}</p>

          <div class="grid grid-cols-2 gap-3 mt-8 sm:grid-cols-4">
            <a :for="tile in tiles()" :href="tile.href" class="p-5 rounded-[1.25rem] transition-transform duration-500 hover:-translate-y-0.5" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
              <i class="w-5 h-5" :class="tile.icon"></i>
              <p class="mt-3 text-[20px] font-semibold tabular-nums">{{ tile.count }}</p>
              <p class="text-[12px]" style="color: var(--ink-soft)">{{ tile.label }}</p>
            </a>
          </div>

          <button @click="signOut()" class="px-5 py-2.5 mt-8 text-[14px] font-medium rounded-full transition-all duration-500 active:scale-[0.98]" style="border: 1px solid var(--line); color: var(--ink-soft)">
            {{ t('nav.sign_out') }}
          </button>
        </div>

        {{-- Signed out. --}}
        <div :if="!user()">
          <h1 class="text-[clamp(1.9rem,4vw,2.5rem)] font-semibold tracking-[-0.03em]">
            {{ mode() === 'register' ? say('account.make_account', 'Make an account') : say('account.sign_in', 'Sign in') }}
          </h1>

          <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--ink-soft)">
            {{ t('account.intro_head') }}{{ carriesLine() }}.
            {{ t('account.intro_tail') }}
          </p>

          {{-- Both buttons, always. Which providers a site offers is a fact
            about the site, not about which secrets a given deployment
            happens to hold, and a page that renders a different set of
            buttons per environment looks broken in exactly the one where
            something is.

            An unconfigured provider is drawn as unavailable rather than
            omitted or left live: a live button with no keys behind it hands
            somebody to an error page that reads as this site's fault. --}}
          <div class="mt-8 space-y-2">
            <a
              :for="provider in providers().filter(entry => entry.configured)"
              :href="'/auth/' + provider.name"
              class="flex gap-3 justify-center items-center px-5 py-3.5 w-full text-[15px] font-medium rounded-full transition-all duration-500 hover:-translate-y-px active:scale-[0.99]"
              style="border: 1px solid var(--line)"
            >
              <i class="w-5 h-5" :class="provider.icon"></i>
              {{ provider.label }}
            </a>

            <button
              :for="provider in providers().filter(entry => !entry.configured)"
              type="button"
              disabled
              class="flex gap-3 justify-center items-center px-5 py-3.5 w-full text-[15px] font-medium rounded-full cursor-not-allowed"
              style="border: 1px dashed var(--line); color: var(--ink-soft)"
            >
              <i class="w-5 h-5 opacity-60" :class="provider.icon"></i>
              {{ provider.label }}
            </button>
          </div>

          <p :if="providers().some(entry => !entry.configured)" class="mt-3 text-[12px] leading-relaxed" style="color: var(--ink-soft)">
            {{ t('account.providers_note') }}
          </p>

          <div class="flex gap-4 items-center my-8">
            <span class="flex-1 h-px" style="background: var(--line)"></span>
            <span class="text-[12px]" style="color: var(--ink-soft)">{{ t('account.or_with_email') }}</span>
            <span class="flex-1 h-px" style="background: var(--line)"></span>
          </div>

          <div class="mt-6 space-y-3">
            <label :if="mode() === 'register'" class="block">
              <span class="text-[12px] font-medium" style="color: var(--ink-soft)">{{ t('account.your_name') }}</span>
              <input
                :value="name()"
                @input="name.set($event.target.value)"
                maxlength="120"
                class="px-4 py-3 mt-1.5 w-full text-[15px] rounded-[1rem]"
                style="background: var(--paper-raised); border: 1px solid var(--line)"
              >
            </label>

            <label class="block">
              <span class="text-[12px] font-medium" style="color: var(--ink-soft)">{{ t('account.email') }}</span>
              <input
                type="email"
                autocomplete="email"
                :value="email()"
                @input="email.set($event.target.value)"
                maxlength="200"
                class="px-4 py-3 mt-1.5 w-full text-[15px] rounded-[1rem]"
                style="background: var(--paper-raised); border: 1px solid var(--line)"
              >
            </label>

            <label class="block">
              <span class="text-[12px] font-medium" style="color: var(--ink-soft)">{{ t('account.password') }}</span>
              <input
                type="password"
                :autocomplete="mode() === 'register' ? 'new-password' : 'current-password'"
                :value="password()"
                @input="password.set($event.target.value)"
                maxlength="200"
                class="px-4 py-3 mt-1.5 w-full text-[15px] rounded-[1rem]"
                style="background: var(--paper-raised); border: 1px solid var(--line)"
              >
            </label>
          </div>

          <p :if="error()" class="mt-4 text-[14px]" style="color: var(--accent)">{{ error() }}</p>

          <button
            @click="submit()"
            class="flex gap-3 justify-center items-center px-5 py-3.5 mt-6 w-full text-[15px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.99]"
            style="background: var(--ink); color: var(--paper)"
          >
            {{ busy() ? say('account.one_moment', 'One moment…') : (mode() === 'register' ? say('account.make_the_account', 'Make the account') : say('account.sign_in', 'Sign in')) }}
          </button>

          <p class="mt-5 text-[14px] text-center" style="color: var(--ink-soft)">
            {{ mode() === 'register' ? say('account.already_have', 'Already have one?') : say('account.no_account_yet', 'No account yet?') }}
            <button @click="toggleMode()" class="underline underline-offset-4" style="color: var(--ink)">
              {{ mode() === 'register' ? say('account.sign_in', 'Sign in') : say('account.make_one', 'Make one') }}
            </button>
          </p>

          <p class="mt-8 text-[12px] leading-relaxed" style="color: var(--ink-soft)">
            {{ t('account.agree_prefix') }} <a href="/terms" class="underline underline-offset-4">{{ t('account.terms') }}</a>
            {{ t('account.agree_middle') }} <a href="/privacy" class="underline underline-offset-4">{{ t('account.privacy') }}</a>{{ t('account.agree_suffix') }}
          </p>
        </div>
      </div>
    </main>

    <script client>
      import { authToken, clearAuthToken, send, setAuthToken, visitorToken } from '../functions/session'

      /*
       * The words this script writes, in the language the server served.
       *
       * The English text is the second argument rather than a fallback to the
       * key, so a string no holder carries reads as English rather than as its
       * own name. The page's holder is in the markup above; the shared bundle
       * is in partials/head.stx.
       */
      function say(key, english) {
        return window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, english) : english
      }

      const user = state(null)
      /* Seeded rather than empty, so the two buttons are on the page at first
         paint instead of appearing a round trip later. The fetch below only
         corrects which of them can actually be completed. */
      const providers = state([
        { name: 'google', label: say('account.continue_google', 'Continue with Google'), icon: 'i-hugeicons-google', configured: false },
        { name: 'apple', label: say('account.continue_apple', 'Continue with Apple'), icon: 'i-hugeicons-apple', configured: false },
      ])
      const carries = state({ saved: 0, orders: 0, reviews: 0, shares: 0 })
      const mode = state('login')
      const name = state('')
      const email = state('')
      const password = state('')
      const error = state('')
      const busy = state(false)

      const initials = derived(() => {
        const current = user()

        if (!current)
          return ''

        const words = String(current.name || current.email).split(/[\s@.]+/).filter(Boolean)

        return words.length > 1
          ? `${words[0][0]}${words[1][0]}`.toUpperCase()
          : String(words[0] || '?').slice(0, 2).toUpperCase()
      })

      /* What a tile counts, singular or plural. Separate keys rather than an
         English rule, because "1 Bewertung" and "2 Bewertungen" do not differ
         by an s the way the English pair happens to. */
      function tileLabel(kind, count, one, many) {
        return say(`account.tile_${kind}_${count === 1 ? 'one' : 'many'}`, count === 1 ? one : many)
      }

      const tiles = derived(() => [
        { label: tileLabel('saved', carries().saved, 'saved place', 'saved places'), count: carries().saved, href: '/saved', icon: 'i-hugeicons-bookmark-02' },
        { label: tileLabel('orders', carries().orders, 'order', 'orders'), count: carries().orders, href: '/orders', icon: 'i-hugeicons-delivery-truck-01' },
        { label: tileLabel('reviews', carries().reviews, 'review', 'reviews'), count: carries().reviews, href: '/', icon: 'i-hugeicons-star' },
        { label: tileLabel('shares', carries().shares, 'share', 'shares'), count: carries().shares, href: '/shares', icon: 'i-hugeicons-plant-01' },
      ])

      /*
       * "Everything works already" is a claim; this puts a number on it, or
       * admits there is nothing to keep yet rather than pretending otherwise.
       */
      const carriesLine = derived(() => {
        const total = carries().saved + carries().orders + carries().reviews + carries().shares

        if (total === 0)
          return say('account.carries_none', ', though there is nothing saved here yet')

        /*
         * Counted properly: "1 reviews" is the tell of a number pushed through
         * a template that never looked at it. The singular and the plural are
         * separate keys rather than an English rule applied to three
         * languages, because "1 Bewertung" and "2 Bewertungen" do not differ
         * by an s the way the English pair happens to.
         */
        const plural = (count, key, english) => say(
          `account.${key}_${count === 1 ? 'one' : 'many'}`,
          `{count} ${count === 1 ? english[0] : english[1]}`,
        ).replace('{count}', count)

        const parts = []

        if (carries().saved > 0)
          parts.push(say('account.carry_saved', '{count} saved').replace('{count}', carries().saved))

        if (carries().orders > 0)
          parts.push(plural(carries().orders, 'carry_orders', ['order', 'orders']))

        if (carries().reviews > 0)
          parts.push(plural(carries().reviews, 'carry_reviews', ['review', 'reviews']))

        if (carries().shares > 0)
          parts.push(plural(carries().shares, 'carry_shares', ['share', 'shares']))

        return `${say('account.carries_prefix', ', with')} ${parts.join(', ')}`
      })

      function toggleMode() {
        mode.set(mode() === 'register' ? 'login' : 'register')
        error.set('')
      }

      async function load() {
        const headers = { 'x-visitor': visitorToken() }
        const token = authToken()

        if (token)
          headers.Authorization = `Bearer ${token}`

        const response = await fetch('/api/account', { headers })

        if (!response.ok)
          return

        const { data } = await response.json()

        user.set(data.user)
        providers.set(data.providers)
        carries.set(data.carries)
      }

      async function submit() {
        busy.set(true)
        error.set('')

        /*
         * The framework's own endpoints, unprefixed: `/login` and `/register`
         * are mounted by the auth route bundle, not by this app's `/api`
         * routes. Rate limited server-side at 5 and 3 a minute.
         */
        const response = await send(mode() === 'register' ? '/register' : '/login', {
          name: name(),
          email: email(),
          password: password(),
        })

        const payload = await response.json().catch(() => ({}))

        busy.set(false)

        if (!response.ok) {
          error.set(payload.message || say('account.did_not_work', 'That did not work.'))
          return
        }

        setAuthToken(payload.access_token)

        // Carry this browser's saved places and orders onto the account, so
        // signing up after ordering as a guest does not look like starting over.
        await send('/api/account/link')

        load()
      }

      async function signOut() {
        clearAuthToken()
        user.set(null)
        password.set('')

        // Back to signing in, not to making a second account. Somebody who has
        // just signed out has an account by definition.
        mode.set('login')

        load()
      }

      load()
    </script>
    @include('footer')
  </body>
</html>
