<script client>
import { money } from '../functions/session'
import { tableSessionHandlers } from '../functions/table-session'

const session = state(null)
const bill = state(null)
const splitMode = state('')
const loading = state(true)
const token = state('')
const billError = state(false)
const closing = state(false)
const billHeading = useRef('billHeading')

const {
  load, close: closeTab, menuLink, say,
  currency, tabTotal, numberedRounds, numberedShares,
} = tableSessionHandlers({ session, bill, splitMode, loading, token, billError, closing })

async function close(mode) {
  await closeTab(mode)

  if (bill())
    void nextTick(() => billHeading.current?.focus())
}

load()
</script>

@include('table-session')
