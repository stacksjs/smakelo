<script server>
/*
 * The page a table's QR code opens.
 *
 * Reached as `/t?code=<token>`, and by `/t/<token>` through a rewrite, because
 * a code printed on a table tent should be short and a query string on a
 * printed card is noise.
 *
 * Client-rendered against the API for the same reason ordering is: this reads
 * the code off the URL, which puts it on the per-request render path where stx
 * drops awaited values (stacksjs/stacks#2390).
 */
import { currentLocale, t } from '../../app/Actions/Locale/translate'

/*
 * The strings this page's own script writes, already translated.
 *
 * Built here and carried to the markup on a data attribute, the same way the
 * rest of this app hands the client a payload. Written inline in the markup
 * instead, stx sometimes reads it as a client expression and leaves the
 * literal `{{ JSON.stringify(` in the attribute, which is a page whose script
 * silently falls back to English. The shared strings are in partials/head.stx.
 */
const clientStrings = JSON.stringify({
  'table.add_round': t('table.add_round'),
  'table.see_menu': t('table.see_menu'),
  'table.split_ways': t('table.split_ways'),
  'table.each_round': t('table.each_round'),
  'table.person': t('table.person'),
  'table.round': t('table.round'),
})

const pageTitle = t('meta.tab_title')
const pageDescription = t('meta.tab_description')
const canonicalPath = '/t'
</script>

<!DOCTYPE html>
<html lang="{{ currentLocale() }}">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-3xl" data-stx-content>
      <div class="pt-10 pb-24 sm:pb-40">
        {{-- What this page's own script writes, already translated. --}}
        <div hidden data-i18n-strings="{{ clientStrings }}"></div>

        <p :if="loading()" class="text-[15px]" style="color: var(--ink-soft)">{{ t('table.finding_table') }}</p>

        <p :if="!loading() && !token()" class="text-[15px]">{{ t('table.scan_to_start') }}</p>

        <p :if="!loading() && token() && !session()" class="text-[15px]">{{ t('table.code_no_match') }}</p>

        {{-- The tab, while it is open. --}}
        <div :if="session() && !bill()">
          <p class="text-[13px]" style="color: var(--ink-soft)">{{ session().business.name }}</p>
          <h1 class="mt-1 text-[clamp(2rem,4.5vw,3rem)] font-semibold tracking-[-0.035em]">{{ t('kitchen.table') }} {{ session().table.label }}</h1>
          <p class="mt-3 text-[15px]" style="color: var(--ink-soft)">
            {{ t('table.tab_open_lede') }}
          </p>

          <a
            :href="'/order?business=' + session().business.slug"
            class="inline-flex gap-3 items-center px-5 py-3 mt-6 text-[14px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] group"
            style="background: var(--accent); color: #fff"
          >
            <span>{{ session().rounds.length > 0 ? say('table.add_round', 'Order more') : say('table.see_menu', 'See the menu') }}</span>
            <span class="flex justify-center items-center w-7 h-7 rounded-full transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5" style="background: rgba(255,255,255,0.2)">
              <i class="w-3.5 h-3.5 i-hugeicons-arrow-right-01"></i>
            </span>
          </a>

          <section :if="session().rounds.length > 0" class="mt-12">
            <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('table.tab_open') }}</h2>

            <div class="mt-4 space-y-3">
              <div :for="round in numberedRounds()" class="p-1.5 rounded-[1.5rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
                <div class="p-5 rounded-[calc(1.5rem-0.375rem)]">
                  <div class="flex justify-between items-baseline">
                    <p class="text-[14px] font-medium">{{ say('table.round', 'Round') }} {{ round.number }}</p>
                    <p class="text-[14px] tabular-nums">{{ money(round.totalCents, currency()) }}</p>
                  </div>

                  <ul class="mt-3 space-y-1 text-[14px]" style="color: var(--ink-soft)">
                    <li :for="item in round.items">
                      {{ item.quantity }} × {{ item.name }}<span :if="item.modifiers.length > 0" style="opacity:.75"> ({{ item.modifiers.join(', ') }})</span>
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <div class="p-1.5 mt-6 rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 16px 32px -22px rgba(20,17,15,0.12)">
              <div class="p-6 rounded-[calc(1.75rem-0.375rem)]">
                <div class="flex justify-between text-[17px] font-semibold">
                  <span>{{ t('table.tab_total') }}</span>
                  <span class="tabular-nums">{{ money(tabTotal(), currency()) }}</span>
                </div>

                <p class="mt-4 text-[12px] font-medium tracking-[0.16em] uppercase" style="color: var(--ink-soft)">{{ t('table.ask_for_bill') }}</p>

                <div class="flex flex-wrap gap-2 mt-3">
                  <button @click="close('even')" class="px-4 py-2 text-[13px] rounded-full transition-all duration-500" style="border: 1px solid var(--line)">{{ t('table.split_evenly') }}</button>
                  <button @click="close('by_item')" class="px-4 py-2 text-[13px] rounded-full transition-all duration-500" style="border: 1px solid var(--line)">{{ t('table.split_by_item') }}</button>
                </div>
              </div>
            </div>
          </section>
        </div>

        {{-- The bill, once somebody has asked for it. --}}
        <div :if="bill()" class="mx-auto max-w-lg p-1.5 rounded-[2rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 18px 36px -22px rgba(20,17,15,0.14)">
          <div class="p-8 rounded-[calc(2rem-0.375rem)]">
            <h1 class="text-[24px] font-semibold tracking-[-0.02em]">{{ t('table.the_bill') }}</h1>
            <p class="mt-2 text-[14px]" style="color: var(--ink-soft)">
              {{ splitMode() === 'even' ? say('table.split_ways', 'Split') + ' ' + bill().shares.length : say('table.each_round', 'Each round billed to whoever ordered it') }}
            </p>

            <ul class="mt-6 space-y-2 text-[15px]">
              <li :for="share in numberedShares()" class="flex justify-between">
                <span style="color: var(--ink-soft)">{{ (splitMode() === 'even' ? say('table.person', 'Person') : say('table.round', 'Round')) + ' ' + share.number }}</span>
                <span class="tabular-nums">{{ money(share.cents, currency()) }}</span>
              </li>
            </ul>

            <div class="flex justify-between pt-4 mt-4 text-[17px] font-semibold border-t" style="border-color: var(--line)">
              <span>{{ t('table.total') }}</span>
              <span class="tabular-nums">{{ money(bill().totalCents, currency()) }}</span>
            </div>

            <p class="mt-6 text-[12px]" style="color: var(--ink-soft)">{{ t('table.test_mode') }}</p>
          </div>
        </div>
      </div>
    </main>

    <script client>
      import { money, send } from '../functions/session'

      /*
       * The words this script writes, in the language the server served.
       *
       * The English text is the second argument rather than a fallback to the
       * key, so a string no holder carries reads as English rather than as its
       * own name. The page's holder is in the markup above; the shared bundle
       * is in partials/head.stx.
       */
      function say(key, english) {
        return window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, english) : english
      }

      const session = state(null)
      const bill = state(null)
      const splitMode = state('')
      const loading = state(true)
      const token = state('')

      const currency = derived(() => session() ? session().business.currency : 'usd')

      const tabTotal = derived(() => session()
        ? session().rounds.reduce((sum, round) => sum + round.totalCents, 0)
        : 0)

      /*
       * Rounds and shares carry their own number.
       *
       * `:for` gives the item, not its index, and "Round 3" is part of what the
       * row says rather than decoration, so the number is attached to the data
       * instead of being counted in the template.
       */
      const numberedRounds = derived(() => session()
        ? session().rounds.map((round, index) => ({ ...round, number: index + 1 }))
        : [])

      const numberedShares = derived(() => bill()
        ? bill().shares.map((cents, index) => ({ cents, number: index + 1 }))
        : [])

      async function load() {
        /*
         * Accept both shapes: `/t/<token>` from the printed code, and
         * `/t?code=<token>` for anything that cannot rewrite.
         *
         * The optional locale segment is part of the pattern because the views
         * server serves this page at `/de/t` and `/nl/t` too. Stripping a bare
         * leading `/t` instead left the German path intact - `/de/t` came
         * through as if it were the token, the API was asked for a table with
         * that name, and the page said the code did not match a table. In
         * English only, it worked.
         */
        const fromPath = location.pathname.match(/^(?:\/[a-z]{2})?\/t\/(.+)$/)?.[1] ?? ''
        const found = decodeURIComponent(fromPath).trim() || new URLSearchParams(location.search).get('code') || ''

        token.set(found)

        if (!found) {
          loading.set(false)
          return
        }

        const response = await fetch(`/api/table-sessions/${encodeURIComponent(found)}`)

        session.set(response.ok ? (await response.json()).data : null)
        loading.set(false)
      }

      async function close(mode) {
        const response = await send(`/api/tabs/${session().tab.id}/close`, {
          splitMode: mode,
          ways: session().table.seats,
        })

        if (!response.ok)
          return

        splitMode.set(mode)
        bill.set((await response.json()).data)
      }

      load()
    </script>
    @include('footer')
  </body>
</html>
