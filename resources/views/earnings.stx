<script server>
/*
 * Money owed, and to whom.
 *
 * One screen serves the merchant, the courier and the platform, because they
 * are asking the same question of the same ledger and giving each a bespoke
 * arithmetic is how three screens end up disagreeing about one order. What
 * differs is only which rows you are allowed to see, and that comes from the
 * session: a merchant lands on their own statement, a courier on theirs, and
 * only operations sees the list of every balance.
 *
 * `?party=business:3` still addresses one statement directly, which is what
 * the merchant screen's earnings link uses; the server checks it is yours.
 */
import { currentLocale, t } from '../../app/Actions/Locale/translate'

/*
 * The strings this page's own script writes, already translated.
 *
 * Built here and carried to the markup on a data attribute, the same way the
 * rest of this app hands the client a payload. Written inline in the markup
 * instead, stx sometimes reads it as a client expression and leaves the
 * literal `{{ JSON.stringify(` in the attribute, which is a page whose script
 * silently falls back to English. The shared strings are in partials/head.stx.
 */
const clientStrings = JSON.stringify({
  'earnings.food_and_drink': t('earnings.food_and_drink'),
  'earnings.delivery': t('earnings.delivery'),
  'earnings.tips': t('earnings.tips'),
  'earnings.sales_tax': t('earnings.sales_tax'),
  'earnings.tax_inside': t('earnings.tax_inside'),
  'earnings.service_fee': t('earnings.service_fee'),
  'earnings.paid_out': t('earnings.paid_out'),
  'earnings.owed_to': t('earnings.owed_to'),
  'earnings.kept_by_platform': t('earnings.kept_by_platform'),
  'earnings.sales_tax_held': t('earnings.sales_tax_held'),
  'earnings.earned': t('earnings.earned'),
  'earnings.outstanding': t('earnings.outstanding'),
  'earnings.order_ref': t('earnings.order_ref', { id: '{id}' }),
  'earnings.party_tax': t('earnings.party_tax'),
  'earnings.party_unassigned': t('earnings.party_unassigned'),
  'earnings.type_business': t('earnings.type_business'),
  'earnings.type_courier': t('earnings.type_courier'),
  'earnings.type_platform': t('earnings.type_platform'),
  'earnings.type_tax': t('earnings.type_tax'),
})

/* The empty state's own sentence; see partials/operator-empty.stx. */
const operatorNothing = t('earnings.none_of_yours')

const pageTitle = t('meta.earnings_title')
const pageDescription = t('meta.earnings_description')
const canonicalPath = '/earnings'
</script>

<!DOCTYPE html>
<html lang="{{ currentLocale() }}">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-4xl" data-stx-content>
      <div class="pt-10 pb-24 sm:pb-40">
        {{-- What this page's own script writes, already translated. --}}
        <div hidden data-i18n-strings="{{ clientStrings }}"></div>

        <p :if="loading()" class="text-[15px]" style="color: var(--ink-soft)">{{ t('common.loading') }}…</p>

        {{-- Everyone's balance, for the operator. --}}
        @include('operator-empty')

        {{-- Every balance. Operations only: a merchant lands on their own. --}}
        <div :if="!loading() && !party() && canSeeAll()">
          <h1 class="text-[clamp(1.9rem,4vw,2.75rem)] font-semibold tracking-[-0.03em]">{{ t('earnings.balances') }}</h1>

          <p class="mt-3 max-w-xl text-[15px] leading-relaxed" style="color: var(--ink-soft)">
            {{ t('earnings.lede') }}
          </p>

          <div class="grid grid-cols-1 gap-3 mt-8 sm:grid-cols-3">
            <div :for="tile in tiles()" class="p-6 rounded-[1.5rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
              <span class="flex justify-center items-center w-9 h-9 rounded-[0.75rem]" style="background: var(--accent-soft); color: var(--accent)">
                <i class="w-4.5 h-4.5" :class="tile.icon"></i>
              </span>
              <p class="mt-4 text-[28px] font-semibold tracking-[-0.02em] tabular-nums">{{ money(tile.cents) }}</p>
              <p class="mt-1 text-[13px]" style="color: var(--ink-soft)">{{ tile.label }}</p>
            </div>
          </div>

          <div class="mt-10 space-y-2">
            <a
              :for="row in balances()"
              :href="'/earnings?party=' + row.partyType + ':' + row.partyId"
              class="flex gap-4 justify-between items-center p-5 rounded-[1.25rem] transition-transform duration-500 hover:-translate-y-0.5"
              style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)"
            >
              <span class="flex flex-1 gap-3 items-center min-w-0">
                <span class="flex justify-center items-center w-9 h-9 rounded-[0.7rem] shrink-0" style="background: var(--accent-soft); color: var(--accent)">
                  <i class="w-4 h-4" :class="partyIcon(row.partyType)"></i>
                </span>
                <span class="min-w-0">
                  <span class="block text-[15px] font-medium truncate">{{ partyName(row) }}</span>
                  <span class="block text-[12px]" style="color: var(--ink-soft)">{{ partyKind(row.partyType) }}</span>
                </span>
              </span>
              <span class="text-[15px] tabular-nums shrink-0">{{ money(row.balanceCents) }}</span>
            </a>
          </div>
        </div>

        {{-- One party's statement. --}}
        <div :if="!loading() && party() && statement()">
          {{-- Only operations has a list of every balance to go back to. --}}
          <a :if="canSeeAll()" href="/earnings" class="text-[13px] transition-opacity duration-500 hover:opacity-70" style="color: var(--ink-soft)">← {{ t('earnings.all_balances') }}</a>

          <h1 class="mt-4 text-[clamp(1.9rem,4vw,2.75rem)] font-semibold tracking-[-0.03em]">{{ partyName(statement().party) }}</h1>
          <p class="mt-1 text-[13px]" style="color: var(--ink-soft)">{{ partyKind(statement().party.partyType) }}</p>

          <div class="grid grid-cols-1 gap-3 mt-8 sm:grid-cols-3">
            <div :for="tile in statementTiles()" class="p-6 rounded-[1.5rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
              <p class="text-[26px] font-semibold tracking-[-0.02em] tabular-nums">{{ money(tile.cents, statement().currency) }}</p>
              <p class="mt-1 text-[13px]" style="color: var(--ink-soft)">{{ tile.label }}</p>
            </div>
          </div>

          <section :if="earned().length > 0" class="mt-10">
            <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('earnings.where_from') }}</h2>
            <ul class="mt-4 space-y-2 text-[15px]">
              <li :for="row in earned()" class="flex gap-4 justify-between">
                <span>{{ label(row.kind) }}</span>
                <span class="tabular-nums">{{ money(row.cents, statement().currency) }}</span>
              </li>
            </ul>
          </section>

          <div :if="canPayOut()" class="p-6 mt-10 rounded-[1.5rem]" style="background: var(--accent-soft)">
            <p class="text-[14px] leading-relaxed" style="color: var(--ink)">
              {{ t('earnings.payout_note') }}
            </p>
            <button @click="payOut()" class="px-5 py-2.5 mt-4 text-[14px] font-medium rounded-full transition-all duration-500 active:scale-[0.98]" style="background: var(--accent); color: #fff">
              {{ t('earnings.pay_out') }} {{ money(statement().outstandingCents, statement().currency) }}
            </button>
            <p :if="error()" class="mt-3 text-[13px]" style="color: var(--ink)">{{ error() }}</p>
          </div>

          <section class="mt-10">
            <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('earnings.every_row') }}</h2>

            <p :if="statement().lines.length === 0" class="mt-4 text-[15px]" style="color: var(--ink-soft)">{{ t('earnings.nothing_yet') }}</p>

            <ul class="mt-4 space-y-2 text-[14px]">
              <li :for="line in statement().lines" class="flex gap-4 justify-between py-2 border-b" style="border-color: var(--line)">
                <span class="min-w-0">
                  <span class="block truncate">{{ line.description || label(line.kind) }}</span>
                  <span :if="line.orderId" class="block text-[12px]" style="color: var(--ink-soft)">{{ orderRef(line.orderId) }}</span>
                </span>
                <span class="tabular-nums shrink-0" :style="line.amountCents < 0 ? 'color: var(--ink-soft)' : ''">
                  {{ line.amountCents < 0 ? '−' : '' }}{{ money(line.amountCents, statement().currency) }}
                </span>
              </li>
            </ul>
          </section>
        </div>

        <p :if="!loading() && party() && !denied() && !statement()" class="text-[15px]">{{ t('earnings.no_statement') }}</p>
      </div>
    </main>

    <script client>
      import { get, may, me, money, send } from '../functions/session'

      /*
       * The words this script writes, in the language the server served.
       *
       * The English text is the second argument rather than a fallback to the
       * key, so a string no holder carries reads as English rather than as its
       * own name. The page's holder is in the markup above; the shared bundle
       * is in partials/head.stx.
       */
      function say(key, english) {
        return window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, english) : english
      }

      const party = state('')
      const balances = state([])

      /* Who is signed in, and whether they read everybody's ledger or one. */
      const signedIn = state(false)
      const canSeeAll = state(false)
      const canRecordPayouts = state(false)
      const denied = state(false)

      /* What this page resolved; see partials/operator-empty.stx. */
      const allowed = derived(() => Boolean(statement()) || canSeeAll())

      /* The ledger is about a party rather than a business, so there is
         nothing to switch between - but partials/operator-empty is shared with
         the screens that do. */
      const mine = state([])

      function operatorLink() {
        return '/earnings'
      }

      /* What operator-empty checks for "you asked for nothing in particular". */
      const slug = derived(() => party())
      const statement = state(null)
      /*
       * What to call a party.
       *
       * Two of them are not names but labels for a party that has none: the
       * pile of sales tax, and the delivery money owed from the moment an
       * order is placed - which is before anybody has been assigned to carry
       * it. The API answers with an English default, and says which kind of
       * row it is, so the label belongs here with the rest of the interface
       * rather than in a payload that other callers read too.
       */
      function partyName(row) {
        if (!row)
          return ''

        if (row.partyType === 'tax')
          return say('earnings.party_tax', 'Sales tax held for remittance')

        if (row.partyType === 'courier' && Number(row.partyId) === 0)
          return say('earnings.party_unassigned', 'Awaiting a courier')

        return row.name
      }

      /* Which side of the ledger a party sits on, in words rather than as the
         column value. */
      /* Which order a ledger row came from. */
      function orderRef(id) {
        return say('earnings.order_ref', 'Order #{id}').replace('{id}', id)
      }

      function partyKind(type) {
        return say(`earnings.type_${type}`, String(type ?? ''))
      }

      const loading = state(true)
      const error = state('')

      const LABELS = {
        order_revenue: say('earnings.food_and_drink', 'Food and drink'),
        delivery_fee: say('earnings.delivery', 'Delivery'),
        tip: say('earnings.tips', 'Tips'),
        tax_collected: say('earnings.sales_tax', 'Sales tax'),
        tax_withheld: say('earnings.tax_inside', 'Tax inside the menu price'),
        service_fee: say('earnings.service_fee', 'Service fee'),
        payout: say('earnings.paid_out', 'Paid out'),
      }

      function partyIcon(type) {
        return {
          business: 'i-hugeicons-restaurant-01',
          courier: 'i-hugeicons-bicycle-01',
          platform: 'i-hugeicons-money-bag-02',
          tax: 'i-hugeicons-checkmark-circle-02',
        }[type] || 'i-hugeicons-user-circle'
      }

      function label(kind) {
        return LABELS[kind] || String(kind).replace(/_/g, ' ')
      }

      const sumOf = types => balances()
        .filter(row => types.includes(row.partyType))
        .reduce((total, row) => total + row.balanceCents, 0)

      const tiles = derived(() => [
        { label: say('earnings.owed_to', 'Owed to merchants and couriers'), cents: sumOf(['business', 'courier']), icon: 'i-hugeicons-delivery-truck-01' },
        { label: say('earnings.kept_by_platform', 'Kept by the platform'), cents: sumOf(['platform']), icon: 'i-hugeicons-money-bag-02' },
        { label: say('earnings.sales_tax_held', 'Sales tax held'), cents: sumOf(['tax']), icon: 'i-hugeicons-checkmark-circle-02' },
      ])

      // Everything except payouts, which are money leaving rather than earned.
      const earned = derived(() => {
        const current = statement()

        if (!current)
          return []

        return Object.keys(current.byKind)
          .filter(kind => kind !== 'payout')
          .map(kind => ({ kind, cents: current.byKind[kind] }))
      })

      const statementTiles = derived(() => {
        const current = statement()

        if (!current)
          return []

        return [
          { label: say('earnings.earned', 'Earned'), cents: earned().reduce((total, row) => total + row.cents, 0) },
          { label: say('earnings.paid_out', 'Paid out'), cents: current.paidOutCents },
          { label: say('earnings.outstanding', 'Outstanding'), cents: current.outstandingCents },
        ]
      })

      /*
       * Whether to offer the payout button.
       *
       * Recording a payout is operations' verb, not the payee's - a merchant
       * looking at money owed to them cannot also be the one who marks it
       * paid. The server has always enforced that; until it was checked here
       * too, a merchant was shown a button whose only outcome was a refusal.
       */
      const canPayOut = derived(() => {
        if (!canRecordPayouts())
          return false

        const current = statement()

        return Boolean(current)
          && current.party.partyType !== 'platform'
          && current.party.partyType !== 'tax'
          && current.outstandingCents > 0
      })

      async function load() {
        const account = await me()

        signedIn.set(Boolean(account))
        canSeeAll.set(may(account, 'earnings.read.all'))
        canRecordPayouts.set(may(account, 'payouts.record'))

        /*
         * With no party asked for, operations gets the list of every balance
         * and everybody else goes straight to the one statement that is
         * theirs. `me` already worked out which that is - it is the same
         * decision the account page's links are built from.
         */
        const own = account
          ? (account.surfaces.find(surface => surface.key === 'earnings') || {}).href || ''
          : ''

        const asked = new URLSearchParams(location.search).get('party')
          || (!canSeeAll() && own.includes('?party=') ? own.split('?party=')[1] : '')

        party.set(asked)

        if (!asked) {
          if (!canSeeAll()) {
            // Nothing to show and nothing to fetch: signed out, or an account
            // that is neither a business nor a courier. operator-empty says which.
            loading.set(false)
            return
          }

          const response = await apiGet('/api/money/balances')

          balances.set(response.ok ? (await response.json()).data : [])
          denied.set(response.status === 401 || response.status === 403)
          loading.set(false)
          return
        }

        const [partyType, partyId] = asked.split(':')
        const response = await apiGet(`/api/money/${encodeURIComponent(partyType)}/${encodeURIComponent(partyId)}`)

        denied.set(response.status === 401 || response.status === 403)
        statement.set(response.ok ? (await response.json()).data : null)
        loading.set(false)
      }

      async function payOut() {
        const current = statement()
        const [partyType, partyId] = party().split(':')

        const response = await send(`/api/money/${partyType}/${partyId}/payout`, {
          amountCents: current.outstandingCents,
        })

        if (!response.ok) {
          error.set((await response.json()).message)
          return
        }

        error.set('')
        load()
      }

      load()
    </script>
    @include('footer')
  </body>
</html>
