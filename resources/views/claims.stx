<script server>
/*
 * The claims queue.
 *
 * Somebody who runs a real place has written in, most likely to ask why they
 * are listed at all. This is the screen where a person reads that and decides,
 * which is why it shows the whole message rather than a truncated preview and
 * a status chip.
 *
 * Approving does not turn a listing into a partner. It records that the
 * listing has an owner; taking orders would mean processing a real payment,
 * which this demo will never do.
 */
import { currentLocale, t } from '../../app/Actions/Locale/translate'

/*
 * The strings this page's own script writes, already translated.
 *
 * Built here and carried to the markup on a data attribute, the same way the
 * rest of this app hands the client a payload. Written inline in the markup
 * instead, stx sometimes reads it as a client expression and leaves the
 * literal `{{ JSON.stringify(` in the attribute, which is a page whose script
 * silently falls back to English. The shared strings are in partials/head.stx.
 */
const clientStrings = JSON.stringify({
  'claims.said_nothing': t('claims.said_nothing'),
})

/* The empty state's own sentence; see partials/operator-empty.stx. */
const operatorNothing = t('operator.not_operations')

const pageTitle = t('meta.claims_title')
const pageDescription = t('meta.claims_description')
const canonicalPath = '/claims'
</script>

<!DOCTYPE html>
<html lang="{{ currentLocale() }}">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-3xl" data-stx-content>
      <div class="pt-12 pb-24 sm:pb-40">
        <h1 class="text-[clamp(2rem,4.5vw,3rem)] font-semibold tracking-[-0.035em]">{{ t('claims.title') }}</h1>

        <p :if="allowed()" class="mt-3 max-w-xl text-[15px] leading-relaxed" style="color: var(--ink-soft)">
          {{ t('claims.lede') }}
        </p>

        {{-- The words this page's own script writes, already translated. The
          shared bundle is in partials/head.stx; this is the handful only the
          claims screen needs. --}}
        <div hidden data-i18n-strings="{{ clientStrings }}"></div>

        <div class="mt-6">
          @include('operator-empty')
        </div>

        <section :if="allowed()" class="mt-10">
          <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('claims.waiting') }}</h2>

          <p :if="!loading() && pending().length === 0" class="mt-4 text-[15px]" style="color: var(--ink-soft)">{{ t('claims.nothing_waiting') }}</p>

          <div class="mt-4 space-y-3">
            <div :for="claim in pending()" class="p-1.5 rounded-[1.5rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
              <div class="p-6 rounded-[calc(1.5rem-0.375rem)]">
                <div class="flex flex-wrap gap-4 justify-between items-baseline">
                  <a :href="'/places/' + claim.businessSlug" class="text-[16px] font-semibold transition-opacity duration-500 hover:opacity-70">{{ claim.businessName }}</a>
                  <p class="text-[13px]" style="color: var(--ink-soft)">{{ claim.claimantName }} · {{ claim.claimantEmail }}</p>
                </div>

                <p class="mt-4 text-[15px] leading-relaxed" style="color: var(--ink-soft)">{{ claim.message || say('claims.said_nothing', 'They said nothing else.') }}</p>

                <div class="flex gap-2 mt-6">
                  <button @click="decide(claim.id, 'approved')" class="px-4 py-2 text-[14px] font-medium rounded-full transition-all duration-500 active:scale-[0.98]" style="background: var(--ink); color: var(--paper)">{{ t('claims.approve') }}</button>
                  <button @click="decide(claim.id, 'rejected')" class="px-4 py-2 text-[14px] rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">{{ t('claims.reject') }}</button>
                </div>

                <p :if="error() && erroredOn() === claim.id" class="mt-3 text-[13px]" style="color: var(--accent)">{{ error() }}</p>
              </div>
            </div>
          </div>
        </section>

        <section :if="allowed() && decided().length > 0" class="mt-12">
          <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('claims.decided') }}</h2>
          <ul class="mt-4 space-y-2 text-[14px]">
            <li :for="claim in decided()" class="flex gap-4 justify-between">
              <span>{{ claim.businessName }} <span style="color: var(--ink-soft)">{{ claim.claimantName }}</span></span>
              <span style="color: var(--ink-soft)">{{ claim.status }}</span>
            </li>
          </ul>
        </section>
      </div>
    </main>

    <script client>
      import { get, me, send } from '../functions/session'

      /*
       * A string this script writes, in the language the server served.
       *
       * The English text is the second argument rather than a fallback to the
       * key, so a string no holder carries reads as English rather than as
       * `claims.said_nothing`.
       */
      function say(key, english) {
        return window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, english) : english
      }

      const claims = state([])
      const loading = state(true)
      const error = state('')
      const erroredOn = state(0)

      /* Who is signed in; see functions/session.ts. */
      const signedIn = state(false)
      const allowed = state(false)
      const denied = state(false)

      /* Claims are about the platform rather than about one business, so there
         is nothing to switch between - but partials/operator-empty is shared
         with the screens that have. */
      const mine = state([])
      const slug = state('')

      function operatorLink() {
        return '/claims'
      }

      const pending = derived(() => claims().filter(claim => claim.status === 'pending'))
      const decided = derived(() => claims().filter(claim => claim.status !== 'pending'))

      async function load() {
        const account = await me()

        signedIn.set(Boolean(account))

        const response = await apiGet('/api/claims')

        // A refusal here is "your account does not open this screen", not
        // "that claim is somebody else's": there is no claim in the URL.
        allowed.set(response.ok)
        claims.set(response.ok ? (await response.json()).data : [])
        loading.set(false)
      }

      async function decide(id, decision) {
        const response = await send(`/api/claims/${id}/${decision}`)

        if (!response.ok) {
          erroredOn.set(id)
          error.set((await response.json()).message)
          return
        }

        error.set('')
        load()
      }

      load()
    </script>
    @include('footer')
  </body>
</html>
