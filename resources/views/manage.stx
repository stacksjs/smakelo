<script server>
/*
 * The merchant's own screen.
 *
 * Two edits matter during service: take a dish off because it ran out, and
 * change today's hours. Both are one tap from the top here. Everything a
 * merchant portal usually leads with - branding, settings, analytics - is
 * either further down or somewhere else, because a portal that makes the
 * urgent things slow gets replaced by a phone call to the platform.
 *
 * Reached as `/manage?business=<slug>`.
 */
const pageTitle = t('meta.manage_title')
const pageDescription = t('meta.manage_description')
const canonicalPath = '/manage'
</script>

<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-5xl" data-stx-content>
      <div class="pt-10 pb-24 sm:pb-40">
        {{-- What this page's own script writes, already translated. --}}
        <div hidden data-i18n-strings="{{ JSON.stringify({
          'common.save': t('common.save'),
          'common.saved': t('common.saved'),
          'business.open': t('business.open'),
          'business.closed': t('business.closed'),
          'order.delivery': t('order.delivery'),
          'order.pickup': t('order.pickup'),
          'order.dine_in': t('order.dine_in'),
        }) }}"></div>

        <p :if="loading()" class="text-[15px]" style="color: var(--ink-soft)">{{ t('common.loading') }}…</p>

        <p :if="!loading() && !slug()" class="text-[15px]">{{ t('manage.needs_slug') }}</p>

        <p :if="!loading() && slug() && !view()" class="text-[15px]">
          Nothing to manage there. Only the partner businesses have a menu.
        </p>

        <div :if="view()">
          <div class="flex flex-wrap gap-4 justify-between items-baseline">
            <div>
              <p class="text-[13px]" style="color: var(--ink-soft)">{{ view().business.name }}</p>
              <h1 class="mt-1 text-[clamp(1.9rem,4vw,2.75rem)] font-semibold tracking-[-0.03em]">{{ t('manage.title') }}</h1>
            </div>

            <div class="flex flex-wrap gap-2 text-[13px]">
              <a :href="'/kitchen?business=' + view().business.slug" class="px-4 py-2 rounded-full transition-all duration-500" style="background: var(--ink); color: var(--paper)">
                Orders{{ view().counts.openOrders > 0 ? ' (' + view().counts.openOrders + ')' : '' }}
              </a>
              <a :href="'/codes/' + view().business.slug" class="px-4 py-2 rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">{{ t('manage.table_codes') }}</a>
              <a :href="'/earnings?party=business:' + view().business.id" class="px-4 py-2 rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">{{ t('earnings.title') }}</a>
            </div>
          </div>

          <section class="mt-10">
            <div class="flex flex-wrap gap-4 justify-between items-baseline">
              <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('business.menu') }}</h2>
              <p :if="view().counts.unavailable > 0" class="text-[13px]" style="color: var(--accent)">{{ view().counts.unavailable }} off the menu</p>
            </div>

            <div class="mt-4 space-y-2">
              <div :for="item in view().items" class="p-1.5 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
                <div class="flex flex-wrap gap-4 items-center p-4 rounded-[calc(1.25rem-0.375rem)]">
                  <div class="flex-1 min-w-[200px]" :style="item.isAvailable ? '' : 'opacity: 0.5'">
                    <p class="text-[15px] font-medium">{{ item.name }}</p>
                    <p class="mt-0.5 text-[12px]" style="color: var(--ink-soft)">{{ item.section }}</p>
                  </div>

                  <label class="flex gap-2 items-center text-[13px]" style="color: var(--ink-soft)">
                    {{ view().business.currency === 'eur' ? '€' : '$' }}
                    <input
                      type="number"
                      step="0.01"
                      min="0.01"
                      :value="(item.priceCents / 100).toFixed(2)"
                      @input="prices.set({ ...prices(), [item.id]: $event.target.value })"
                      class="px-3 py-1.5 w-24 text-[14px] tabular-nums rounded-full"
                      style="background: var(--paper); border: 1px solid var(--line)"
                    >
                  </label>

                  <button @click="savePrice(item)" class="px-4 py-2 text-[13px] rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">
                    {{ savedId() === item.id ? say('common.saved', 'Saved') : say('common.save', 'Save') }}
                  </button>

                  <button
                    @click="toggle(item)"
                    class="px-4 py-2 text-[13px] font-medium rounded-full transition-all duration-500"
                    :style="item.isAvailable ? 'background: var(--accent-soft); color: var(--accent)' : 'background: var(--ink); color: var(--paper)'"
                  >{{ item.isAvailable ? 'On' : 'Off' }}</button>
                </div>

                <p :if="itemError() && erroredItem() === item.id" class="px-4 pb-3 text-[13px]" style="color: var(--accent)">{{ itemError() }}</p>
              </div>
            </div>
          </section>

          <section class="mt-12">
            <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('business.hours') }}</h2>

            <div class="mt-4 space-y-2">
              <div :for="hour in view().hours" class="flex flex-wrap gap-3 items-center p-4 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
                <span class="w-24 text-[14px] font-medium">{{ hour.dayName }}</span>

                <input
                  type="time"
                  :value="clock(hour.opensAt)"
                  :disabled="hour.isClosed"
                  @input="opens.set({ ...opens(), [hour.dayOfWeek]: $event.target.value })"
                  class="px-3 py-1.5 text-[14px] rounded-full"
                  style="background: var(--paper); border: 1px solid var(--line)"
                >
                <span class="text-[13px]" style="color: var(--ink-soft)">{{ t('manage.hours_to') }}</span>
                <input
                  type="time"
                  :value="clock(hour.closesAt)"
                  :disabled="hour.isClosed"
                  @input="closes.set({ ...closes(), [hour.dayOfWeek]: $event.target.value })"
                  class="px-3 py-1.5 text-[14px] rounded-full"
                  style="background: var(--paper); border: 1px solid var(--line)"
                >

                <button
                  @click="setClosed(hour, !hour.isClosed)"
                  class="px-4 py-2 text-[13px] rounded-full transition-all duration-500"
                  :style="hour.isClosed ? 'background: var(--ink); color: var(--paper)' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
                >{{ hour.isClosed ? say('business.closed', 'Closed') : say('business.open', 'Open') }}</button>

                <button @click="saveHours(hour)" class="px-4 py-2 ml-auto text-[13px] rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">
                  {{ savedDay() === hour.dayOfWeek ? say('common.saved', 'Saved') : say('common.save', 'Save') }}
                </button>

                <p :if="hourError() && erroredDay() === hour.dayOfWeek" class="w-full text-[13px]" style="color: var(--accent)">{{ hourError() }}</p>
              </div>
            </div>
          </section>

          <section class="mt-12">
            <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('manage.how_people_order') }}</h2>

            <div class="flex flex-wrap gap-2 mt-4">
              <button
                :for="mode in modes()"
                @click="setMode(mode.key, !mode.on)"
                class="px-4 py-2 text-[14px] rounded-full transition-all duration-500"
                :style="mode.on ? 'background: var(--accent-soft); color: var(--accent); border: 1px solid transparent' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
              >{{ mode.label }}</button>
            </div>

            <p :if="modeError()" class="mt-3 text-[13px]" style="color: var(--accent)">{{ modeError() }}</p>
          </section>
        </div>
      </div>
    </main>

    <script client>
      import { send } from '../functions/session'

      /*
       * The words this script writes, in the language the server served.
       *
       * The English text is the second argument rather than a fallback to the
       * key, so a string no holder carries reads as English rather than as its
       * own name. The page's holder is in the markup above; the shared bundle
       * is in partials/head.stx.
       */
      function say(key, english) {
        return window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, english) : english
      }

      const slug = state('')
      const view = state(null)
      const loading = state(true)

      // Edits in flight, keyed by id, so a field the merchant has typed into
      // is not thrown away when the list re-renders.
      const prices = state({})
      const opens = state({})
      const closes = state({})

      const savedId = state(0)
      const savedDay = state(-1)
      const itemError = state('')
      const erroredItem = state(0)
      const hourError = state('')
      const erroredDay = state(-1)
      const modeError = state('')

      const modes = derived(() => {
        const current = view()

        if (!current)
          return []

        return [
          { key: 'delivery', label: say('order.delivery', 'Delivery'), on: current.business.offersDelivery },
          { key: 'pickup', label: say('order.pickup', 'Pickup'), on: current.business.offersPickup },
          { key: 'dineIn', label: say('order.dine_in', 'Dine in'), on: current.business.offersDineIn },
        ]
      })

      // Minutes from midnight, which is how the hours are stored, shown the way
      // a person reads a clock.
      function clock(minutes) {
        const hours = Math.floor(minutes / 60) % 24
        const rest = minutes % 60

        return `${String(hours).padStart(2, '0')}:${String(rest).padStart(2, '0')}`
      }

      function toMinutes(value) {
        const [hours, rest] = String(value).split(':').map(Number)

        return (Number.isFinite(hours) ? hours : 0) * 60 + (Number.isFinite(rest) ? rest : 0)
      }

      async function load() {
        const asked = new URLSearchParams(location.search).get('business') || ''

        slug.set(asked)

        if (!asked) {
          loading.set(false)
          return
        }

        const response = await fetch(`/api/manage/${encodeURIComponent(asked)}`)

        view.set(response.ok ? (await response.json()).data : null)
        loading.set(false)
      }

      async function toggle(item) {
        const response = await send(`/api/manage/${slug()}/items/${item.id}`, { isAvailable: !item.isAvailable })

        if (!response.ok) {
          erroredItem.set(item.id)
          itemError.set((await response.json()).message)
          return
        }

        itemError.set('')
        load()
      }

      async function savePrice(item) {
        const typed = prices()[item.id]
        const cents = Math.round(Number(typed === undefined ? item.priceCents / 100 : typed) * 100)

        const response = await send(`/api/manage/${slug()}/items/${item.id}`, { priceCents: cents })

        if (!response.ok) {
          erroredItem.set(item.id)
          itemError.set((await response.json()).message)
          return
        }

        itemError.set('')
        savedId.set(item.id)
        setTimeout(() => savedId.set(0), 2000)
        load()
      }

      async function saveHours(hour) {
        const response = await send(`/api/manage/${slug()}/hours`, {
          dayOfWeek: hour.dayOfWeek,
          opensAt: toMinutes(opens()[hour.dayOfWeek] ?? clock(hour.opensAt)),
          closesAt: toMinutes(closes()[hour.dayOfWeek] ?? clock(hour.closesAt)),
          isClosed: false,
        })

        if (!response.ok) {
          erroredDay.set(hour.dayOfWeek)
          hourError.set((await response.json()).message)
          return
        }

        hourError.set('')
        savedDay.set(hour.dayOfWeek)
        setTimeout(() => savedDay.set(-1), 2000)
        load()
      }

      async function setClosed(hour, closed) {
        const response = await send(`/api/manage/${slug()}/hours`, {
          dayOfWeek: hour.dayOfWeek,
          opensAt: toMinutes(opens()[hour.dayOfWeek] ?? clock(hour.opensAt)),
          closesAt: toMinutes(closes()[hour.dayOfWeek] ?? clock(hour.closesAt)),
          isClosed: closed,
        })

        if (!response.ok) {
          erroredDay.set(hour.dayOfWeek)
          hourError.set((await response.json()).message)
          return
        }

        hourError.set('')
        load()
      }

      async function setMode(key, on) {
        const response = await send(`/api/manage/${slug()}/fulfilment`, { [key]: on })

        if (!response.ok) {
          modeError.set((await response.json()).message)
          return
        }

        modeError.set('')
        load()
      }

      load()
    </script>
    @include('footer')
  </body>
</html>
