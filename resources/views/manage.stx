<script server>
/*
 * The merchant's own screen.
 *
 * Two edits matter during service: take a dish off because it ran out, and
 * change today's hours. Both are one tap from the top here. Everything a
 * merchant portal usually leads with - branding, settings, analytics - is
 * either further down or somewhere else, because a portal that makes the
 * urgent things slow gets replaced by a phone call to the platform.
 *
 * Reached as `/manage?business=<slug>`.
 */
const pageTitle = 'Manage - Smakelo'
const pageDescription = 'Your menu, your hours.'
const canonicalPath = '/manage'
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-5xl">
      <div id="manage-root" class="pt-10 pb-24 sm:pb-40">
        <p class="text-[15px]" style="color: var(--ink-soft)">Loading…</p>
      </div>
    </main>

    <script client>
      const root = document.getElementById('manage-root')
      const slug = new URLSearchParams(location.search).get('business') || ''

      const money = (cents, currency = 'usd') => `${currency === 'eur' ? '€' : '$'}${(cents / 100).toFixed(2)}`

      const escapeHtml = value => String(value).replace(/[&<>"']/g, ch => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', '\'': '&#39;',
      }[ch]))

      function csrfToken() {
        const match = document.cookie.match(/(?:^|;\s*)X-CSRF-Token=([^;]+)/)
        return match ? decodeURIComponent(match[1]) : ''
      }

      const send = (url, body) => fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken() },
        credentials: 'same-origin',
        body: JSON.stringify(body || {}),
      })

      // Minutes from midnight, which is how the hours are stored, shown the way
      // a person reads a clock.
      const clock = (minutes) => {
        const h = Math.floor(minutes / 60) % 24
        const m = minutes % 60
        return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`
      }

      const minutes = (value) => {
        const [h, m] = String(value).split(':').map(Number)
        return (Number.isFinite(h) ? h : 0) * 60 + (Number.isFinite(m) ? m : 0)
      }

      async function load() {
        if (!slug) {
          root.innerHTML = '<p class="text-[15px]">Add ?business=&lt;slug&gt; to manage a business.</p>'
          return
        }

        const response = await fetch(`/api/manage/${encodeURIComponent(slug)}`)

        if (!response.ok) {
          root.innerHTML = '<p class="text-[15px]">Nothing to manage there. Only the partner businesses have a menu.</p>'
          return
        }

        render((await response.json()).data)
      }

      function render(view) {
        const currency = view.business.currency

        root.innerHTML = `
          <div class="flex flex-wrap gap-4 justify-between items-baseline">
            <div>
              <p class="text-[13px]" style="color: var(--ink-soft)">${escapeHtml(view.business.name)}</p>
              <h1 class="mt-1 text-[clamp(1.9rem,4vw,2.75rem)] font-semibold tracking-[-0.03em]">Manage</h1>
            </div>
            <div class="flex flex-wrap gap-2 text-[13px]">
              <a href="/kitchen?business=${view.business.slug}" class="px-4 py-2 rounded-full transition-all duration-500" style="background: var(--ink); color: var(--paper)">
                Orders${view.counts.openOrders > 0 ? ` (${view.counts.openOrders})` : ''}
              </a>
              <a href="/codes/${view.business.slug}" class="px-4 py-2 rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">Table codes</a>
              <a href="/earnings?party=business:${view.business.id}" class="px-4 py-2 rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">Earnings</a>
            </div>
          </div>

          <section class="mt-10">
            <div class="flex flex-wrap gap-4 justify-between items-baseline">
              <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">Menu</h2>
              ${view.counts.unavailable > 0
                ? `<p class="text-[13px]" style="color: var(--accent)">${view.counts.unavailable} off the menu</p>`
                : ''}
            </div>

            <div class="mt-4 space-y-2">${view.items.map(item => itemRow(item, currency)).join('')}</div>
          </section>

          <section class="mt-12">
            <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">Hours</h2>
            <div class="mt-4 space-y-2">${view.hours.map(hourRow).join('')}</div>
          </section>

          <section class="mt-12">
            <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">How people can order</h2>
            <div class="flex flex-wrap gap-2 mt-4">
              ${[['delivery', 'Delivery', view.business.offersDelivery], ['pickup', 'Pickup', view.business.offersPickup], ['dineIn', 'Dine in', view.business.offersDineIn]]
                .map(([key, label, on]) => `
                  <button data-mode="${key}" data-on="${on ? '1' : '0'}" class="px-4 py-2 text-[14px] rounded-full transition-all duration-500"
                    style="${on ? 'background: var(--accent-soft); color: var(--accent); border: 1px solid transparent' : 'border: 1px solid var(--line); color: var(--ink-soft)'}">${label}</button>`).join('')}
            </div>
            <p id="mode-error" hidden class="mt-3 text-[13px]" style="color: var(--accent)"></p>
          </section>`

        wire(view)
      }

      function itemRow(item, currency) {
        return `
          <div class="p-1.5 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
            <div class="flex flex-wrap gap-4 items-center p-4 rounded-[calc(1.25rem-0.375rem)]">
              <div class="flex-1 min-w-[200px]" style="${item.isAvailable ? '' : 'opacity: 0.5'}">
                <p class="text-[15px] font-medium">${escapeHtml(item.name)}</p>
                <p class="mt-0.5 text-[12px]" style="color: var(--ink-soft)">${escapeHtml(item.section)}</p>
              </div>

              <label class="flex gap-2 items-center text-[13px]" style="color: var(--ink-soft)">
                ${currency === 'eur' ? '€' : '$'}
                <input type="number" step="0.01" min="0.01" data-price="${item.id}" value="${(item.priceCents / 100).toFixed(2)}"
                  class="px-3 py-1.5 w-24 text-[14px] tabular-nums rounded-full" style="background: var(--paper); border: 1px solid var(--line)">
              </label>

              <button data-save="${item.id}" class="px-4 py-2 text-[13px] rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">Save</button>

              <button data-toggle="${item.id}" data-on="${item.isAvailable ? '1' : '0'}"
                class="px-4 py-2 text-[13px] font-medium rounded-full transition-all duration-500"
                style="${item.isAvailable ? 'background: var(--accent-soft); color: var(--accent)' : 'background: var(--ink); color: var(--paper)'}">
                ${item.isAvailable ? 'On' : 'Off'}
              </button>
            </div>
          </div>`
      }

      function hourRow(hour) {
        return `
          <div class="flex flex-wrap gap-3 items-center p-4 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
            <span class="w-24 text-[14px] font-medium">${hour.dayName}</span>

            <input type="time" data-open="${hour.dayOfWeek}" value="${clock(hour.opensAt)}" ${hour.isClosed ? 'disabled' : ''}
              class="px-3 py-1.5 text-[14px] rounded-full" style="background: var(--paper); border: 1px solid var(--line)">
            <span class="text-[13px]" style="color: var(--ink-soft)">to</span>
            <input type="time" data-close="${hour.dayOfWeek}" value="${clock(hour.closesAt)}" ${hour.isClosed ? 'disabled' : ''}
              class="px-3 py-1.5 text-[14px] rounded-full" style="background: var(--paper); border: 1px solid var(--line)">

            <button data-closed="${hour.dayOfWeek}" data-on="${hour.isClosed ? '1' : '0'}"
              class="px-4 py-2 text-[13px] rounded-full transition-all duration-500"
              style="${hour.isClosed ? 'background: var(--ink); color: var(--paper)' : 'border: 1px solid var(--line); color: var(--ink-soft)'}">
              ${hour.isClosed ? 'Closed' : 'Open'}
            </button>

            <button data-hours="${hour.dayOfWeek}" class="px-4 py-2 ml-auto text-[13px] rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">Save</button>
            <p data-hour-error="${hour.dayOfWeek}" hidden class="w-full text-[13px]" style="color: var(--accent)"></p>
          </div>`
      }

      function wire(view) {
        root.querySelectorAll('[data-toggle]').forEach((button) => {
          button.addEventListener('click', async () => {
            const response = await send(`/api/manage/${slug}/items/${button.dataset.toggle}`, {
              isAvailable: button.dataset.on !== '1',
            })

            if (response.ok)
              load()
          })
        })

        root.querySelectorAll('[data-save]').forEach((button) => {
          button.addEventListener('click', async () => {
            const id = button.dataset.save
            const field = root.querySelector(`[data-price="${id}"]`)
            const response = await send(`/api/manage/${slug}/items/${id}`, {
              priceCents: Math.round(Number(field.value) * 100),
            })

            button.textContent = response.ok ? 'Saved' : (await response.json()).message
            setTimeout(() => { button.textContent = 'Save' }, 2000)
          })
        })

        root.querySelectorAll('[data-closed]').forEach((button) => {
          button.addEventListener('click', async () => {
            const day = button.dataset.closed
            const response = await send(`/api/manage/${slug}/hours`, {
              dayOfWeek: Number(day),
              opensAt: minutes(root.querySelector(`[data-open="${day}"]`).value),
              closesAt: minutes(root.querySelector(`[data-close="${day}"]`).value),
              isClosed: button.dataset.on !== '1',
            })

            if (response.ok)
              load()
          })
        })

        root.querySelectorAll('[data-hours]').forEach((button) => {
          button.addEventListener('click', async () => {
            const day = button.dataset.hours
            const error = root.querySelector(`[data-hour-error="${day}"]`)

            const response = await send(`/api/manage/${slug}/hours`, {
              dayOfWeek: Number(day),
              opensAt: minutes(root.querySelector(`[data-open="${day}"]`).value),
              closesAt: minutes(root.querySelector(`[data-close="${day}"]`).value),
              isClosed: false,
            })

            if (!response.ok) {
              error.textContent = (await response.json()).message
              error.hidden = false
              return
            }

            error.hidden = true
            button.textContent = 'Saved'
            setTimeout(() => { button.textContent = 'Save' }, 2000)
          })
        })

        root.querySelectorAll('[data-mode]').forEach((button) => {
          button.addEventListener('click', async () => {
            const error = document.getElementById('mode-error')
            const response = await send(`/api/manage/${slug}/fulfilment`, {
              [button.dataset.mode]: button.dataset.on !== '1',
            })

            if (!response.ok) {
              error.textContent = (await response.json()).message
              error.hidden = false
              return
            }

            load()
          })
        })
      }

      load()
    </script>
  </body>
</html>
