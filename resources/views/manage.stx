<script server>
/*
 * The merchant's own screen.
 *
 * Two edits matter during service: take a dish off because it ran out, and
 * change today's hours. Both are one tap from the top here. Everything a
 * merchant portal usually leads with - branding, settings, analytics - is
 * either further down or somewhere else, because a portal that makes the
 * urgent things slow gets replaced by a phone call to the platform.
 *
 * Reached from the account, which knows which businesses are this
 * merchant's. `?business=<slug>` still works and is what a switcher links to;
 * somebody who runs one place never sees it.
 */
import { currentLocale, t } from '../../app/Actions/Locale/translate'

/*
 * The strings this page's own script writes, already translated.
 *
 * Built here and carried to the markup on a data attribute, the same way the
 * rest of this app hands the client a payload. Written inline in the markup
 * instead, stx sometimes reads it as a client expression and leaves the
 * literal `{{ JSON.stringify(` in the attribute, which is a page whose script
 * silently falls back to English. The shared strings are in partials/head.stx.
 */
const clientStrings = JSON.stringify({
  'common.save': t('common.save'),
  'common.saved': t('common.saved'),
  'business.open': t('business.open'),
  'business.closed': t('business.closed'),
  'order.delivery': t('order.delivery'),
  'order.pickup': t('order.pickup'),
  'order.dine_in': t('order.dine_in'),
  'manage.off_the_menu': t('manage.off_the_menu', { count: '{count}' }),
  'manage.available_on': t('manage.available_on'),
  'manage.available_off': t('manage.available_off'),
  'season.boxes_next': t('season.boxes_next'),
  'season.members_active': t('season.members_active'),
  'season.members_paused': t('season.members_paused'),
  'season.per_box': t('season.per_box', { amount: '{amount}' }),
  'season.active_count': t('season.active_count', { count: '{count}' }),
  'season.paused_count': t('season.paused_count', { count: '{count}' }),
  'season.next_box': t('season.next_box', { date: '{date}' }),
  'season.paused_until': t('season.paused_until', { date: '{date}' }),
  'season.boxes_delivered': t('season.boxes_delivered', { count: '{count}' }),
  'season.member_unnamed': t('season.member_unnamed'),
  'season.status_active': t('season.status_active'),
  'season.status_paused': t('season.status_paused'),
})

/* The empty state's own sentence; see partials/operator-empty.stx. */
const operatorNothing = t('operator.nothing_to_manage')

const pageTitle = t('meta.manage_title')
const pageDescription = t('meta.manage_description')
const canonicalPath = '/manage'
</script>

<!DOCTYPE html>
<html lang="{{ currentLocale() }}">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-5xl" data-stx-content>
      <div class="pt-10 pb-24 sm:pb-40">
        {{-- What this page's own script writes, already translated. --}}
        <div hidden data-i18n-strings="{{ clientStrings }}"></div>

        <p :if="loading()" class="text-[15px]" style="color: var(--ink-soft)">{{ t('common.loading') }}…</p>

        @include('operator-empty')

        <p :if="!loading() && slug() && !denied() && !view()" class="text-[15px]">
          {{ t('manage.not_a_partner') }}
        </p>

        <div :if="view()">
          <div class="flex flex-wrap gap-4 justify-between items-baseline">
            <div>
              <p class="text-[13px]" style="color: var(--ink-soft)">{{ view().business.name }}</p>
              <h1 class="mt-1 text-[clamp(1.9rem,4vw,2.75rem)] font-semibold tracking-[-0.03em]">{{ t('manage.title') }}</h1>

              {{-- Only when there is something to switch to. --}}
              <div :if="mine().length > 1" class="flex flex-wrap gap-1.5 mt-3">
                <a
                  :for="place in mine()"
                  :href="'/manage?business=' + place.slug"
                  class="px-3 py-1.5 text-[12px] rounded-full transition-all duration-500"
                  :style="place.slug === slug() ? 'background: var(--accent-soft); color: var(--accent)' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
                >{{ place.name }}</a>
              </div>
            </div>

            <div class="flex flex-wrap gap-2 text-[13px]">
              <a :href="'/kitchen?business=' + view().business.slug" class="px-4 py-2 rounded-full transition-all duration-500" style="background: var(--ink); color: var(--paper)">
                {{ t('kitchen.orders') }}{{ view().counts.openOrders > 0 ? ' (' + view().counts.openOrders + ')' : '' }}
              </a>
              <a :href="'/codes/' + view().business.slug" class="px-4 py-2 rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">{{ t('manage.table_codes') }}</a>
              <a :href="'/earnings?party=business:' + view().business.id" class="px-4 py-2 rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">{{ t('earnings.title') }}</a>
            </div>
          </div>

          <section class="mt-10">
            <div class="flex flex-wrap gap-4 justify-between items-baseline">
              <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('business.menu') }}</h2>
              <p :if="view().counts.unavailable > 0" class="text-[13px]" style="color: var(--accent)">{{ offMenu(view().counts.unavailable) }}</p>
            </div>

            <div class="mt-4 space-y-2">
              <div :for="item in view().items" class="p-1.5 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
                <div class="flex flex-wrap gap-4 items-center p-4 rounded-[calc(1.25rem-0.375rem)]">
                  <div class="flex-1 min-w-[200px]" :style="item.isAvailable ? '' : 'opacity: 0.5'">
                    <p class="text-[15px] font-medium">{{ item.name }}</p>
                    <p class="mt-0.5 text-[12px]" style="color: var(--ink-soft)">{{ item.section }}</p>
                  </div>

                  <label class="flex gap-2 items-center text-[13px]" style="color: var(--ink-soft)">
                    {{ view().business.currency === 'eur' ? '€' : '$' }}
                    <input
                      type="number"
                      step="0.01"
                      min="0.01"
                      :value="(item.priceCents / 100).toFixed(2)"
                      @input="prices.set({ ...prices(), [item.id]: $event.target.value })"
                      class="px-3 py-1.5 w-24 text-[14px] tabular-nums rounded-full"
                      style="background: var(--paper); border: 1px solid var(--line)"
                    >
                  </label>

                  <button @click="savePrice(item)" class="px-4 py-2 text-[13px] rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">
                    {{ savedId() === item.id ? say('common.saved', 'Saved') : say('common.save', 'Save') }}
                  </button>

                  <button
                    @click="toggle(item)"
                    class="px-4 py-2 text-[13px] font-medium rounded-full transition-all duration-500"
                    :style="item.isAvailable ? 'background: var(--accent-soft); color: var(--accent)' : 'background: var(--ink); color: var(--paper)'"
                  >{{ item.isAvailable ? say('manage.available_on', 'On') : say('manage.available_off', 'Off') }}</button>
                </div>

                <p :if="itemError() && erroredItem() === item.id" class="px-4 pb-3 text-[13px]" style="color: var(--accent)">{{ itemError() }}</p>
              </div>
            </div>
          </section>

          <section class="mt-12">
            <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('business.hours') }}</h2>

            <div class="mt-4 space-y-2">
              <div :for="hour in view().hours" class="flex flex-wrap gap-3 items-center p-4 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
                <span class="w-24 text-[14px] font-medium">{{ dayName(hour.dayOfWeek) }}</span>

                <input
                  type="time"
                  :value="clock(hour.opensAt)"
                  :disabled="hour.isClosed"
                  @input="opens.set({ ...opens(), [hour.dayOfWeek]: $event.target.value })"
                  class="px-3 py-1.5 text-[14px] rounded-full"
                  style="background: var(--paper); border: 1px solid var(--line)"
                >
                <span class="text-[13px]" style="color: var(--ink-soft)">{{ t('manage.hours_to') }}</span>
                <input
                  type="time"
                  :value="clock(hour.closesAt)"
                  :disabled="hour.isClosed"
                  @input="closes.set({ ...closes(), [hour.dayOfWeek]: $event.target.value })"
                  class="px-3 py-1.5 text-[14px] rounded-full"
                  style="background: var(--paper); border: 1px solid var(--line)"
                >

                <button
                  @click="setClosed(hour, !hour.isClosed)"
                  class="px-4 py-2 text-[13px] rounded-full transition-all duration-500"
                  :style="hour.isClosed ? 'background: var(--ink); color: var(--paper)' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
                >{{ hour.isClosed ? say('business.closed', 'Closed') : say('business.open', 'Open') }}</button>

                <button @click="saveHours(hour)" class="px-4 py-2 ml-auto text-[13px] rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">
                  {{ savedDay() === hour.dayOfWeek ? say('common.saved', 'Saved') : say('common.save', 'Save') }}
                </button>

                <p :if="hourError() && erroredDay() === hour.dayOfWeek" class="w-full text-[13px]" style="color: var(--accent)">{{ hourError() }}</p>
              </div>
            </div>
          </section>

          {{-- A farm's season.

            Only farms have one, and only a farm's account holds the permission
            that fills it, so the section is absent rather than empty for a
            restaurant. The number a farm acts on - boxes to pack - leads,
            because "how many members" and "how many boxes" are different
            numbers the moment somebody pauses for August. --}}
          <section :if="season()" class="mt-12">
            <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('season.title') }}</h2>

            <div class="grid grid-cols-1 gap-3 mt-4 sm:grid-cols-3">
              <div :for="tile in seasonTiles()" class="p-5 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
                <p class="text-[26px] font-semibold tracking-[-0.02em] tabular-nums">{{ tile.count }}</p>
                <p class="mt-0.5 text-[13px]" style="color: var(--ink-soft)">{{ tile.label }}</p>
              </div>
            </div>

            <h3 class="mt-8 text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('season.plans') }}</h3>

            <div class="mt-3 space-y-2">
              <div :for="plan in season().plans" class="flex flex-wrap gap-4 justify-between items-baseline p-4 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
                <div>
                  <p class="text-[15px] font-medium">{{ plan.name }}</p>
                  <p class="mt-0.5 text-[12px]" style="color: var(--ink-soft)">{{ planLine(plan) }}</p>
                </div>
                <p class="text-[15px] tabular-nums">{{ perBox(plan) }}</p>
              </div>
            </div>

            <h3 class="mt-8 text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('season.who') }}</h3>

            <p :if="season().members.length === 0" class="mt-3 text-[15px]" style="color: var(--ink-soft)">{{ t('season.nobody') }}</p>

            <div class="mt-3 space-y-2">
              <div :for="member in season().members" class="flex flex-wrap gap-4 justify-between items-baseline p-4 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
                <div class="min-w-0">
                  <p class="text-[15px] font-medium truncate">{{ memberName(member) }}</p>
                  <p class="mt-0.5 text-[12px]" style="color: var(--ink-soft)">{{ memberLine(member) }}</p>
                </div>
                <span
                  class="px-3 py-1 text-[11px] rounded-full shrink-0"
                  :style="member.status === 'active' ? 'background: var(--accent-soft); color: var(--accent)' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
                >{{ memberStatus(member) }}</span>
              </div>
            </div>
          </section>

          <section class="mt-12">
            <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('manage.how_people_order') }}</h2>

            <div class="flex flex-wrap gap-2 mt-4">
              <button
                :for="mode in modes()"
                @click="setMode(mode.key, !mode.on)"
                class="px-4 py-2 text-[14px] rounded-full transition-all duration-500"
                :style="mode.on ? 'background: var(--accent-soft); color: var(--accent); border: 1px solid transparent' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
              >{{ mode.label }}</button>
            </div>

            <p :if="modeError()" class="mt-3 text-[13px]" style="color: var(--accent)">{{ modeError() }}</p>
          </section>
        </div>
      </div>
    </main>

    <script client>
      import { get, me, money, send } from '../functions/session'

      /*
       * The words this script writes, in the language the server served.
       *
       * The English text is the second argument rather than a fallback to the
       * key, so a string no holder carries reads as English rather than as its
       * own name. The page's holder is in the markup above; the shared bundle
       * is in partials/head.stx.
       */
      function say(key, english) {
        return window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, english) : english
      }

      const slug = state('')

      /* Who is signed in, and what they run; see functions/session.ts. */
      const mine = state([])
      const signedIn = state(false)
      const denied = state(false)

      /* What this page resolved; see partials/operator-empty.stx. */
      const allowed = derived(() => Boolean(view()))

      /* Where the chooser in partials/operator-empty points. */
      function operatorLink(slug) {
        return `/manage?business=${encodeURIComponent(slug)}`
      }

      /*
       * A weekday, in the language being served.
       *
       * From `Intl` and the day number the API already sends, rather than
       * from a `dayName` the API used to build out of an English constant.
       * Seven weekday names per language is exactly the sort of thing every
       * platform already knows, and a payload that carries the word instead of
       * the number decides the language on the wrong side of the wire.
       */
      function dayName(dayOfWeek) {
        const locale = (window.Smakelo && window.Smakelo.locale) || 'en'

        // 2024-01-07 was a Sunday, read in UTC so the server's zone cannot
        // shift the answer by a day.
        return new Intl.DateTimeFormat(locale, { weekday: 'long', timeZone: 'UTC' })
          .format(new Date(Date.UTC(2024, 0, 7 + Number(dayOfWeek))))
      }

      /* How many dishes are switched off, with the count where the sentence
         wants it. */
      function offMenu(count) {
        return say('manage.off_the_menu', '{count} off the menu').replace('{count}', count)
      }

      const view = state(null)
      const loading = state(true)

      /* A farm's season, or null for a business that does not sell one. */
      const season = state(null)

      // Edits in flight, keyed by id, so a field the merchant has typed into
      // is not thrown away when the list re-renders.
      const prices = state({})
      const opens = state({})
      const closes = state({})

      const savedId = state(0)
      const savedDay = state(-1)
      const itemError = state('')
      const erroredItem = state(0)
      const hourError = state('')
      const erroredDay = state(-1)
      const modeError = state('')

      const modes = derived(() => {
        const current = view()

        if (!current)
          return []

        return [
          { key: 'delivery', label: say('order.delivery', 'Delivery'), on: current.business.offersDelivery },
          { key: 'pickup', label: say('order.pickup', 'Pickup'), on: current.business.offersPickup },
          { key: 'dineIn', label: say('order.dine_in', 'Dine in'), on: current.business.offersDineIn },
        ]
      })

      /*
       * A date, as somebody reading this screen would write it.
       *
       * The API sends an ISO day, which is right for a wire and wrong for a
       * farm looking at when the next box goes out. `Intl` puts it in the
       * language being served, which is the same reason the weekday names
       * above come from there.
       */
      function day(iso) {
        if (!iso)
          return ''

        const locale = (window.Smakelo && window.Smakelo.locale) || 'en'
        const parsed = new Date(`${String(iso).slice(0, 10)}T00:00:00Z`)

        return Number.isNaN(parsed.getTime())
          ? String(iso)
          : new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(parsed)
      }

      function fill(key, english, values) {
        let text = say(key, english)

        for (const [name, value] of Object.entries(values))
          text = text.replace(`{${name}}`, value)

        return text
      }

      /* The three numbers a farm acts on, in the order it acts on them. */
      const seasonTiles = derived(() => {
        const current = season()

        if (!current)
          return []

        return [
          { count: current.boxesNext, label: say('season.boxes_next', 'boxes to pack') },
          { count: current.activeMembers, label: say('season.members_active', 'members') },
          { count: current.pausedMembers, label: say('season.members_paused', 'paused') },
        ]
      })

      function perBox(plan) {
        return fill('season.per_box', '{amount} a box', {
          amount: money(plan.priceCents, view().business.currency),
        })
      }

      function planLine(plan) {
        const parts = [fill('season.active_count', '{count} on this plan', { count: plan.active })]

        if (plan.paused > 0)
          parts.push(fill('season.paused_count', '{count} paused', { count: plan.paused }))

        return parts.join(' · ')
      }

      /* A member whose name this site never asked for is still a member. */
      function memberName(member) {
        return member.name || say('season.member_unnamed', 'A member')
      }

      function memberLine(member) {
        const parts = [member.planName]

        if (member.status === 'paused' && member.pausedUntil)
          parts.push(fill('season.paused_until', 'Paused until {date}', { date: day(member.pausedUntil) }))
        else if (member.nextBoxAt)
          parts.push(fill('season.next_box', 'Next box {date}', { date: day(member.nextBoxAt) }))

        if (member.boxesDelivered > 0)
          parts.push(fill('season.boxes_delivered', '{count} delivered', { count: member.boxesDelivered }))

        return parts.filter(Boolean).join(' · ')
      }

      function memberStatus(member) {
        return say(`season.status_${member.status}`, member.status)
      }

      // Minutes from midnight, which is how the hours are stored, shown the way
      // a person reads a clock.
      function clock(minutes) {
        const hours = Math.floor(minutes / 60) % 24
        const rest = minutes % 60

        return `${String(hours).padStart(2, '0')}:${String(rest).padStart(2, '0')}`
      }

      function toMinutes(value) {
        const [hours, rest] = String(value).split(':').map(Number)

        return (Number.isFinite(hours) ? hours : 0) * 60 + (Number.isFinite(rest) ? rest : 0)
      }

      async function load() {
        const account = await me()

        signedIn.set(Boolean(account))
        mine.set(account ? account.businesses : [])

        /*
         * The URL wins when it names one, so a switcher and a bookmark both
         * work. With nothing asked for, a merchant who runs one place is taken
         * straight to it and one who runs several is offered the list.
         */
        const asked = new URLSearchParams(location.search).get('business')
          || (mine().length === 1 ? mine()[0].slug : '')

        slug.set(asked)

        if (!asked) {
          loading.set(false)
          return
        }

        const response = await apiGet(`/api/manage/${encodeURIComponent(asked)}`)

        // 401 and 403 are not "no such business": they are "not yours", and
        // saying so is the difference between a fixable problem and a dead end.
        denied.set(response.status === 401 || response.status === 403)
        view.set(response.ok ? (await response.json()).data : null)
        loading.set(false)

        if (response.ok)
          loadSeason(asked)
      }

      /*
       * The season, for a business that has one.
       *
       * A 403 here is the ordinary answer for a restaurant - the permission
       * belongs to farms - so it leaves the section absent rather than raising
       * anything.
       */
      async function loadSeason(asked) {
        const response = await apiGet(`/api/manage/${encodeURIComponent(asked)}/shares`)

        season.set(response.ok ? (await response.json()).data : null)
      }

      async function toggle(item) {
        const response = await send(`/api/manage/${slug()}/items/${item.id}`, { isAvailable: !item.isAvailable })

        if (!response.ok) {
          erroredItem.set(item.id)
          itemError.set((await response.json()).message)
          return
        }

        itemError.set('')
        load()
      }

      async function savePrice(item) {
        const typed = prices()[item.id]
        const cents = Math.round(Number(typed === undefined ? item.priceCents / 100 : typed) * 100)

        const response = await send(`/api/manage/${slug()}/items/${item.id}`, { priceCents: cents })

        if (!response.ok) {
          erroredItem.set(item.id)
          itemError.set((await response.json()).message)
          return
        }

        itemError.set('')
        savedId.set(item.id)
        setTimeout(() => savedId.set(0), 2000)
        load()
      }

      async function saveHours(hour) {
        const response = await send(`/api/manage/${slug()}/hours`, {
          dayOfWeek: hour.dayOfWeek,
          opensAt: toMinutes(opens()[hour.dayOfWeek] ?? clock(hour.opensAt)),
          closesAt: toMinutes(closes()[hour.dayOfWeek] ?? clock(hour.closesAt)),
          isClosed: false,
        })

        if (!response.ok) {
          erroredDay.set(hour.dayOfWeek)
          hourError.set((await response.json()).message)
          return
        }

        hourError.set('')
        savedDay.set(hour.dayOfWeek)
        setTimeout(() => savedDay.set(-1), 2000)
        load()
      }

      async function setClosed(hour, closed) {
        const response = await send(`/api/manage/${slug()}/hours`, {
          dayOfWeek: hour.dayOfWeek,
          opensAt: toMinutes(opens()[hour.dayOfWeek] ?? clock(hour.opensAt)),
          closesAt: toMinutes(closes()[hour.dayOfWeek] ?? clock(hour.closesAt)),
          isClosed: closed,
        })

        if (!response.ok) {
          erroredDay.set(hour.dayOfWeek)
          hourError.set((await response.json()).message)
          return
        }

        hourError.set('')
        load()
      }

      async function setMode(key, on) {
        const response = await send(`/api/manage/${slug()}/fulfilment`, { [key]: on })

        if (!response.ok) {
          modeError.set((await response.json()).message)
          return
        }

        modeError.set('')
        load()
      }

      load()
    </script>
    @include('footer')
  </body>
</html>
