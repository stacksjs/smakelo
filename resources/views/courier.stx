<script server>
/*
 * The courier's screen.
 *
 * Used one-handed, outdoors, on the phone that is also the navigation, so it
 * shows only what is true right now: on shift or not, what is being carried,
 * where the next stop is, and what the day has paid. Big targets, few words.
 *
 * `?courier=<id>` picks who you are, because this demo has no courier accounts
 * and inventing a login for an invented person would be theatre. A real
 * deployment resolves the courier from the session, which is what the
 * framework's own ping and stop endpoints already do.
 */
const pageTitle = 'Courier - Smakelo'
const pageDescription = 'Deliveries, one at a time.'
const canonicalPath = '/courier'
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-2xl">
      <div id="courier-root" class="pt-10 pb-24">
        <p class="text-[15px]" style="color: var(--ink-soft)">Loading…</p>
      </div>
    </main>

    <script client>
      const root = document.getElementById('courier-root')
      const params = new URLSearchParams(location.search)
      const courierId = Number(params.get('courier') || 0)

      const money = cents => `$${(Math.abs(cents) / 100).toFixed(2)}`

      const escapeHtml = value => String(value).replace(/[&<>"']/g, ch => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', '\'': '&#39;',
      }[ch]))

      function csrfToken() {
        const match = document.cookie.match(/(?:^|;\s*)X-CSRF-Token=([^;]+)/)
        return match ? decodeURIComponent(match[1]) : ''
      }

      function post(url, body) {
        return fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken() },
          credentials: 'same-origin',
          body: JSON.stringify(body || {}),
        })
      }

      async function pickCourier() {
        const response = await fetch('/api/couriers-list')
        const { data } = await response.json()

        root.innerHTML = `
          <h1 class="text-[clamp(1.9rem,4vw,2.5rem)] font-semibold tracking-[-0.03em]">Who are you?</h1>
          <p class="mt-3 text-[15px]" style="color: var(--ink-soft)">
            The couriers here are invented, so pick one. A real app would know.
          </p>
          <div class="mt-8 space-y-2">
            ${data.map(courier => `
              <a href="/courier?courier=${courier.id}" class="flex justify-between items-center p-5 rounded-[1.25rem] transition-transform duration-500 hover:-translate-y-0.5"
                 style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
                <span class="text-[15px] font-medium">${escapeHtml(courier.name)}</span>
                <span class="text-[12px]" style="color: var(--ink-soft)">${escapeHtml(courier.status.replace('_', ' '))}</span>
              </a>`).join('')}
          </div>`
      }

      async function load() {
        if (!courierId) {
          pickCourier()
          return
        }

        const response = await fetch(`/api/courier/${courierId}/console`)

        if (!response.ok) {
          root.innerHTML = '<p class="text-[15px]">No such courier.</p>'
          return
        }

        render((await response.json()).data)
      }

      function render(state) {
        const online = state.courier.status !== 'offline'
        const run = state.current

        root.innerHTML = `
          <div class="flex flex-wrap gap-4 justify-between items-center">
            <div>
              <h1 class="text-[clamp(1.7rem,4vw,2.25rem)] font-semibold tracking-[-0.03em]">${escapeHtml(state.courier.name)}</h1>
              <p class="mt-1 text-[13px]" style="color: var(--ink-soft)">${escapeHtml(state.courier.vehicle)}</p>
            </div>
            <button id="shift" class="px-5 py-2.5 text-[14px] font-medium rounded-full transition-all duration-500 active:scale-[0.98]"
              style="${online ? 'background: var(--ink); color: var(--paper)' : 'border: 1px solid var(--line); color: var(--ink-soft)'}">
              ${online ? 'On shift' : 'Go online'}
            </button>
          </div>

          <div class="grid grid-cols-3 gap-3 mt-8">
            ${[['Deliveries', state.earnings.deliveries], ['Fees', money(state.earnings.feeCents)], ['Tips', money(state.earnings.tipCents)]]
              .map(([label, value]) => `
                <div class="p-5 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
                  <p class="text-[22px] font-semibold tracking-[-0.02em] tabular-nums">${value}</p>
                  <p class="mt-1 text-[12px]" style="color: var(--ink-soft)">${label}</p>
                </div>`).join('')}
          </div>

          ${run ? runCard(run) : `
            <div class="p-8 mt-8 text-center rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
              <p class="text-[15px]" style="color: var(--ink-soft)">
                ${online ? 'Nothing assigned. Waiting for a job.' : 'You are offline.'}
              </p>
            </div>`}

          ${state.remaining.length === 0 ? '' : `
            <section class="mt-8">
              <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">Then</h2>
              <ul class="mt-3 space-y-2 text-[14px]">
                ${state.remaining.map(stop => `
                  <li class="flex gap-4 justify-between">
                    <span>${stop.type === 'pickup' ? 'Collect from' : 'Deliver to'} ${escapeHtml(stop.address)}</span>
                    ${stop.distanceMeters == null ? '' : `<span class="tabular-nums shrink-0" style="color: var(--ink-soft)">${(stop.distanceMeters / 1000).toFixed(1)} km</span>`}
                  </li>`).join('')}
              </ul>
            </section>`}`

        const shift = document.getElementById('shift')
        if (shift) {
          shift.addEventListener('click', async () => {
            const response = await post(`/api/courier/${courierId}/shift`, { online: !online })
            if (!response.ok) {
              const { message } = await response.json()
              alert(message)
              return
            }
            load()
          })
        }

        root.querySelectorAll('[data-stop]').forEach((el) => {
          el.addEventListener('click', async () => {
            await post(`/api/courier/stops/${el.dataset.stop}/${el.dataset.action}`, {})
            load()
          })
        })
      }

      function runCard(run) {
        const heading = run.type === 'pickup' ? 'Collect the order' : 'Deliver the order'
        const where = run.type === 'pickup' ? run.businessName : run.recipientName
        const started = run.status !== 'pending'

        // Hand navigation to the map the courier already uses. Rebuilding
        // turn-by-turn inside a demo would be worse at the one job it has.
        const nav = run.latitude == null
          ? ''
          : `<a href="https://www.google.com/maps/dir/?api=1&destination=${run.latitude},${run.longitude}" target="_blank" rel="noopener"
               class="flex justify-center items-center px-5 py-3 text-[14px] font-medium rounded-full transition-all duration-500"
               style="border: 1px solid var(--line)">Navigate</a>`

        return `
          <div class="p-1.5 mt-8 rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 18px 36px -22px rgba(20,17,15,0.14)">
            <div class="p-6 rounded-[calc(1.75rem-0.375rem)]">
              <p class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--accent)">${heading}</p>
              <p class="mt-2 text-[20px] font-semibold tracking-[-0.02em]">${escapeHtml(where)}</p>
              <p class="mt-1 text-[15px]" style="color: var(--ink-soft)">${escapeHtml(run.address)}</p>
              ${run.distanceMeters == null ? '' : `<p class="mt-2 text-[13px]" style="color: var(--ink-soft)">${(run.distanceMeters / 1000).toFixed(1)} km away</p>`}

              <div class="grid grid-cols-1 gap-2 mt-6 sm:grid-cols-2">
                ${nav}
                ${started
                  ? `<button data-stop="${run.stopId}" data-action="complete" class="flex justify-center items-center px-5 py-3 text-[14px] font-medium rounded-full transition-all duration-500 active:scale-[0.98]" style="background: var(--accent); color: #fff">${run.type === 'pickup' ? 'Picked it up' : 'Handed it over'}</button>`
                  : `<button data-stop="${run.stopId}" data-action="start" class="flex justify-center items-center px-5 py-3 text-[14px] font-medium rounded-full transition-all duration-500 active:scale-[0.98]" style="background: var(--ink); color: var(--paper)">On my way</button>`}
              </div>
            </div>
          </div>`
      }

      load()
    </script>
  </body>
</html>
