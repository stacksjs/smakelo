<script server>
/*
 * The courier's screen.
 *
 * Used one-handed, outdoors, on the phone that is also the navigation, so it
 * shows only what is true right now: on shift or not, what is being carried,
 * where the next stop is, and what the day has paid. Big targets, few words.
 *
 * `?courier=<id>` picks who you are, because this demo has no courier accounts
 * and inventing a login for an invented person would be theatre. A real
 * deployment resolves the courier from the session, which is what the
 * framework's own ping and stop endpoints already do.
 */
import { currentLocale, t } from '../../app/Actions/Locale/translate'

/*
 * The strings this page's own script writes, already translated.
 *
 * Built here and carried to the markup on a data attribute, the same way the
 * rest of this app hands the client a payload. Written inline in the markup
 * instead, stx sometimes reads it as a client expression and leaves the
 * literal `{{ JSON.stringify(` in the attribute, which is a page whose script
 * silently falls back to English. The shared strings are in partials/head.stx.
 */
const clientStrings = JSON.stringify({
  'courier.on_shift': t('courier.on_shift'),
  'courier.shift_start': t('courier.shift_start'),
  'courier.sharing_position': t('courier.sharing_position'),
  'courier.position_private': t('courier.position_private'),
  'courier.stop_sharing': t('courier.stop_sharing'),
  'courier.share_position': t('courier.share_position'),
  'courier.collect_order': t('courier.collect_order'),
  'courier.deliver_order': t('courier.deliver_order'),
  'courier.picked_it_up': t('courier.picked_it_up'),
  'courier.handed_it_over': t('courier.handed_it_over'),
  'courier.nothing_assigned': t('courier.nothing_assigned'),
  'courier.you_are_offline': t('courier.you_are_offline'),
  'courier.collect_from': t('courier.collect_from'),
  'courier.deliver_to': t('courier.deliver_to'),
  'courier.estimate_only': t('courier.estimate_only'),
  'courier.reporting_pocket': t('courier.reporting_pocket'),
  'courier.reporting_screen': t('courier.reporting_screen'),
  'courier.deliveries': t('courier.deliveries'),
  'courier.fees': t('courier.fees'),
  'courier.tips': t('courier.tips'),
  'courier.away': t('courier.away', { distance: '{distance}' }),
  'courier.state_active': t('courier.state_active'),
  'courier.state_offline': t('courier.state_offline'),
  'courier.state_on_delivery': t('courier.state_on_delivery'),
})

const pageTitle = t('meta.courier_title')
const pageDescription = t('meta.courier_description')
const canonicalPath = '/courier'
</script>

<!DOCTYPE html>
<html lang="{{ currentLocale() }}">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-2xl" data-stx-content>
      <div class="pt-10 pb-24">
        {{-- What this page's own script writes, already translated. --}}
        <div hidden data-i18n-strings="{{ clientStrings }}"></div>

        <p :if="loading()" class="text-[15px]" style="color: var(--ink-soft)">{{ t('common.loading') }}…</p>

        {{-- No courier chosen: pick one, since these people are invented. --}}
        <div :if="!loading() && !courierId()">
          <h1 class="text-[clamp(1.9rem,4vw,2.5rem)] font-semibold tracking-[-0.03em]">{{ t('courier.who_are_you') }}</h1>
          <p class="mt-3 text-[15px]" style="color: var(--ink-soft)">
            {{ t('courier.pick_one') }}
          </p>

          <div class="mt-8 space-y-2">
            <a
              :for="person in roster()"
              :href="'/courier?courier=' + person.id"
              class="flex justify-between items-center p-5 rounded-[1.25rem] transition-transform duration-500 hover:-translate-y-0.5"
              style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)"
            >
              <span class="text-[15px] font-medium">{{ person.name }}</span>
              <span class="text-[12px]" style="color: var(--ink-soft)">{{ shiftState(person.status) }}</span>
            </a>
          </div>
        </div>

        <p :if="!loading() && courierId() && !view()" class="text-[15px]">{{ t('courier.no_such_courier') }}</p>

        {{-- On shift. --}}
        <div :if="view()">
          <div class="flex flex-wrap gap-4 justify-between items-center">
            <div>
              <h1 class="text-[clamp(1.7rem,4vw,2.25rem)] font-semibold tracking-[-0.03em]">{{ view().courier.name }}</h1>
              <p class="mt-1 text-[13px]" style="color: var(--ink-soft)">{{ view().courier.vehicle }}</p>
            </div>

            <button
              @click="toggleShift()"
              class="px-5 py-2.5 text-[14px] font-medium rounded-full transition-all duration-500 active:scale-[0.98]"
              :style="online() ? 'background: var(--ink); color: var(--paper)' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
            >{{ online() ? say('courier.on_shift', 'On shift') : say('courier.shift_start', 'Go online') }}</button>
          </div>

          <p :if="error()" class="mt-3 text-[13px]" style="color: var(--accent)">{{ error() }}</p>

          {{-- Position sharing is its own switch, separate from being on shift.
            A courier can be on shift while walking to their bike, and a phone
            reporting a position nobody asked it for is a phone somebody
            eventually turns off. --}}
          <div class="flex flex-wrap gap-3 items-center p-4 mt-6 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
            <div class="flex-1 min-w-[200px]">
              <p class="text-[14px] font-medium">{{ sharing() ? say('courier.sharing_position', 'Sharing your position') : say('courier.position_private', 'Position not shared') }}</p>
              <p class="mt-1 text-[12px] leading-relaxed" style="color: var(--ink-soft)">{{ trackingNote() }}</p>
            </div>

            <button
              @click="toggleTracking()"
              class="px-5 py-2.5 text-[14px] font-medium rounded-full transition-all duration-500 active:scale-[0.98]"
              :style="sharing() ? 'background: var(--accent-soft); color: var(--accent)' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
            >{{ sharing() ? say('courier.stop_sharing', 'Stop sharing') : say('courier.share_position', 'Share position') }}</button>
          </div>

          <a :href="'/earnings?party=courier:' + courierId()" class="grid grid-cols-3 gap-3 mt-8 transition-transform duration-500 hover:-translate-y-0.5">
            <div :for="tile in earningTiles()" class="p-5 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
              <p class="text-[22px] font-semibold tracking-[-0.02em] tabular-nums">{{ tile.value }}</p>
              <p class="mt-1 text-[12px]" style="color: var(--ink-soft)">{{ tile.label }}</p>
            </div>
          </a>

          {{-- The job in hand. --}}
          <div :if="view().current" class="p-1.5 mt-8 rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 18px 36px -22px rgba(20,17,15,0.14)">
            <div class="p-6 rounded-[calc(1.75rem-0.375rem)]">
              <p class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--accent)">
                {{ view().current.type === 'pickup' ? say('courier.collect_order', 'Collect the order') : say('courier.deliver_order', 'Deliver the order') }}
              </p>
              <p class="mt-2 text-[20px] font-semibold tracking-[-0.02em]">
                {{ view().current.type === 'pickup' ? view().current.businessName : view().current.recipientName }}
              </p>
              <p class="mt-1 text-[15px]" style="color: var(--ink-soft)">{{ view().current.address }}</p>
              <p :if="view().current.distanceMeters !== null" class="mt-2 text-[13px]" style="color: var(--ink-soft)">
                {{ awayLine(view().current.distanceMeters) }}
              </p>

              <div class="grid grid-cols-1 gap-2 mt-6 sm:grid-cols-2">
                {{-- Navigation is handed to the map the courier already uses.
                  Rebuilding turn-by-turn inside a demo would be worse at the
                  one job it has. --}}
                <a
                  :if="view().current.latitude !== null"
                  :href="'https://www.google.com/maps/dir/?api=1&destination=' + view().current.latitude + ',' + view().current.longitude"
                  target="_blank"
                  rel="noopener"
                  class="flex justify-center items-center px-5 py-3 text-[14px] font-medium rounded-full transition-all duration-500"
                  style="border: 1px solid var(--line)"
                >{{ t('courier.navigate') }}</a>

                <button
                  :if="view().current.status === 'pending'"
                  @click="advance(view().current.stopId, 'start')"
                  class="flex justify-center items-center px-5 py-3 text-[14px] font-medium rounded-full transition-all duration-500 active:scale-[0.98]"
                  style="background: var(--ink); color: var(--paper)"
                >{{ t('courier.on_my_way') }}</button>

                <button
                  :if="view().current.status !== 'pending'"
                  @click="advance(view().current.stopId, 'complete')"
                  class="flex justify-center items-center px-5 py-3 text-[14px] font-medium rounded-full transition-all duration-500 active:scale-[0.98]"
                  style="background: var(--accent); color: #fff"
                >{{ view().current.type === 'pickup' ? say('courier.picked_it_up', 'Picked it up') : say('courier.handed_it_over', 'Handed it over') }}</button>
              </div>
            </div>
          </div>

          <div :if="!view().current" class="p-8 mt-8 text-center rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
            <p class="text-[15px]" style="color: var(--ink-soft)">
              {{ online() ? say('courier.nothing_assigned', 'Nothing assigned. Waiting for a job.') : say('courier.you_are_offline', 'You are offline.') }}
            </p>
          </div>

          <section :if="view().remaining.length > 0" class="mt-8">
            <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('courier.then') }}</h2>
            <ul class="mt-3 space-y-2 text-[14px]">
              <li :for="stop in view().remaining" class="flex gap-4 justify-between">
                <span>{{ stop.type === 'pickup' ? say('courier.collect_from', 'Collect from') : say('courier.deliver_to', 'Deliver to') }} {{ stop.address }}</span>
                <span :if="stop.distanceMeters !== null" class="tabular-nums shrink-0" style="color: var(--ink-soft)">{{ km(stop.distanceMeters) }}</span>
              </li>
            </ul>
          </section>
        </div>
      </div>
    </main>

    <script client>
      import { startTracking } from '../functions/courier-tracking'
      import { money, send } from '../functions/session'

      /*
       * The words this script writes, in the language the server served.
       *
       * The English text is the second argument rather than a fallback to the
       * key, so a string no holder carries reads as English rather than as its
       * own name. The page's holder is in the markup above; the shared bundle
       * is in partials/head.stx.
       */
      function say(key, english) {
        return window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, english) : english
      }

      /* Where a courier is right now, in words rather than as the column
         value. An unknown state falls back to the value with its underscores
         opened out, which is what this used to do for every one of them. */
      /* How far the next stop is, with the distance where the sentence wants
         it. */
      function awayLine(metres) {
        return say('courier.away', '{distance} away').replace('{distance}', km(metres))
      }

      function shiftState(status) {
        const key = String(status ?? '')

        return say(`courier.state_${key}`, key.replace(/_/g, ' '))
      }

      const courierId = state(0)
      const roster = state([])
      const view = state(null)
      const loading = state(true)
      const error = state('')

      const online = derived(() => Boolean(view()) && view().courier.status !== 'offline')

      const sharing = state(false)
      const nativeTracking = state(false)

      const trackingNote = derived(() => {
        if (!sharing())
          return say('courier.estimate_only', 'The customer sees an estimate, not a courier, until you turn this on.')

        return nativeTracking()
          ? say('courier.reporting_pocket', 'Reporting, and it keeps reporting with the phone in your pocket.')
          : say('courier.reporting_screen', 'Reporting while this screen is open. The app keeps going in your pocket; a browser does not.')
      })

      let tracker = null

      /*
       * The position stream is not tied to being on shift.
       *
       * A courier can be on shift while walking to their bike, and a phone that
       * reports a position nobody asked it for is a phone somebody turns off.
       */
      function toggleTracking() {
        if (tracker) {
          tracker.stop()
          tracker = null
          sharing.set(false)
          return
        }

        tracker = startTracking(courierId())
        nativeTracking.set(tracker.native)
        sharing.set(true)
      }

      const earningTiles = derived(() => {
        const current = view()

        if (!current)
          return []

        return [
          { label: say('courier.deliveries', 'Deliveries'), value: String(current.earnings.deliveries) },
          { label: say('courier.fees', 'Fees'), value: money(current.earnings.feeCents) },
          { label: say('courier.tips', 'Tips'), value: money(current.earnings.tipCents) },
        ]
      })

      function km(meters) {
        return `${(meters / 1000).toFixed(1)} km`
      }

      async function load() {
        const asked = Number(new URLSearchParams(location.search).get('courier') || 0)

        courierId.set(asked)

        if (!asked) {
          const { data } = await (await fetch('/api/couriers-list')).json()

          roster.set(data)
          loading.set(false)
          return
        }

        const response = await fetch(`/api/courier/${asked}/console`)

        view.set(response.ok ? (await response.json()).data : null)
        loading.set(false)
      }

      async function toggleShift() {
        const response = await send(`/api/courier/${courierId()}/shift`, { online: !online() })

        if (!response.ok) {
          error.set((await response.json()).message)
          return
        }

        error.set('')
        load()
      }

      async function advance(stopId, action) {
        await send(`/api/courier/stops/${stopId}/${action}`)
        load()
      }

      load()
    </script>
    @include('footer')
  </body>
</html>
