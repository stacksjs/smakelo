<script server>
/*
 * The old ordering screen, kept only to send people to the new one.
 *
 * Ordering used to happen here, at `/order?business=<slug>`: a second copy of
 * a menu somebody had just read on the restaurant's own page, behind a query
 * string, with the first copy offering nothing to press. The menu on the place
 * page is now the menu you order from, so there is nothing left for this URL
 * to show.
 *
 * It stays because links to it do - printed, bookmarked, indexed - and a URL
 * that has been shared should not become a 404 because the screen behind it
 * was folded into a better one. Routes here are generated from the views, so
 * there is no place to return a 301; the redirect is a meta refresh plus a
 * script, with a real link underneath for anyone who arrives with neither.
 *
 * `noindex` so search engines drop this rather than keep it alongside the page
 * it forwards to.
 */
import { currentLocale, t } from '../../app/Actions/Locale/translate'

const pageTitle = t('meta.checkout_title')
const pageDescription = t('meta.checkout_description')
const canonicalPath = '/discover'
</script>

<!DOCTYPE html>
<html lang="{{ currentLocale() }}">
  <head>
    <meta name="robots" content="noindex, follow">
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-3xl" data-stx-content>
      <div class="py-24 text-center">
        <h1 class="text-[26px] font-semibold tracking-[-0.02em]">{{ t('order.moved_title') }}</h1>
        <p class="mx-auto mt-3 max-w-md text-[15px] leading-relaxed" style="color: var(--ink-soft)">{{ t('order.moved_body') }}</p>

        {{-- Written by the script below once it knows which restaurant this
          was for; a link rather than a button, so it works before the script
          runs and for anyone who has none. --}}
        <a
          id="order-moved-link"
          href="/discover"
          class="inline-flex gap-3 items-center px-5 py-3 mt-8 text-[14px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] group"
          style="background: var(--accent); color: #fff"
        >
          <span>{{ t('order.moved_link') }}</span>
          <span class="flex justify-center items-center w-7 h-7 rounded-full transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5" style="background: rgba(255,255,255,0.2)">
            <i class="w-3.5 h-3.5 i-hugeicons-arrow-right-01"></i>
          </span>
        </a>
      </div>
    </main>

    <script client>
      /*
       * Send them on, and keep the back button usable.
       *
       * `replace` rather than `assign`: this page has nothing to come back to,
       * and leaving it in the history means Back from the restaurant lands
       * here and forwards again, which is a page nobody can leave.
       *
       * The slug is checked against the shape a slug has before it is put in a
       * path, because it arrives from the query string - which is to say, from
       * anyone who can get someone to click a link.
       */
      const asked = new URLSearchParams(location.search).get('business') || ''
      const slug = /^[a-z0-9-]{1,120}$/.test(asked) ? asked : ''
      const destination = slug ? `/places/${slug}` : '/discover'

      const link = document.getElementById('order-moved-link')

      if (link)
        link.href = destination

      location.replace(destination)
    </script>

    @include('footer')
  </body>
</html>
