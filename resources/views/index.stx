<script server>
/*
 * Discover: the browse page.
 *
 * Everything is rendered server-side from the same `searchBusinesses` the API
 * uses, so the page is complete before any script runs and the map is an
 * enhancement rather than a dependency. Someone on a slow connection still gets
 * the whole list; the pins arrive when they arrive.
 */
import { formatDistance } from '../../app/Actions/Business/geo'
import { searchBusinesses } from '../../app/Actions/Business/search'

// Named rather than pluralised by rule: "Coffee" reads better than "Cafes",
// and appending an s produces "Bakerys".
function typeLabel(type: string): string {
  if (type === 'restaurant')
    return 'Restaurants'
  if (type === 'cafe')
    return 'Coffee'
  if (type === 'farm')
    return 'Farms'
  if (type === 'bakery')
    return 'Bakeries'
  if (type === 'grocery')
    return 'Grocers'
  if (type === 'bar')
    return 'Bars'

  return `${type.charAt(0).toUpperCase()}${type.slice(1)}`
}

const pageTitle = 'Smakelo - find the good places near you'
const pageDescription = 'Find restaurants, coffee shops, bakeries and farms across Los Angeles. Read the reviews, then order delivery, pickup or a weekly farm box.'
const canonicalPath = '/'

// Santa Monica, where the seeded data is densest.
const CENTRE = { latitude: 34.0195, longitude: -118.4912 }

// Wide enough to include the farms. They are real growers in Ojai, Moorpark
// and Tehachapi rather than anything in the city, so a tidy city-sized radius
// would drop the entire farm side of the app off its own home page. Distance is
// shown per card, so a box coming from an hour away says so.
/*
 * One query, sliced two ways.
 *
 * A second top-level `await` in this file stops `<script server>` reaching the
 * template at all: every variable comes through undefined and the page renders
 * its full layout around empty values, in the dev server and in the build
 * alike. So the count and the cards come from one call rather than two.
 */
const everything = await searchBusinesses({
  latitude: CENTRE.latitude,
  longitude: CENTRE.longitude,
  radiusMeters: 200000,
  sort: 'distance',
  limit: 400,
})

const total = everything.length

/*
 * The page renders the sixty nearest. Shipping all of them would be a megabyte
 * of HTML for a list nobody scrolls to the end of; the search box covers the
 * rest by asking the server, so nothing is unreachable.
 */
const results = everything.slice(0, 60)

/*
 * The three headline numbers describe everything listed, not the sixty this
 * page happens to render. Counting the slice said "4 take orders" when twelve
 * do, and `openNow` was lost entirely in an edit, leaving a stat card with a
 * label and no number above it.
 */
const partners = everything.filter(business => business.isPartner)
const openNow = everything.filter(business => business.openState === 'open')

/*
 * The type filter is built from what is actually here rather than a hand-kept
 * list. The seed has bakeries, bars and grocers alongside the restaurants,
 * cafes and farms, and a hardcoded row of three would have quietly stranded
 * them: visible under "All" and reachable by no filter.
 *
 * Written as a plain loop on purpose. The first version built this with a Map,
 * spread-of-entries and destructured arrow parameters, and every @foreach on
 * the page then reported its array "is not iterable" - including `results`,
 * which this code does not touch. The page rendered its whole layout around an
 * empty grid, in the dev server and in the build alike. The same snippet in
 * isolation is fine, so the trigger is something about this file rather than
 * the constructs themselves; until that is understood, boring code here costs
 * nothing.
 */
const types = []

for (const business of results) {
  const seen = types.find(entry => entry.type === business.type)

  if (seen)
    seen.count = seen.count + 1
  else
    types.push({ type: business.type, count: 1, label: typeLabel(business.type) })
}

types.sort((a, b) => b.count - a.count)

// The map needs coordinates and a label per pin and nothing else, so it gets
// exactly that. Serialised here so the client script never queries.
const pins = JSON.stringify(results.map(business => ({
  name: business.name,
  slug: business.slug,
  lat: business.latitude,
  lng: business.longitude,
  partner: business.isPartner,
  type: business.type,
})))

const mapCentre = JSON.stringify(CENTRE)

/*
 * The cards, serialised for the client.
 *
 * The grid is rendered from a signal rather than by `@foreach`, so that
 * filtering, sorting and server-backed search all describe the same list
 * instead of one of them reaching into markup the others rendered. The payload
 * is embedded rather than fetched, so the cards appear with the page and not a
 * round trip later.
 *
 * This does trade away a listing that reads with JavaScript off. On a site that
 * carries `noindex` on every page and whose ordering, tracking and merchant
 * screens all need scripting, that baseline was protecting nobody.
 */
const cardsJson = JSON.stringify(results.map(business => ({
  slug: business.slug,
  name: business.name,
  type: business.type,
  cuisine: business.cuisine,
  description: business.description,
  city: business.city,
  price: priceLabel(business.priceTier),
  rating: business.ratingAverage,
  ratingCount: business.ratingCount,
  distance: business.distanceMeters === null ? '' : formatDistance(business.distanceMeters),
  distanceMeters: business.distanceMeters,
  openLabel: openLabel(business),
  openState: business.openState,
  isPartner: business.isPartner,
  haystack: `${business.name} ${business.cuisine} ${business.city} ${business.description}`.toLowerCase(),
  photo: business.photo,
  hue: business.hue,
  hueEnd: business.hueEnd,
  icon: business.icon,
  monogram: business.monogram,
})))

function priceLabel(tier) {
  return '$'.repeat(Math.max(1, Math.min(4, Number(tier) || 2)))
}

function openLabel(business) {
  if (business.openState === 'unknown')
    return 'Hours unknown'

  if (business.openState === 'closed') {
    if (typeof business.opensInMinutes === 'number' && business.opensInMinutes < 180)
      return `Opens in ${business.opensInMinutes} min`

    return 'Closed'
  }

  if (typeof business.closesInMinutes === 'number' && business.closesInMinutes < 60)
    return `Closing in ${business.closesInMinutes} min`

  return 'Open now'
}
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-7xl" data-stx-content>
      {{-- The hero leads with the search, because that is what somebody came
        to do. The counts sit under it as a line of fact rather than three big
        numbers competing with the headline. --}}
      <section class="pt-12 pb-10 sm:pt-16">
        <span class="inline-flex gap-1.5 items-center px-3 py-1 text-[10px] font-medium tracking-[0.2em] uppercase rounded-full" style="background: var(--accent-soft); color: var(--accent)">
          <i class="w-3 h-3 i-hugeicons-location-01"></i>
          Los Angeles
        </span>

        <h1 class="mt-5 text-[clamp(2.25rem,5vw,3.5rem)] font-semibold leading-[1.03] tracking-[-0.04em] text-balance max-w-3xl">
          Find the good places near you.
        </h1>

        <p class="mt-4 max-w-xl text-[16px] leading-relaxed" style="color: var(--ink-soft)">
          Restaurants, coffee shops and farms across Santa Monica, Venice and the
          city. Read what people said, then order from the ones that deliver.
        </p>

        {{-- One search field, big, with the filters folded underneath it. --}}
        <div class="p-1.5 mt-8 rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 24px 48px -24px rgba(20,17,15,0.16)">
          <div class="flex flex-wrap gap-2 items-center p-2 rounded-[calc(1.75rem-0.375rem)]">
            <label class="relative flex-1 min-w-[240px]">
              <i class="absolute left-5 top-1/2 w-5 h-5 -translate-y-1/2 i-hugeicons-search-01" style="color: var(--ink-soft)"></i>
              <input
                type="search"
                data-i18n-placeholder="search.placeholder"
                placeholder="Tacos, oat flat white, a farm box"
                :value="query()"
                @input="onQuery($event.target.value)"
                class="py-4 pr-4 pl-14 w-full text-[16px] rounded-full outline-none"
                style="background: transparent"
              >
            </label>

            <button
              type="button"
              data-i18n="search.open_now"
              @click="openOnly.set(!openOnly())"
              class="inline-flex gap-1.5 items-center px-4 py-2.5 text-[13px] rounded-full transition-all duration-500"
              :style="openOnly() ? 'background: var(--accent-soft); color: var(--accent); border: 1px solid transparent' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
            >
              <i class="w-3.5 h-3.5 i-hugeicons-clock-01"></i>
              Open now
            </button>

            <button
              type="button"
              data-i18n="search.takes_orders"
              @click="ordersOnly.set(!ordersOnly())"
              class="inline-flex gap-1.5 items-center px-4 py-2.5 text-[13px] rounded-full transition-all duration-500"
              :style="ordersOnly() ? 'background: var(--accent-soft); color: var(--accent); border: 1px solid transparent' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
            >
              <i class="w-3.5 h-3.5 i-hugeicons-delivery-truck-01"></i>
              Takes orders
            </button>
          </div>
        </div>

        <p class="mt-4 text-[13px]" style="color: var(--ink-soft)">
          <strong style="color: var(--ink)">{{ total }}</strong> places ·
          <strong style="color: var(--ink)">{{ openNow.length }}</strong> open now ·
          <strong style="color: var(--ink)">{{ partners.length }}</strong> take orders
        </p>
      </section>

      {{-- Categories as a row of tiles rather than a row of words. An icon per
        category is the cheapest way for somebody to find "coffee" without
        reading, and it is built from the results so nothing is stranded. --}}
      <section class="pb-12">
        <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-7">
          <button
            :for="entry in typeFilters()"
            type="button"
            @click="type.set(entry.type)"
            class="flex flex-col gap-2 items-center px-3 py-5 rounded-[1.25rem] transition-all duration-500 hover:-translate-y-0.5"
            :style="type() === entry.type ? 'background: var(--ink); color: var(--paper); box-shadow: 0 14px 28px -20px rgba(20,17,15,0.4)' : 'background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04)'"
          >
            <i class="w-6 h-6" :class="'i-hugeicons-' + entry.icon"></i>
            <span class="text-[12px] font-medium">{{ entry.label }}</span>
            <span class="text-[11px]" :style="type() === entry.type ? 'opacity: .6' : 'color: var(--ink-soft)'">{{ entry.count }}</span>
          </button>
        </div>
      </section>

      {{-- A pin per result, and a popup that links through. The map sits above
        the list rather than beside it so the phone layout is the same layout. --}}
      <section class="pb-14">
        <div class="p-2 rounded-[2rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 24px 48px -24px rgba(20,17,15,0.16)">
          <div id="discover-map" data-pins="{{ pins }}" data-centre="{{ mapCentre }}" class="h-[380px] sm:h-[460px] w-full rounded-[calc(2rem-0.5rem)] overflow-hidden" style="background: var(--paper)"></div>
        </div>
        <p class="mt-3 text-[11px]" style="color: var(--ink-soft)">
          Map data and tiles from OpenStreetMap contributors.
        </p>
      </section>

      <section class="pb-24 sm:pb-40">
        <div class="flex flex-wrap gap-4 justify-between items-baseline pb-6">
          <h2 data-i18n="search.nearby" class="text-[28px] font-semibold tracking-[-0.03em]">Nearby</h2>
          <p class="text-[13px]" style="color: var(--ink-soft)">{{ countLine() }}</p>
        </div>

        {{-- Controls and grid both read the same signal, so filtering,
          sorting and server-backed search cannot disagree about what the list
          is. The payload is embedded in `data-cards` rather than fetched, so
          the cards arrive with the page. --}}
        <div
          id="page-data"
          data-cards="{{ cardsJson }}"
          data-total="{{ total }}"
          data-centre="{{ mapCentre }}"
          hidden
        ></div>

        <div class="flex flex-wrap gap-4 justify-between items-baseline pb-6">
          <h2 data-i18n="search.nearby" class="text-[24px] font-semibold tracking-[-0.03em]">Nearby</h2>

          <div class="flex gap-3 items-center">
            <p class="text-[13px]" style="color: var(--ink-soft)">{{ countLine() }}</p>
            <select @change="sort.set($event.target.value)" class="px-4 py-2 text-[13px] rounded-full" style="background: var(--paper-raised); border: 1px solid var(--line)">
              <option value="distance" data-i18n="search.sort_distance">Nearest</option>
              <option value="rating" data-i18n="search.sort_rating">Best rated</option>
              <option value="name" data-i18n="search.sort_name">A to Z</option>
            </select>
          </div>
        </div>

        <p :if="shown().length === 0" data-i18n="search.no_results" class="py-12 text-center text-[15px]" style="color: var(--ink-soft)">
          Nothing matches that. Try fewer words.
        </p>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          <a
            :for="card in shown()"
            :href="'/places/' + card.slug"
            class="reveal group overflow-hidden block rounded-[1.5rem] transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1"
            style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 18px 36px -20px rgba(20,17,15,0.14)"
          >
            {{-- The photograph, over the business's own colour. The colour is
              what shows while it decodes and what remains if it never
              arrives; see app/Actions/Business/imagery.ts. --}}
            <div class="cover flex justify-center items-center h-44" :style="'--h: ' + card.hue + '; --h2: ' + card.hueEnd">
              <i class="cover-mark w-9 h-9" :class="'i-hugeicons-' + card.icon"></i>

              <img class="cover-photo" :src="card.photo" alt="" loading="lazy" decoding="async" width="800" height="560">

              <span class="cover-scrim"></span>

              <span
                :if="card.openState === 'open'"
                class="absolute top-3 left-3 inline-flex gap-1.5 items-center px-2.5 py-1 text-[11px] font-medium rounded-full backdrop-blur-sm"
                style="background: rgba(255,255,255,0.92); color: #14713f"
              >
                <span class="w-1.5 h-1.5 rounded-full" style="background: #14713f"></span>
                Open
              </span>

              <span
                :if="card.isPartner"
                class="absolute top-3 right-3 inline-flex gap-1 items-center px-2.5 py-1 text-[11px] font-medium rounded-full"
                style="background: var(--accent); color: #fff"
              >
                <i class="w-3 h-3 i-hugeicons-delivery-truck-01"></i>
                Orders
              </span>

              <span class="absolute right-3 bottom-2.5 text-[11px] font-semibold tracking-[0.14em] text-white" style="opacity: .82; text-shadow: 0 1px 2px rgba(0,0,0,.4)">{{ card.monogram }}</span>
            </div>

            <div class="flex flex-col p-5 h-full">
              <h3 class="text-[17px] font-semibold leading-snug tracking-[-0.01em]">{{ card.name }}</h3>

              <div class="flex flex-wrap gap-2 items-center mt-1.5 text-[13px]">
                <span :if="card.ratingCount > 0" class="inline-flex gap-1.5 items-center">
                  <span class="stars text-[13px]">★★★★★<span :style="'width: ' + (card.rating / 5 * 100) + '%'">★★★★★</span></span>
                  <span class="font-medium">{{ card.rating }}</span>
                  <span style="color: var(--ink-soft)">({{ card.ratingCount }})</span>
                </span>
                <span :if="card.ratingCount === 0" style="color: var(--ink-soft)">No reviews yet</span>
              </div>

              <p class="mt-2 text-[13px]" style="color: var(--ink-soft)">{{ card.cuisine || card.type }} · {{ card.price }}</p>

              <p :if="card.description" class="mt-3 text-[14px] leading-relaxed line-clamp-2" style="color: var(--ink-soft)">{{ card.description }}</p>

              <div class="flex flex-wrap gap-2 items-center pt-4 mt-auto text-[11px]">
                <span :if="card.distance" class="inline-flex gap-1 items-center px-2.5 py-1 rounded-full" style="background: var(--accent-soft); color: var(--accent)">
                  <i class="w-3 h-3 i-hugeicons-navigation-03"></i>
                  {{ card.distance }}
                </span>
                <span class="px-2.5 py-1 rounded-full" style="border: 1px solid var(--line); color: var(--ink-soft)">{{ card.openLabel }}</span>
              </div>
            </div>
          </a>
        </div>
      </section>
    </main>

    <footer class="border-t" style="border-color: var(--line)">
      <div class="mx-auto px-4 sm:px-8 py-12 max-w-7xl text-[13px]" style="color: var(--ink-soft)">
        <p>
          Smakelo is a demonstration built on <a href="https://github.com/stacksjs/stacks" class="underline underline-offset-4">Stacks</a>.
          Listings from OpenStreetMap and Foursquare Open Source Places. Everything else is invented.
        </p>
      </div>
    </footer>

    <script client>
      import { Marker, tileLayer, TsMap } from 'ts-maps'
      import 'ts-maps/styles.css'

      /*
       * One list, four controls, and a search that reaches past the page.
       *
       * The cards come embedded in `data-cards` rather than from a fetch, so
       * they render with the page. The controls, the grid and the map pins all
       * read the same derived list, which is the point: when filtering lived in
       * the DOM, the map had to be told separately what the grid had hidden.
       */
      const source = document.getElementById('page-data')
      const cards = state(source ? JSON.parse(source.dataset.cards || '[]') : [])
      const total = Number(source ? source.dataset.total : 0)
      const centre = source ? JSON.parse(source.dataset.centre || '{}') : { latitude: 34.0195, longitude: -118.4912 }

      const query = state('')
      const type = state('')
      const openOnly = state(false)
      const ordersOnly = state(false)
      const sort = state('distance')
      const remote = state([])

      /*
       * Built from what is actually here rather than a hand-kept list. The seed
       * has bakeries, bars and grocers alongside the restaurants, cafes and
       * farms, and a hardcoded row of three would strand them: visible under
       * "All" and reachable by no filter.
       */
      const typeFilters = derived(() => {
        const counts = []

        for (const card of cards()) {
          const seen = counts.find(entry => entry.type === card.type)

          if (seen)
            seen.count += 1
          else
            counts.push({ type: card.type, count: 1, label: label(card.type), icon: typeIcon(card.type) })
        }

        counts.sort((a, b) => b.count - a.count)

        return [
          { type: '', label: say('search.all_types', 'All'), count: cards().length, icon: 'restaurant-01' },
          ...counts,
        ]
      })

      const shown = derived(() => {
        const words = query().trim().toLowerCase().split(/\s+/).filter(Boolean)

        const matching = [...cards(), ...remote()].filter((card) => {
          if (type() && card.type !== type())
            return false

          if (openOnly() && card.openState !== 'open')
            return false

          if (ordersOnly() && !card.isPartner)
            return false

          // Every word has to appear somewhere, so "venice coffee" narrows
          // rather than widening the way an any-word match would.
          return words.every(word => card.haystack.includes(word))
        })

        return matching.sort((a, b) => {
          if (sort() === 'rating')
            return Number(b.rating) - Number(a.rating)

          if (sort() === 'name')
            return a.name.localeCompare(b.name)

          // A card with no distance sorts last rather than first.
          return (Number(a.distanceMeters) || Infinity) - (Number(b.distanceMeters) || Infinity)
        })
      })

      const countLine = derived(() => {
        const sortLabel = {
          distance: say('search.sort_distance', 'Nearest'),
          rating: say('search.sort_rating', 'Best rated'),
          name: say('search.sort_name', 'A to Z'),
        }[sort()]

        if (query().trim().length >= 3)
          return `${shown().length} found · ${sortLabel}`

        return `${shown().length} / ${total} · ${sortLabel}`
      })

      function say(key, fallback) {
        return window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, fallback) : fallback
      }

      // The tile icons, which are the category icons the covers use so the two
      // read as one vocabulary rather than two.
      function typeIcon(value) {
        return {
          restaurant: 'restaurant-01',
          cafe: 'coffee-01',
          farm: 'plant-01',
          bakery: 'bread-01',
          grocery: 'shopping-basket-01',
          bar: 'drink',
        }[value] || 'restaurant-01'
      }

      function label(value) {
        const named = {
          restaurant: 'Restaurants',
          cafe: 'Coffee',
          farm: 'Farms',
          bakery: 'Bakeries',
          grocery: 'Grocers',
          bar: 'Bars',
        }

        return named[value] || `${value.charAt(0).toUpperCase()}${value.slice(1)}`
      }

      /*
       * Typing searches everything, not just what is on the page.
       *
       * The page carries the sixty nearest; the rest are reachable because a
       * query goes to the server, which searches the lot. Filtering only what
       * was embedded would mean a search box that quietly cannot find most of
       * the places the site lists.
       *
       * Short queries stay local: one or two letters match half the city, and a
       * request per keystroke to learn that is waste.
       */
      let pending = null

      function onQuery(value) {
        query.set(value)

        clearTimeout(pending)
        pending = setTimeout(runSearch, 250)
      }

      async function runSearch() {
        const term = query().trim()

        if (term.length < 3) {
          remote.set([])
          return
        }

        const params = new URLSearchParams({
          q: term,
          limit: '60',
          lat: String(centre.latitude),
          lng: String(centre.longitude),
          radius: '200000',
        })

        const response = await fetch(`/api/businesses?${params}`).catch(() => null)

        if (!response || !response.ok)
          return

        const { data } = await response.json()
        const have = new Set(cards().map(card => card.slug))

        remote.set(data.filter(business => !have.has(business.slug)).map(business => ({
          slug: business.slug,
          name: business.name,
          type: business.type,
          cuisine: business.cuisine || business.type,
          description: business.description || '',
          city: business.city,
          price: '$'.repeat(Math.max(1, Math.min(4, Number(business.priceTier) || 2))),
          rating: business.ratingAverage,
          ratingCount: business.ratingCount,
          distance: '',
          distanceMeters: business.distanceMeters,
          openLabel: business.openState === 'open' ? 'Open now' : business.city,
          openState: business.openState,
          isPartner: business.isPartner,
          haystack: `${business.name} ${business.cuisine} ${business.city}`.toLowerCase(),
          photo: business.photo,
          hue: business.hue,
          hueEnd: business.hueEnd,
          icon: business.icon,
          monogram: business.monogram,
        })))
      }

      // The map is imperative by nature: it owns its own DOM. It is set up once
      // and then only told which pins to show.
      const mapEl = document.getElementById('discover-map')
      const markers = new Map()

      if (mapEl) {
        const map = new TsMap(mapEl, { center: [centre.latitude, centre.longitude], zoom: 12 })

        tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap contributors',
          maxZoom: 19,
        }).addTo(map)

        // Pins are keyed by slug so the effect below can hide the ones the
        // filter has excluded.
        const pins = JSON.parse(mapEl.dataset.pins || '[]')

        for (const pin of pins) {
          const marker = new Marker([pin.lat, pin.lng]).addTo(map)

          // A partner can take an order; a listing can only be read about, and
          // the popup should not pretend otherwise.
          marker.bindPopup(
            `<strong>${pin.name}</strong><br>`
            + `<span style="opacity:.7">${pin.type}</span><br>`
            + `<a href="/places/${pin.slug}">${pin.partner ? 'Order or read reviews' : 'Read reviews'}</a>`,
          )

          markers.set(pin.slug, marker)
        }

        // The map should agree with the list beneath it.
        effect(() => {
          const visible = new Set(shown().map(card => card.slug))

          for (const [slug, marker] of markers) {
            const element = marker.getElement?.()

            if (element)
              element.style.display = visible.has(slug) ? '' : 'none'
          }
        })
      }

      // The count line writes itself from the dictionary, which arrives after
      // this runs.
      document.addEventListener('smakelo:locale', () => sort.set(sort()))
    </script>
  </body>
</html>
