<script server>
/*
 * Home.
 *
 * A landing page rather than the search itself, which now lives at /discover.
 * The two were one page and it served neither: somebody arriving cold got a
 * filter rail before they knew what the site was, and somebody who came to
 * search had to scroll past an introduction they had already read.
 *
 * So this one answers "what is this and what is here" with real rows off the
 * same query the search uses - open now, taking orders, the farms - and hands
 * off to /discover for the actual work. Everything is server-rendered; there
 * is no signal-driven grid here, so the page is complete before any script
 * runs.
 */
import { currentLocale, t } from '../../app/Actions/Locale/translate'
import { requestQuery } from '../../app/Actions/Request/context'
import { searchBusinesses } from '../../app/Actions/Business/search'
import { REGIONS, resolveRegion } from '../../app/Actions/Business/regions'

/*
 * A type, in the language being served.
 *
 * Named per type rather than pluralised by rule: "Coffee" reads better than
 * "Cafes" in English, and a rule that appends an s produces "Bakerys" in
 * English and nonsense in German. A missing key falls through to the type
 * itself, capitalised, which is a poor label and a legible one.
 */
function typeLabel(type: string): string {
  const translated = t(`types.${type}`)

  return translated === `types.${type}`
    ? `${type.charAt(0).toUpperCase()}${type.slice(1)}`
    : translated
}

/*
 * Where this page is about.
 *
 * `?region=` if somebody asked for one, otherwise the region that matches the
 * language being served - German pages open on Wuppertal, English on Los
 * Angeles. See app/Actions/Business/regions.ts.
 */
const region = resolveRegion(requestQuery().region, currentLocale())
const regions = REGIONS

const pageTitle = t('meta.home_title')
const pageDescription = t('meta.home_description', { region: region.name })
const canonicalPath = '/'

/*
 * One query, sliced two ways.
 *
 * A second top-level `await` in this file stops `<script server>` reaching the
 * template at all: every variable comes through undefined and the page renders
 * its full layout around empty values, in the dev server and in the build
 * alike. So the count and the cards come from one call rather than two.
 */
const everything = await searchBusinesses({
  latitude: region.latitude,
  longitude: region.longitude,
  radiusMeters: region.radiusMeters,
  sort: 'distance',
  limit: 400,
})

const total = everything.length

/*
 * The three headline numbers describe everything listed, not the sixty this
 * page happens to render. Counting the slice said "4 take orders" when twelve
 * do, and `openNow` was lost entirely in an edit, leaving a stat card with a
 * label and no number above it.
 */
const partners = everything.filter(business => business.isPartner)
const openNow = everything.filter(business => business.openState === 'open')

/*
 * Three lines that put a number inside a sentence.
 *
 * Built here rather than in the markup: stx reads a template expression whose
 * argument object names a variable as a client binding, and leaves the whole
 * call sitting in the page as literal text. Anything a template on this page
 * interpolates is a plain value for that reason.
 */
const seeAllLabel = t('home.see_all', { count: total })
const howOrderBody = t('home.how_order_body', { count: partners.length })
const subscribeBody = t('home.subscribe_body', { count: partners.length })

/*
 * The rows.
 *
 * Sliced from the one query above rather than queried again: a second
 * top-level await in this file stops `<script server>` reaching the template
 * at all, and the page then renders its whole layout around undefined values.
 *
 * Plain loops and plain slices for the same reason the type counts use them -
 * see the note above. Boring code here costs nothing.
 */
const openCards = []

for (const business of everything) {
  if (openCards.length >= 6)
    break

  if (business.openState === 'open' && business.ratingCount > 0)
    openCards.push(business)
}

const partnerCards = []

for (const business of everything) {
  if (partnerCards.length >= 6)
    break

  if (business.isPartner)
    partnerCards.push(business)
}

const farmCards = []

for (const business of everything) {
  if (farmCards.length >= 3)
    break

  if (business.type === 'farm')
    farmCards.push(business)
}

/* Category tiles, over everything listed rather than the sixty this page
   renders, so the counts match what /discover will actually show. */
const categories = []

for (const business of everything) {
  const seen = categories.find(entry => entry.type === business.type)

  if (seen)
    seen.count = seen.count + 1
  else
    categories.push({ type: business.type, count: 1, label: typeLabel(business.type), icon: typeIcon(business.type) })
}

categories.sort((a, b) => b.count - a.count)

function typeIcon(type) {
  if (type === 'restaurant')
    return 'restaurant-01'
  if (type === 'cafe')
    return 'coffee-01'
  if (type === 'farm')
    return 'plant-01'
  if (type === 'bakery')
    return 'bread-01'
  if (type === 'grocery')
    return 'shopping-basket-01'
  if (type === 'bar')
    return 'drink'

  return 'restaurant-01'
}
</script>

<!DOCTYPE html>
<html lang="{{ currentLocale() }}">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-7xl" data-stx-content>
      {{-- The hero.

        One question - where are you eating - and one field to answer it. The
        field does not filter this page; it hands the words to /discover, which
        is the page built to answer them. A landing page that half-searches is
        two search boxes for one search. --}}
      <section class="pt-10 pb-12 sm:pt-16 sm:pb-16">
        <span class="inline-flex gap-1.5 items-center px-3 py-1 text-[10px] font-medium tracking-[0.2em] uppercase rounded-full" style="background: var(--accent-soft); color: var(--accent)">
          <i class="w-3 h-3 i-hugeicons-location-01"></i>
          {{ region.name }}
        </span>

        <h1 class="mt-5 text-[clamp(2.25rem,6vw,3.75rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-balance max-w-3xl">
          {{ t('home.title') }}
        </h1>

        <p class="mt-4 max-w-xl text-[clamp(0.95rem,2.2vw,1.0625rem)] leading-relaxed" style="color: var(--ink-soft)">
          {{ t('home.lede') }}
        </p>

        <form action="/discover" method="get" class="p-1.5 mt-8 max-w-2xl rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 24px 48px -24px rgba(20,17,15,0.16)">
          <div class="flex flex-col gap-2 items-stretch sm:flex-row sm:items-center">
            <label class="flex relative flex-1 items-center min-w-0">
              <i class="absolute left-5 w-5 h-5 i-hugeicons-search-01" style="color: var(--ink-soft)"></i>
              <span class="sr-only">{{ t('search.label') }}</span>
              <input
                type="search"
                name="q"
                placeholder="{{ t('search.placeholder') }}"
                class="py-4 pr-4 pl-14 w-full text-[16px] rounded-full outline-none"
                style="background: transparent"
              >
            </label>

            <button
              type="submit"
              class="px-7 py-4 text-[15px] font-medium whitespace-nowrap rounded-full transition-all duration-500 hover:-translate-y-px active:scale-[0.99]"
              style="background: var(--ink); color: var(--paper)"
            >
              {{ t('search.submit') }}
            </button>
          </div>
        </form>

        <div class="flex flex-wrap gap-x-8 gap-y-3 mt-7">
          <p class="inline-flex gap-2 items-center text-[13px]" style="color: var(--ink-soft)">
            <span class="inline-flex justify-center items-center w-7 h-7 rounded-[9px]" style="background: var(--info-soft); color: var(--info)"><i class="w-3.5 h-3.5 i-hugeicons-store-01"></i></span>
            <strong class="text-[20px] font-semibold" style="color: var(--ink)">{{ total }}</strong>
            {{ t('home.stat_listed') }}
          </p>
          <p class="inline-flex gap-2 items-center text-[13px]" style="color: var(--ink-soft)">
            <span class="inline-flex justify-center items-center w-7 h-7 rounded-[9px]" style="background: var(--mint); color: var(--mint-ink)"><i class="w-3.5 h-3.5 i-hugeicons-flash"></i></span>
            <strong class="text-[20px] font-semibold" style="color: var(--ink)">{{ openNow.length }}</strong>
            {{ t('home.stat_open') }}
          </p>
          <p class="inline-flex gap-2 items-center text-[13px]" style="color: var(--ink-soft)">
            <span class="inline-flex justify-center items-center w-7 h-7 rounded-[9px]" style="background: var(--accent-soft); color: var(--accent)"><i class="w-3.5 h-3.5 i-hugeicons-delivery-truck-01"></i></span>
            <strong class="text-[20px] font-semibold" style="color: var(--ink)">{{ partners.length }}</strong>
            {{ t('home.stat_orders') }}
          </p>
        </div>
      </section>

      {{-- Categories, as a row of tiles rather than a row of words. An icon per
        category is the cheapest way to find "coffee" without reading, and each
        one is a link into /discover already filtered. --}}
      <section class="pb-14">
        <h2 class="rail-head text-[20px]"><i class="i-hugeicons-dish-01"></i>{{ t('home.browse_lead') }} <span>{{ t('home.browse_rest') }}</span></h2>

        <div class="grid grid-cols-2 gap-3 mt-5 sm:grid-cols-3 lg:grid-cols-6">
          @foreach (categories as category)
            <a
              href="/discover?type={{ category.type }}"
              class="flex flex-col gap-2 items-center px-3 py-5 rounded-[1.25rem] transition-all duration-500 hover:-translate-y-0.5"
              style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04)"
            >
              <i class="w-6 h-6 i-hugeicons-{{ category.icon }}"></i>
              <span class="text-[13px] font-medium">{{ category.label }}</span>
              <span class="text-[11px]" style="color: var(--ink-soft)">{{ category.count }}</span>
            </a>
          @endforeach
        </div>
      </section>

      {{-- Open now. The one row that is different every time you load it, so
        it goes first. --}}
      <section class="pb-14">
        <div class="flex flex-wrap gap-4 justify-between items-baseline pb-5">
          <h2 class="rail-head text-[20px]"><i class="i-hugeicons-flash"></i>{{ t('home.open_lead') }} <span>{{ t('home.open_rest') }}</span></h2>
          <a href="/discover" class="text-[13px] underline underline-offset-4" style="color: var(--ink-soft)">{{ seeAllLabel }}</a>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          @foreach (openCards as place)
            <a
              href="/places/{{ place.slug }}"
              class="reveal group overflow-hidden block rounded-[1.25rem] transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1"
              style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 18px 36px -20px rgba(20,17,15,0.14)"
            >
              <div class="cover flex justify-center items-center aspect-[16/10]" data-blur="{{ place.photoBlur }}" style="--h: {{ place.hue }}; --h2: {{ place.hueEnd }}">
                <i class="cover-mark w-9 h-9 i-hugeicons-{{ place.icon }}"></i>
                <img class="cover-photo" src="{{ place.photo }}" srcset="{{ place.photoSrcset }}" sizes="(min-width: 1280px) 25vw, (min-width: 640px) 45vw, 92vw" alt="" loading="lazy" decoding="async" width="800" height="560">
                <span class="cover-scrim"></span>
                <span class="absolute top-3 left-3 inline-flex gap-1.5 items-center px-2.5 py-1 text-[11px] font-medium rounded-full backdrop-blur-sm" style="background: rgba(255,255,255,0.92); color: #14713f">
                  <span class="w-1.5 h-1.5 rounded-full" style="background: #14713f"></span>
                  {{ t('business.open') }}
                </span>
              </div>

              <div class="p-4">
                <div class="flex gap-3 justify-between items-start">
                  <h3 class="text-[16px] font-semibold leading-snug tracking-[-0.01em]">{{ place.name }}</h3>
                  <span class="rating-chip flex-none">
                    <i class="w-3 h-3 i-hugeicons-star"></i>
                    {{ place.ratingAverage }}
                  </span>
                </div>
                <div class="meta-row mt-2">
                  <span class="truncate"><i class="i-hugeicons-restaurant-01"></i>{{ place.cuisine || place.type }}</span>
                  <span><i class="i-hugeicons-location-01"></i>{{ place.city }}</span>
                </div>
              </div>
            </a>
          @endforeach
        </div>
      </section>

      {{-- Taking orders. The only places on the site you can actually buy from,
        which is worth saying plainly rather than leaving people to discover it
        one listing at a time. --}}
      <section class="pb-14">
        <div class="flex flex-wrap gap-4 justify-between items-baseline pb-5">
          <h2 class="rail-head text-[20px]"><i class="i-hugeicons-delivery-truck-01"></i>{{ t('home.orders_lead') }} <span>{{ t('home.orders_rest') }}</span></h2>
          <a href="/discover" class="text-[13px] underline underline-offset-4" style="color: var(--ink-soft)">{{ t('home.browse_everything') }}</a>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          @foreach (partnerCards as place)
            <a
              href="/places/{{ place.slug }}"
              class="reveal group overflow-hidden block rounded-[1.25rem] transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1"
              style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 18px 36px -20px rgba(20,17,15,0.14)"
            >
              <div class="cover flex justify-center items-center aspect-[16/10]" data-blur="{{ place.photoBlur }}" style="--h: {{ place.hue }}; --h2: {{ place.hueEnd }}">
                <i class="cover-mark w-9 h-9 i-hugeicons-{{ place.icon }}"></i>
                <img class="cover-photo" src="{{ place.photo }}" srcset="{{ place.photoSrcset }}" sizes="(min-width: 1280px) 25vw, (min-width: 640px) 45vw, 92vw" alt="" loading="lazy" decoding="async" width="800" height="560">
                <span class="cover-scrim"></span>
                <span class="absolute top-3 right-3 inline-flex gap-1 items-center px-2.5 py-1 text-[11px] font-medium rounded-full" style="background: var(--accent); color: #fff">
                  <i class="w-3 h-3 i-hugeicons-delivery-truck-01"></i>
                  {{ t('nav.orders') }}
                </span>
              </div>

              <div class="p-4">
                <div class="flex gap-3 justify-between items-start">
                  <h3 class="text-[16px] font-semibold leading-snug tracking-[-0.01em]">{{ place.name }}</h3>
                  @if (place.ratingCount > 0)
                    <span class="rating-chip flex-none">
                      <i class="w-3 h-3 i-hugeicons-star"></i>
                      {{ place.ratingAverage }}
                    </span>
                  @endif
                </div>
                <div class="meta-row mt-2">
                  <span class="truncate"><i class="i-hugeicons-restaurant-01"></i>{{ place.cuisine || place.type }}</span>
                  <span><i class="i-hugeicons-location-01"></i>{{ place.city }}</span>
                </div>
              </div>
            </a>
          @endforeach
        </div>
      </section>

      {{-- The farms, which are the part of this site nobody expects and the
        part that is least like every other food directory. They are real
        growers an hour outside the city, so the row says so rather than
        pretending they are round the corner. --}}
      @if (farmCards.length > 0)
      <section class="pb-14">
        <div class="overflow-hidden p-6 rounded-[2rem] sm:p-10" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 18px 36px -28px rgba(20,17,15,0.16)">
          <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:items-center">
            <div>
              <h2 class="rail-head text-[clamp(1.35rem,3vw,1.75rem)]"><i class="i-hugeicons-leaf-01"></i>{{ t('home.farms_lead') }} <span>{{ t('home.farms_rest') }}</span></h2>
              <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--ink-soft)">
                {{ t('home.farms_body') }}
              </p>
              <a href="/discover?type=farm" class="inline-flex gap-2 items-center px-5 py-3 mt-6 text-[14px] font-medium rounded-full transition-all duration-500 hover:-translate-y-px" style="background: var(--ink); color: var(--paper)">
                <i class="w-4 h-4 i-hugeicons-plant-01"></i>
                {{ t('home.farms_cta') }}
              </a>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              @foreach (farmCards as place)
                <a href="/places/{{ place.slug }}" class="group overflow-hidden block rounded-[1rem] transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1" style="background: var(--paper)">
                  <div class="cover flex justify-center items-center aspect-[4/3]" data-blur="{{ place.photoBlur }}" style="--h: {{ place.hue }}; --h2: {{ place.hueEnd }}">
                    <i class="cover-mark w-7 h-7 i-hugeicons-{{ place.icon }}"></i>
                    <img class="cover-photo" src="{{ place.photo }}" srcset="{{ place.photoSrcset }}" sizes="(min-width: 1280px) 25vw, (min-width: 640px) 45vw, 92vw" alt="" loading="lazy" decoding="async" width="800" height="560">
                    <span class="cover-scrim"></span>
                  </div>
                  <div class="p-3">
                    <h3 class="text-[14px] font-semibold leading-snug truncate">{{ place.name }}</h3>
                    <p class="mt-0.5 text-[12px] truncate" style="color: var(--ink-soft)">{{ place.city }}</p>
                  </div>
                </a>
              @endforeach
            </div>
          </div>
        </div>
      </section>

      @endif

      {{-- What you can actually do here, in three lines. Last, because it is
        the part somebody reads only if the rows above have not already
        answered it. --}}
      <section class="pb-16">
        <h2 class="rail-head text-[20px]"><i class="i-hugeicons-help-circle"></i>{{ t('home.how_lead') }} <span>{{ t('home.how_rest') }}</span></h2>

        <div class="grid grid-cols-1 gap-5 mt-5 sm:grid-cols-3">
          <div class="p-6 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04)">
            <span class="inline-flex justify-center items-center w-10 h-10 rounded-[14px]" style="background: var(--accent-soft); color: var(--accent)">
              <i class="w-5 h-5 i-hugeicons-search-01"></i>
            </span>
            <h3 class="mt-4 text-[16px] font-semibold">{{ t('home.how_find_title') }}</h3>
            <p class="mt-2 text-[14px] leading-relaxed" style="color: var(--ink-soft)">
              {{ t('home.how_find_body') }}
            </p>
          </div>

          <div class="p-6 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04)">
            <span class="inline-flex justify-center items-center w-10 h-10 rounded-[14px]" style="background: var(--mint); color: var(--mint-ink)">
              <i class="w-5 h-5 i-hugeicons-star"></i>
            </span>
            <h3 class="mt-4 text-[16px] font-semibold">{{ t('home.how_reviews_title') }}</h3>
            <p class="mt-2 text-[14px] leading-relaxed" style="color: var(--ink-soft)">
              {{ t('home.how_reviews_body') }}
            </p>
          </div>

          <div class="p-6 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04)">
            <span class="inline-flex justify-center items-center w-10 h-10 rounded-[14px]" style="background: var(--accent-soft); color: var(--accent)">
              <i class="w-5 h-5 i-hugeicons-delivery-truck-01"></i>
            </span>
            <h3 class="mt-4 text-[16px] font-semibold">{{ t('home.how_order_title') }}</h3>
            <p class="mt-2 text-[14px] leading-relaxed" style="color: var(--ink-soft)">
              {{ howOrderBody }}
            </p>
          </div>
        </div>
      </section>

      {{-- The one thing this site asks for.

        Placed at the bottom rather than as a bar over the results, because a
        directory that interrupts you to collect an address before you have
        found anything is asking for a favour it has not earned yet. Somebody
        who has scrolled the whole list is somebody it might be useful to.

        It asks for an address and nothing else. A name field would be a
        second thing to type for a message nobody signs. --}}
      <section class="pb-24 sm:pb-32">
        <div class="overflow-hidden relative px-6 py-12 rounded-[2rem] sm:px-12 sm:py-16" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 24px 48px -28px rgba(20,17,15,0.18)">
          <span class="absolute -top-24 -right-16 w-72 h-72 rounded-full pointer-events-none" style="background: var(--accent-soft); filter: blur(60px)"></span>

          <div class="relative max-w-xl">
            <h2 class="text-[clamp(1.6rem,3.4vw,2.25rem)] font-semibold leading-[1.1] tracking-[-0.03em] text-balance">
              {{ t('home.subscribe_title') }}
            </h2>

            <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--ink-soft)">
              {{ subscribeBody }}
            </p>

            <div :if="!subscribed()" class="flex flex-col gap-2 mt-7 sm:flex-row">
              <label class="flex relative flex-1 items-center">
                <i class="absolute left-5 w-4 h-4 i-hugeicons-mail-01" style="color: var(--ink-soft)"></i>
                <span class="sr-only">{{ t('home.subscribe_label') }}</span>
                <input
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  placeholder="you@example.com"
                  maxlength="200"
                  :value="subscribeEmail()"
                  @input="subscribeEmail.set($event.target.value)"
                  @keydown="$event.key === 'Enter' && sendSubscribe()"
                  class="py-3.5 pr-5 pl-12 w-full text-[15px] rounded-full outline-none transition-shadow duration-500 focus:shadow-[0_0_0_3px_var(--accent-soft)]"
                  style="background: var(--paper); border: 1px solid var(--line)"
                >
              </label>

              <button
                type="button"
                @click="sendSubscribe()"
                :disabled="subscribeBusy()"
                class="px-7 py-3.5 text-[15px] font-medium whitespace-nowrap rounded-full transition-all duration-500 hover:-translate-y-px active:scale-[0.99] disabled:opacity-60"
                style="background: var(--ink); color: var(--paper)"
              >
                {{ subscribeBusy() ? subscribeBusyLabel() : subscribeLabel() }}
              </button>
            </div>

            {{-- Replaces the form rather than sitting under it, so there is no
              second chance to submit an address that is already taken. --}}
            <p :if="subscribed()" class="inline-flex gap-2 items-center px-4 py-3 mt-7 text-[15px] rounded-full" style="background: var(--accent-soft); color: var(--accent)">
              <i class="w-4 h-4 i-hugeicons-checkmark-circle-02"></i>
              {{ t('home.subscribe_done') }}
            </p>

            <p :if="subscribeError()" class="mt-3 text-[13px]" style="color: var(--accent)">{{ subscribeError() }}</p>

            <p class="mt-4 text-[12px]" style="color: var(--ink-soft)">
              {{ t('home.subscribe_note') }}
            </p>
          </div>
        </div>
      </section>
    </main>
    @include('footer')

    <script client>
      import { send } from '../functions/session'

      /*
       * The signup at the foot of the page, and nothing else.
       *
       * The search, the filters and the map all moved to /discover with the
       * surface they belong to, so this page has one interactive thing on it.
       * Everything above is server-rendered and needs no signal at all.
       */
      const subscribeEmail = state('')
      const subscribeBusy = state(false)
      const subscribeError = state('')
      const subscribed = state(false)

      /*
       * The strings this script writes, in the language the server served.
       *
       * Held as signals rather than as plain constants because a template
       * binding reads signals, and the button label has to change when
       * `subscribeBusy` does. The English text is passed as the fallback, so a
       * key the head partial has not been told about renders in English rather
       * than as its own name. See partials/head.stx.
       */
      const say = (key, english) => (window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, english) : english)
      const subscribeLabel = state(say('home.subscribe_button', 'Keep me posted'))
      const subscribeBusyLabel = state(say('home.subscribe_busy', 'One moment…'))

      async function sendSubscribe() {
        const address = subscribeEmail().trim()

        /* A shape check before the request, so the obvious typo is caught
           without a round trip. Deliberately not the same check the server
           does - that one is authoritative and this is a courtesy, and a
           client trying to match it exactly would drift out of step and start
           rejecting addresses the server would have taken. */
        if (!/^[^\s@]+@[^\s@.]+\.[^\s@]+$/.test(address)) {
          subscribeError.set(say('home.subscribe_bad_email', 'That does not look like an email address.'))
          return
        }

        subscribeBusy.set(true)
        subscribeError.set('')

        const answer = await send('/api/subscribe', { email: address, source: 'home' }).catch(() => null)

        subscribeBusy.set(false)

        if (!answer || !answer.ok) {
          subscribeError.set(say('home.subscribe_failed', 'That did not send. Try again in a moment.'))
          return
        }

        subscribed.set(true)
      }
    </script>
  </body>
</html>
