<script server>
/*
 * Discover: the browse page.
 *
 * Everything is rendered server-side from the same `searchBusinesses` the API
 * uses, so the page is complete before any script runs and the map is an
 * enhancement rather than a dependency. Someone on a slow connection still gets
 * the whole list; the pins arrive when they arrive.
 */
import { formatDistance } from '../../app/Actions/Business/geo'
import { searchBusinesses } from '../../app/Actions/Business/search'

// Named rather than pluralised by rule: "Coffee" reads better than "Cafes",
// and appending an s produces "Bakerys".
function typeLabel(type: string): string {
  if (type === 'restaurant')
    return 'Restaurants'
  if (type === 'cafe')
    return 'Coffee'
  if (type === 'farm')
    return 'Farms'
  if (type === 'bakery')
    return 'Bakeries'
  if (type === 'grocery')
    return 'Grocers'
  if (type === 'bar')
    return 'Bars'

  return `${type.charAt(0).toUpperCase()}${type.slice(1)}`
}

const pageTitle = 'Smakelo - find the good places near you'
const pageDescription = 'Discovery, ordering and delivery for restaurants, coffee shops and farms in Los Angeles. A demonstration.'
const canonicalPath = '/'

// Santa Monica, where the seeded data is densest.
const CENTRE = { latitude: 34.0195, longitude: -118.4912 }

// Wide enough to include the farms. They are real growers in Ojai, Moorpark
// and Tehachapi rather than anything in the city, so a tidy city-sized radius
// would drop the entire farm side of the app off its own home page. Distance is
// shown per card, so a box coming from an hour away says so.
/*
 * One query, sliced two ways.
 *
 * A second top-level `await` in this file stops `<script server>` reaching the
 * template at all: every variable comes through undefined and the page renders
 * its full layout around empty values, in the dev server and in the build
 * alike. So the count and the cards come from one call rather than two.
 */
const everything = await searchBusinesses({
  latitude: CENTRE.latitude,
  longitude: CENTRE.longitude,
  radiusMeters: 200000,
  sort: 'distance',
  limit: 400,
})

const total = everything.length

/*
 * The page renders the sixty nearest. Shipping all of them would be a megabyte
 * of HTML for a list nobody scrolls to the end of; the search box covers the
 * rest by asking the server, so nothing is unreachable.
 */
const results = everything.slice(0, 60)

const partners = results.filter(business => business.isPartner)

/*
 * The type filter is built from what is actually here rather than a hand-kept
 * list. The seed has bakeries, bars and grocers alongside the restaurants,
 * cafes and farms, and a hardcoded row of three would have quietly stranded
 * them: visible under "All" and reachable by no filter.
 *
 * Written as a plain loop on purpose. The first version built this with a Map,
 * spread-of-entries and destructured arrow parameters, and every @foreach on
 * the page then reported its array "is not iterable" - including `results`,
 * which this code does not touch. The page rendered its whole layout around an
 * empty grid, in the dev server and in the build alike. The same snippet in
 * isolation is fine, so the trigger is something about this file rather than
 * the constructs themselves; until that is understood, boring code here costs
 * nothing.
 */
const types = []

for (const business of results) {
  const seen = types.find(entry => entry.type === business.type)

  if (seen)
    seen.count = seen.count + 1
  else
    types.push({ type: business.type, count: 1, label: typeLabel(business.type) })
}

types.sort((a, b) => b.count - a.count)

// The map needs coordinates and a label per pin and nothing else, so it gets
// exactly that. Serialised here so the client script never queries.
const pins = JSON.stringify(results.map(business => ({
  name: business.name,
  slug: business.slug,
  lat: business.latitude,
  lng: business.longitude,
  partner: business.isPartner,
  type: business.type,
})))

const mapCentre = JSON.stringify(CENTRE)

function priceLabel(tier) {
  return '$'.repeat(Math.max(1, Math.min(4, Number(tier) || 2)))
}

function openLabel(business) {
  if (business.openState === 'unknown')
    return 'Hours unknown'

  if (business.openState === 'closed') {
    if (typeof business.opensInMinutes === 'number' && business.opensInMinutes < 180)
      return `Opens in ${business.opensInMinutes} min`

    return 'Closed'
  }

  if (typeof business.closesInMinutes === 'number' && business.closesInMinutes < 60)
    return `Closing in ${business.closesInMinutes} min`

  return 'Open now'
}
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-7xl">
      {{-- Editorial split: the sentence on the left, live counts on the right.
        The numbers come from the same query that fills the list below, so the
        headline cannot claim something the page contradicts. --}}
      <section class="grid grid-cols-1 gap-12 items-end pt-16 pb-14 lg:grid-cols-12 sm:pt-24">
        <div class="lg:col-span-7">
          <span class="inline-block px-3 py-1 text-[10px] font-medium tracking-[0.2em] uppercase rounded-full" style="background: var(--accent-soft); color: var(--accent)">
            Los Angeles
          </span>

          <h1 class="mt-6 text-[clamp(2.5rem,5.4vw,4rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-balance">
            Find the good places near you.
          </h1>

          <p class="mt-6 max-w-xl text-[17px] leading-relaxed" style="color: var(--ink-soft)">
            Restaurants, coffee shops and farms across Santa Monica, Venice and the city.
            Read what people said, then order from the ones that deliver.
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="p-2 rounded-[2rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 24px 48px -24px rgba(20,17,15,0.16)">
            <div class="grid grid-cols-3 rounded-[calc(2rem-0.5rem)] overflow-hidden">
              <div class="px-5 py-7">
                <p class="text-[32px] font-semibold tracking-[-0.03em] leading-none">{{ total }}</p>
                <p class="mt-2 text-[12px]" style="color: var(--ink-soft)">places</p>
              </div>
              <div class="px-5 py-7 border-x" style="border-color: var(--line)">
                <p class="text-[32px] font-semibold tracking-[-0.03em] leading-none">{{ openNow.length }}</p>
                <p class="mt-2 text-[12px]" style="color: var(--ink-soft)">open now</p>
              </div>
              <div class="px-5 py-7">
                <p class="text-[32px] font-semibold tracking-[-0.03em] leading-none">{{ partners.length }}</p>
                <p class="mt-2 text-[12px]" style="color: var(--ink-soft)">take orders</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {{-- A pin per result, and a popup that links through. The map sits above
        the list rather than beside it so the phone layout is the same layout. --}}
      <section class="pb-14">
        <div class="p-2 rounded-[2rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 24px 48px -24px rgba(20,17,15,0.16)">
          <div id="discover-map" data-pins="{{ pins }}" data-centre="{{ mapCentre }}" class="h-[380px] sm:h-[460px] w-full rounded-[calc(2rem-0.5rem)] overflow-hidden" style="background: var(--paper)"></div>
        </div>
        <p class="mt-3 text-[11px]" style="color: var(--ink-soft)">
          Map data and tiles from OpenStreetMap contributors.
        </p>
      </section>

      <section class="pb-24 sm:pb-40">
        <div class="flex flex-wrap gap-4 justify-between items-baseline pb-6">
          <h2 data-i18n="search.nearby" class="text-[28px] font-semibold tracking-[-0.03em]">Nearby</h2>
          <p id="result-count" class="text-[13px]" style="color: var(--ink-soft)">Sorted by distance from Santa Monica</p>
        </div>

        {{-- The whole list is already on the page, so filtering it is a matter
          of hiding cards rather than asking the server again. That keeps the
          controls instant, and it keeps the page honest with JavaScript off:
          no filter bar appears, and all of the results are there. --}}
        <div id="filters" data-total="{{ total }}" hidden class="p-1.5 mb-8 rounded-[1.5rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
          <div class="flex flex-wrap gap-3 items-center p-4 rounded-[calc(1.5rem-0.375rem)]">
            <label class="relative flex-1 min-w-[220px]">
              <i class="absolute left-4 top-1/2 w-4 h-4 -translate-y-1/2 i-hugeicons-search-01" style="color: var(--ink-soft)"></i>
              <input id="filter-q" type="search" data-i18n-placeholder="search.placeholder" placeholder="Name, cuisine, neighbourhood"
                class="py-3 pr-4 pl-11 w-full text-[15px] rounded-full" style="background: var(--paper); border: 1px solid var(--line)">
            </label>

            {{-- Scrolls sideways rather than wrapping: a rounded pill group that
              wraps onto three rows on a phone reads as a blob, and the row is
              short enough that a nudge reaches the end of it. --}}
            <div class="flex overflow-x-auto gap-1 p-1 rounded-full" style="background: var(--paper); scrollbar-width: none" id="filter-type">
              <button type="button" data-type="" data-i18n="search.all_types" class="px-4 py-2 text-[13px] font-medium rounded-full shrink-0 transition-all duration-500">All</button>
              @foreach (types as entry)
                <button type="button" data-type="{{ entry.type }}" class="px-4 py-2 text-[13px] rounded-full shrink-0 transition-all duration-500">{{ entry.label }}</button>
              @endforeach
            </div>

            <button type="button" id="filter-open" data-i18n="search.open_now" class="px-4 py-2 text-[13px] rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">Open now</button>
            <button type="button" id="filter-orders" data-i18n="search.takes_orders" class="px-4 py-2 text-[13px] rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">Takes orders</button>

            <select id="filter-sort" class="px-4 py-2.5 text-[13px] rounded-full" style="background: var(--paper); border: 1px solid var(--line)">
              <option value="distance" data-i18n="search.sort_distance">Nearest</option>
              <option value="rating" data-i18n="search.sort_rating">Best rated</option>
              <option value="name" data-i18n="search.sort_name">A to Z</option>
            </select>
          </div>
        </div>

        <p id="no-results" data-i18n="search.no_results" hidden class="py-12 text-center text-[15px]" style="color: var(--ink-soft)">
          Nothing matches that. Try fewer words.
        </p>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          @foreach (results as business)
            <a
              href="/places/{{ business.slug }}"
              data-card
              data-slug="{{ business.slug }}"
              data-haystack="{{ business.name }} {{ business.cuisine }} {{ business.city }} {{ business.description }}"
              data-type="{{ business.type }}"
              data-open="{{ business.openState }}"
              data-partner="{{ business.isPartner ? '1' : '0' }}"
              data-rating="{{ business.ratingAverage }}"
              data-distance="{{ business.distanceMeters }}"
              data-name="{{ business.name }}"
              class="reveal group block p-1.5 rounded-[1.75rem] transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1"
              style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 18px 36px -20px rgba(20,17,15,0.14)"
            >
              <div class="flex flex-col p-6 h-full rounded-[calc(1.75rem-0.375rem)]">
                <div class="flex gap-3 justify-between items-start">
                  <h3 class="text-[17px] font-semibold leading-snug tracking-[-0.01em]">{{ business.name }}</h3>
                  @if (business.ratingCount > 0)
                    <span class="inline-flex gap-1 items-center shrink-0 text-[13px] font-medium">
                      <i class="w-3.5 h-3.5 i-hugeicons-star" style="color: var(--accent)"></i>
                      {{ business.ratingAverage }}
                    </span>
                  @endif
                </div>

                <p class="mt-2 text-[13px]" style="color: var(--ink-soft)">
                  {{ business.cuisine }} · {{ priceLabel(business.priceTier) }}
                </p>

                <p class="mt-3 text-[14px] leading-relaxed" style="color: var(--ink-soft)">
                  {{ business.description }}
                </p>

                <div class="flex flex-wrap gap-2 items-center pt-5 mt-auto">
                  @if (business.distanceMeters !== null)
                    <span class="px-2.5 py-1 text-[11px] rounded-full" style="background: var(--accent-soft); color: var(--accent)">
                      {{ formatDistance(business.distanceMeters) }}
                    </span>
                  @endif

                  <span class="px-2.5 py-1 text-[11px] rounded-full" style="border: 1px solid var(--line); color: var(--ink-soft)">
                    {{ openLabel(business) }}
                  </span>

                  @if (business.isPartner)
                    <span class="px-2.5 py-1 text-[11px] rounded-full" style="border: 1px solid var(--line); color: var(--ink-soft)">
                      Orders
                    </span>
                  @endif
                </div>
              </div>
            </a>
          @endforeach
        </div>
      </section>
    </main>

    <footer class="border-t" style="border-color: var(--line)">
      <div class="mx-auto px-4 sm:px-8 py-12 max-w-7xl text-[13px]" style="color: var(--ink-soft)">
        <p>
          Smakelo is a demonstration built on <a href="https://github.com/stacksjs/stacks" class="underline underline-offset-4">Stacks</a>.
          Listings from OpenStreetMap and Foursquare Open Source Places. Everything else is invented.
        </p>
      </div>
    </footer>

    <script client>
      import { Marker, tileLayer, TsMap } from 'ts-maps'
      import 'ts-maps/styles.css'

      // Card entrance animation lives in CSS (`.reveal`, a scroll-driven
      // animation). Nothing about whether the page is readable depends on this
      // script, which leaves it with exactly one job: the map.
      // Read off the element rather than interpolated into this script: a raw
      // echo inside <script client> is not processed by the views build, so the
      // page compiles in the dev server and fails the build.
      const el = document.getElementById('discover-map')

      // Kept so the filter below can hide the pins for cards it has hidden.
      const markers = new Map()

      /*
       * Read outside the map block: the search below needs the centre too, and
       * having it scoped to the map meant every server-side search threw a
       * ReferenceError into a promise nobody was awaiting. The page kept
       * working and simply found nothing beyond the sixty already on it.
       */
      const centre = el ? JSON.parse(el.dataset.centre || '{}') : { latitude: 34.0195, longitude: -118.4912 }

      if (el) {
        const pins = JSON.parse(el.dataset.pins || '[]')

        const map = new TsMap(el, { center: [centre.latitude, centre.longitude], zoom: 12 })

        tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap contributors',
          maxZoom: 19,
        }).addTo(map)

        for (const pin of pins) {
          const marker = new Marker([pin.lat, pin.lng]).addTo(map)

          // A partner can take an order; a listing can only be read about, and
          // the popup should not pretend otherwise.
          marker.bindPopup(
            `<strong>${pin.name}</strong><br>`
            + `<span style="opacity:.7">${pin.type}</span><br>`
            + `<a href="/places/${pin.slug}">${pin.partner ? 'Order or read reviews' : 'Read reviews'}</a>`,
          )

          markers.set(pin.slug, marker)
        }
      }

      /*
       * Filtering.
       *
       * Every result is already in the page, so this hides cards rather than
       * asking the server again: no round trip, no spinner, and no second
       * definition of what "open now" means to drift from the server's. The
       * controls are hidden until this runs, so a reader with no JavaScript
       * sees the full list and no dead widgets.
       */
      const grid = document.querySelector('[data-card]')?.parentElement
      const cards = Array.from(document.querySelectorAll('[data-card]'))
      const panel = document.getElementById('filters')

      if (panel && grid && cards.length > 0) {
        panel.hidden = false

        const query = document.getElementById('filter-q')
        const sort = document.getElementById('filter-sort')
        const openOnly = document.getElementById('filter-open')
        const ordersOnly = document.getElementById('filter-orders')
        const typeRow = document.getElementById('filter-type')
        const count = document.getElementById('result-count')
        const empty = document.getElementById('no-results')

        const state = { q: '', type: '', open: false, orders: false, sort: 'distance' }

        const paintToggle = (button, on) => {
          button.style.background = on ? 'var(--accent-soft)' : 'transparent'
          button.style.color = on ? 'var(--accent)' : 'var(--ink-soft)'
          button.style.border = on ? '1px solid transparent' : '1px solid var(--line)'
        }

        const paintTypes = () => {
          typeRow.querySelectorAll('[data-type]').forEach((button) => {
            const on = button.dataset.type === state.type
            button.style.background = on ? 'var(--ink)' : 'transparent'
            button.style.color = on ? 'var(--paper)' : 'var(--ink-soft)'
            button.style.fontWeight = on ? '500' : '400'
          })
        }

        const matches = (card) => {
          if (state.type && card.dataset.type !== state.type)
            return false

          if (state.open && card.dataset.open !== 'open')
            return false

          if (state.orders && card.dataset.partner !== '1')
            return false

          if (!state.q)
            return true

          // Every word has to appear somewhere, so "venice coffee" narrows
          // rather than widening the way an any-word match would.
          const haystack = card.dataset.haystack.toLowerCase()

          return state.q.toLowerCase().split(/\s+/).filter(Boolean).every(word => haystack.includes(word))
        }

        const apply = () => {
          const showing = []

          for (const card of cards) {
            const on = matches(card)
            card.hidden = !on

            if (on)
              showing.push(card)
          }

          showing.sort((a, b) => {
            if (state.sort === 'rating')
              return Number(b.dataset.rating) - Number(a.dataset.rating)

            if (state.sort === 'name')
              return a.dataset.name.localeCompare(b.dataset.name)

            // A card with no distance sorts last rather than first, which is
            // what Number('') would do.
            return (Number(a.dataset.distance) || Infinity) - (Number(b.dataset.distance) || Infinity)
          })

          // Re-appending in order is enough to reorder a grid, and it keeps the
          // cards themselves untouched.
          showing.forEach(card => grid.append(card))

          // Cards built here rather than server-side, because these places were
          // not on the page when it was built. The markup is kept close to the
          // rendered card so the two do not visibly diverge.
          for (const stale of grid.querySelectorAll('[data-remote]'))
            stale.remove()

          for (const business of remote)
            grid.insertAdjacentHTML('beforeend', remoteCard(business))

          empty.hidden = showing.length + remote.length > 0

          // Written by script, so it asks the dictionary directly rather than
          // carrying a data-i18n key that nothing would re-apply.
          const say = (key, fallback) => (window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, fallback) : fallback)

          const found = showing.length + remote.length

          const sortLabel = {
            distance: say('search.sort_distance', 'Nearest'),
            rating: say('search.sort_rating', 'Best rated'),
            name: say('search.sort_name', 'A to Z'),
          }[state.sort]

          count.textContent = state.q.trim().length >= 3
            ? `${found} found · ${sortLabel}`
            : `${showing.length} / ${panel.dataset.total} · ${sortLabel}`

          // The map should agree with the list it sits above.
          if (markers.size > 0) {
            const visible = new Set(showing.map(card => card.dataset.slug))

            for (const [slug, marker] of markers) {
              const element = marker.getElement?.()

              if (element)
                element.style.display = visible.has(slug) ? '' : 'none'
            }
          }
        }

        /*
         * Typing searches everything, not just what is on the page.
         *
         * The page ships the sixty nearest; the other two hundred are reachable
         * because a query goes to the server, which searches the lot. Filtering
         * only what happened to be rendered would mean a search box that
         * quietly cannot find most of the places it claims to list.
         *
         * Short queries stay local: one or two letters match half the city, and
         * a request per keystroke to learn that is waste.
         */
        let pending = null
        let remote = []

        const runSearch = async () => {
          const term = state.q.trim()

          if (term.length < 3) {
            remote = []
            apply()
            return
          }

          const params = new URLSearchParams({ q: term, limit: '60', lat: String(centre.latitude), lng: String(centre.longitude), radius: '200000' })
          const response = await fetch(`/api/businesses?${params}`).catch(() => null)

          if (!response || !response.ok)
            return

          const { data } = await response.json()

          // Only the ones this page does not already have. The rendered cards
          // carry live state (saved, distance) that a freshly built card would
          // not, so they win where both exist.
          const have = new Set(cards.map(card => card.dataset.slug))
          remote = data.filter(business => !have.has(business.slug))

          apply()
        }

        query.addEventListener('input', () => {
          state.q = query.value
          apply()

          clearTimeout(pending)
          pending = setTimeout(runSearch, 250)
        })

        typeRow.addEventListener('click', (event) => {
          const button = event.target.closest('[data-type]')

          if (!button)
            return

          state.type = button.dataset.type
          paintTypes()
          apply()
        })

        openOnly.addEventListener('click', () => {
          state.open = !state.open
          paintToggle(openOnly, state.open)
          apply()
        })

        ordersOnly.addEventListener('click', () => {
          state.orders = !state.orders
          paintToggle(ordersOnly, state.orders)
          apply()
        })

        sort.addEventListener('change', () => {
          state.sort = sort.value
          apply()
        })

        function remoteCard(business) {
          const escape = value => String(value).replace(/[&<>"']/g, ch => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', '\'': '&#39;',
          }[ch]))

          return `
            <a href="/places/${business.slug}" data-remote
               class="block p-1.5 rounded-[1.75rem] transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1"
               style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 18px 36px -20px rgba(20,17,15,0.14)">
              <div class="flex flex-col p-6 h-full rounded-[calc(1.75rem-0.375rem)]">
                <h3 class="text-[17px] font-semibold leading-snug tracking-[-0.01em]">${escape(business.name)}</h3>
                <p class="mt-2 text-[13px]" style="color: var(--ink-soft)">${escape(business.cuisine || business.type)}</p>
                ${business.description ? `<p class="mt-3 text-[14px] leading-relaxed" style="color: var(--ink-soft)">${escape(business.description)}</p>` : ''}
                <div class="flex flex-wrap gap-2 items-center pt-5 mt-auto">
                  <span class="px-2.5 py-1 text-[11px] rounded-full" style="border: 1px solid var(--line); color: var(--ink-soft)">${escape(business.city)}</span>
                  ${business.isPartner ? '<span class="px-2.5 py-1 text-[11px] rounded-full" style="background: var(--accent-soft); color: var(--accent)">Orders</span>' : ''}
                </div>
              </div>
            </a>`
        }

        paintTypes()
        apply()

        // The dictionary arrives after this runs, so redo the parts that write
        // their own text.
        document.addEventListener('smakelo:locale', apply)
      }
    </script>
  </body>
</html>
