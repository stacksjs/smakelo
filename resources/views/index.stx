<script server>
/*
 * Discover: the browse page.
 *
 * Everything is rendered server-side from the same `searchBusinesses` the API
 * uses, so the page is complete before any script runs and the map is an
 * enhancement rather than a dependency. Someone on a slow connection still gets
 * the whole list; the pins arrive when they arrive.
 */
import { formatDistance } from '../../app/Actions/Business/geo'
import { searchBusinesses } from '../../app/Actions/Business/search'

const pageTitle = 'Smakelo - find the good places near you'
const pageDescription = 'Discovery, ordering and delivery for restaurants, coffee shops and farms in Los Angeles. A demonstration.'
const canonicalPath = '/'

// Santa Monica, where the seeded data is densest.
const CENTRE = { latitude: 34.0195, longitude: -118.4912 }

// Wide enough to include the farms. They are real growers in Ojai, Moorpark
// and Tehachapi rather than anything in the city, so a tidy city-sized radius
// would drop the entire farm side of the app off its own home page. Distance is
// shown per card, so a box coming from an hour away says so.
const results = await searchBusinesses({
  latitude: CENTRE.latitude,
  longitude: CENTRE.longitude,
  radiusMeters: 200000,
  sort: 'distance',
  limit: 60,
})

const partners = results.filter(business => business.isPartner)
const openNow = results.filter(business => business.openState === 'open')

// The map needs coordinates and a label per pin and nothing else, so it gets
// exactly that. Serialised here so the client script never queries.
const pins = JSON.stringify(results.map(business => ({
  name: business.name,
  slug: business.slug,
  lat: business.latitude,
  lng: business.longitude,
  partner: business.isPartner,
  type: business.type,
})))

const mapCentre = JSON.stringify(CENTRE)

function priceLabel(tier) {
  return '$'.repeat(Math.max(1, Math.min(4, Number(tier) || 2)))
}

function openLabel(business) {
  if (business.openState === 'unknown')
    return 'Hours unknown'

  if (business.openState === 'closed') {
    if (typeof business.opensInMinutes === 'number' && business.opensInMinutes < 180)
      return `Opens in ${business.opensInMinutes} min`

    return 'Closed'
  }

  if (typeof business.closesInMinutes === 'number' && business.closesInMinutes < 60)
    return `Closing in ${business.closesInMinutes} min`

  return 'Open now'
}
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-7xl">
      {{-- Editorial split: the sentence on the left, live counts on the right.
        The numbers come from the same query that fills the list below, so the
        headline cannot claim something the page contradicts. --}}
      <section class="grid grid-cols-1 gap-12 items-end pt-16 pb-14 lg:grid-cols-12 sm:pt-24">
        <div class="lg:col-span-7">
          <span class="inline-block px-3 py-1 text-[10px] font-medium tracking-[0.2em] uppercase rounded-full" style="background: var(--accent-soft); color: var(--accent)">
            Los Angeles
          </span>

          <h1 class="mt-6 text-[clamp(2.5rem,5.4vw,4rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-balance">
            Find the good places near you.
          </h1>

          <p class="mt-6 max-w-xl text-[17px] leading-relaxed" style="color: var(--ink-soft)">
            Restaurants, coffee shops and farms across Santa Monica, Venice and the city.
            Read what people said, then order from the ones that deliver.
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="p-2 rounded-[2rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 24px 48px -24px rgba(20,17,15,0.16)">
            <div class="grid grid-cols-3 rounded-[calc(2rem-0.5rem)] overflow-hidden">
              <div class="px-5 py-7">
                <p class="text-[32px] font-semibold tracking-[-0.03em] leading-none">{{ results.length }}</p>
                <p class="mt-2 text-[12px]" style="color: var(--ink-soft)">places</p>
              </div>
              <div class="px-5 py-7 border-x" style="border-color: var(--line)">
                <p class="text-[32px] font-semibold tracking-[-0.03em] leading-none">{{ openNow.length }}</p>
                <p class="mt-2 text-[12px]" style="color: var(--ink-soft)">open now</p>
              </div>
              <div class="px-5 py-7">
                <p class="text-[32px] font-semibold tracking-[-0.03em] leading-none">{{ partners.length }}</p>
                <p class="mt-2 text-[12px]" style="color: var(--ink-soft)">take orders</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {{-- A pin per result, and a popup that links through. The map sits above
        the list rather than beside it so the phone layout is the same layout. --}}
      <section class="pb-14">
        <div class="p-2 rounded-[2rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 24px 48px -24px rgba(20,17,15,0.16)">
          <div id="discover-map" data-pins="{{ pins }}" data-centre="{{ mapCentre }}" class="h-[380px] sm:h-[460px] w-full rounded-[calc(2rem-0.5rem)] overflow-hidden" style="background: var(--paper)"></div>
        </div>
        <p class="mt-3 text-[11px]" style="color: var(--ink-soft)">
          Map data and tiles from OpenStreetMap contributors.
        </p>
      </section>

      <section class="pb-24 sm:pb-40">
        <div class="flex flex-wrap gap-4 justify-between items-baseline pb-8">
          <h2 class="text-[28px] font-semibold tracking-[-0.03em]">Nearby</h2>
          <p class="text-[13px]" style="color: var(--ink-soft)">Sorted by distance from Santa Monica</p>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          @foreach (results as business)
            <a
              href="/places/{{ business.slug }}"
              class="reveal group block p-1.5 rounded-[1.75rem] transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1"
              style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 18px 36px -20px rgba(20,17,15,0.14)"
            >
              <div class="flex flex-col p-6 h-full rounded-[calc(1.75rem-0.375rem)]">
                <div class="flex gap-3 justify-between items-start">
                  <h3 class="text-[17px] font-semibold leading-snug tracking-[-0.01em]">{{ business.name }}</h3>
                  @if (business.ratingCount > 0)
                    <span class="inline-flex gap-1 items-center shrink-0 text-[13px] font-medium">
                      <i class="w-3.5 h-3.5 i-hugeicons-star" style="color: var(--accent)"></i>
                      {{ business.ratingAverage }}
                    </span>
                  @endif
                </div>

                <p class="mt-2 text-[13px]" style="color: var(--ink-soft)">
                  {{ business.cuisine }} · {{ priceLabel(business.priceTier) }}
                </p>

                <p class="mt-3 text-[14px] leading-relaxed" style="color: var(--ink-soft)">
                  {{ business.description }}
                </p>

                <div class="flex flex-wrap gap-2 items-center pt-5 mt-auto">
                  @if (business.distanceMeters !== null)
                    <span class="px-2.5 py-1 text-[11px] rounded-full" style="background: var(--accent-soft); color: var(--accent)">
                      {{ formatDistance(business.distanceMeters) }}
                    </span>
                  @endif

                  <span class="px-2.5 py-1 text-[11px] rounded-full" style="border: 1px solid var(--line); color: var(--ink-soft)">
                    {{ openLabel(business) }}
                  </span>

                  @if (business.isPartner)
                    <span class="px-2.5 py-1 text-[11px] rounded-full" style="border: 1px solid var(--line); color: var(--ink-soft)">
                      Orders
                    </span>
                  @endif
                </div>
              </div>
            </a>
          @endforeach
        </div>
      </section>
    </main>

    <footer class="border-t" style="border-color: var(--line)">
      <div class="mx-auto px-4 sm:px-8 py-12 max-w-7xl text-[13px]" style="color: var(--ink-soft)">
        <p>
          Smakelo is a demonstration built on <a href="https://github.com/stacksjs/stacks" class="underline underline-offset-4">Stacks</a>.
          Listings from OpenStreetMap and Foursquare Open Source Places. Everything else is invented.
        </p>
      </div>
    </footer>

    <script client>
      import { Marker, tileLayer, TsMap } from 'ts-maps'
      import 'ts-maps/styles.css'

      // Card entrance animation lives in CSS (`.reveal`, a scroll-driven
      // animation). Nothing about whether the page is readable depends on this
      // script, which leaves it with exactly one job: the map.
      // Read off the element rather than interpolated into this script: a raw
      // echo inside <script client> is not processed by the views build, so the
      // page compiles in the dev server and fails the build.
      const el = document.getElementById('discover-map')

      if (el) {
        const pins = JSON.parse(el.dataset.pins || '[]')
        const centre = JSON.parse(el.dataset.centre || '{}')

        const map = new TsMap(el, { center: [centre.latitude, centre.longitude], zoom: 12 })

        tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap contributors',
          maxZoom: 19,
        }).addTo(map)

        for (const pin of pins) {
          const marker = new Marker([pin.lat, pin.lng]).addTo(map)

          // A partner can take an order; a listing can only be read about, and
          // the popup should not pretend otherwise.
          marker.bindPopup(
            `<strong>${pin.name}</strong><br>`
            + `<span style="opacity:.7">${pin.type}</span><br>`
            + `<a href="/places/${pin.slug}">${pin.partner ? 'Order or read reviews' : 'Read reviews'}</a>`,
          )
        }
      }
    </script>
  </body>
</html>
