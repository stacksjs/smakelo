<script server>
/*
 * The operator's screen.
 *
 * Two jobs. First, show whether the promises this site makes about itself are
 * actually true right now, checked against the database rather than against
 * the code that is supposed to enforce them. Second, let somebody take a
 * listing down, because the most likely message this demo will ever receive is
 * a restaurant asking why it is here.
 */
const pageTitle = t('meta.admin_title')
const pageDescription = t('meta.admin_description')
const canonicalPath = '/admin'
</script>

<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-4xl" data-stx-content>
      <div class="pt-12 pb-24 sm:pb-40">
        <h1 class="text-[clamp(2rem,4.5vw,3rem)] font-semibold tracking-[-0.035em]">{{ t('admin.title') }}</h1>

        {{-- What this page's own script writes, already translated. --}}
        <div hidden data-i18n-strings="{{ JSON.stringify({
          'admin.all_holding': t('admin.all_holding'),
          'admin.something_wrong': t('admin.something_wrong'),
          'admin.put_back': t('admin.put_back'),
          'admin.take_down': t('admin.take_down'),
        }) }}"></div>

        <p class="mt-3 max-w-xl text-[15px] leading-relaxed" style="color: var(--ink-soft)">
          What this site promises about itself, checked against what is actually
          stored. A guard nobody can see the state of is one you find out about
          afterwards.
        </p>

        <section class="mt-10">
          <div class="flex flex-wrap gap-4 justify-between items-baseline">
            <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('admin.guards') }}</h2>
            <p :if="guards()" class="text-[13px]" :style="allPassed() ? 'color: var(--ink-soft)' : 'color: var(--accent); font-weight: 600'">
              {{ allPassed() ? say('admin.all_holding', 'All holding') : say('admin.something_wrong', 'Something is wrong') }}
            </p>
          </div>

          <p :if="loading()" class="mt-4 text-[15px]" style="color: var(--ink-soft)">{{ t('admin.checking') }}</p>

          <div class="mt-4 space-y-2">
            <div :for="guard in guards()" class="p-1.5 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
              <div class="p-5 rounded-[calc(1.25rem-0.375rem)]">
                <div class="flex gap-4 justify-between items-baseline">
                  <p class="text-[15px] font-medium">{{ guard.name }}</p>
                  <span
                    class="px-2.5 py-1 text-[11px] rounded-full shrink-0"
                    :style="guard.ok ? 'background: var(--accent-soft); color: var(--accent)' : 'background: var(--ink); color: var(--paper)'"
                  >{{ guard.ok ? 'holding' : 'broken' }}</span>
                </div>

                <p class="mt-2 text-[14px] leading-relaxed" style="color: var(--ink-soft)">{{ guard.detail }}</p>
                <p :if="!guard.ok" class="mt-2 text-[13px] leading-relaxed" style="color: var(--accent)">{{ guard.matters }}</p>
              </div>
            </div>
          </div>
        </section>

        <section class="mt-12">
          <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('admin.listings') }}</h2>

          <p class="mt-3 max-w-xl text-[14px] leading-relaxed" style="color: var(--ink-soft)">
            Hiding a listing takes it off the discover page, the search, the map
            and its own page, and stops it being ordered from. The row stays, so
            it can come back if the request turns out to have come from somebody
            who did not run the place after all.
          </p>

          <input
            type="search"
            placeholder="{{ t('admin.find_listing') }}"
            :value="query()"
            @input="onQuery($event.target.value)"
            class="px-4 py-3 mt-5 w-full text-[15px] rounded-full"
            style="background: var(--paper); border: 1px solid var(--line)"
          >

          <p :if="error()" class="mt-3 text-[13px]" style="color: var(--accent)">{{ error() }}</p>

          <div class="mt-5 space-y-2">
            <div :for="row in rows()" class="flex flex-wrap gap-4 items-center p-4 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
              <div class="flex-1 min-w-[200px]" :style="row.hidden ? 'opacity: 0.5' : ''">
                <a :href="'/places/' + row.slug" class="text-[15px] font-medium transition-opacity duration-500 hover:opacity-70">{{ row.name }}</a>
                <p class="mt-0.5 text-[12px]" style="color: var(--ink-soft)">
                  {{ row.city }} · {{ row.type }}{{ row.isPartner ? ' · partner' : '' }}{{ row.isClaimed ? ' · claimed' : '' }}
                </p>
              </div>

              <span :if="row.hidden" class="px-2.5 py-1 text-[11px] rounded-full" style="border: 1px solid var(--line); color: var(--ink-soft)">{{ t('admin.hidden') }}</span>

              <button
                @click="setHidden(row.slug, !row.hidden)"
                class="px-4 py-2 text-[13px] rounded-full transition-all duration-500"
                :style="row.hidden ? 'background: var(--ink); color: var(--paper)' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
              >{{ row.hidden ? say('admin.put_back', 'Put it back') : say('admin.take_down', 'Take it down') }}</button>
            </div>
          </div>
        </section>
      </div>
    </main>

    <script client>
      import { send } from '../functions/session'

      /*
       * The words this script writes, in the language the server served.
       *
       * The English text is the second argument rather than a fallback to the
       * key, so a string no holder carries reads as English rather than as its
       * own name. The page's holder is in the markup above; the shared bundle
       * is in partials/head.stx.
       */
      function say(key, english) {
        return window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, english) : english
      }

      const guards = state([])
      const allPassed = state(true)
      const loading = state(true)
      const rows = state([])
      const query = state('')
      const error = state('')

      let pending = null

      async function loadGuards() {
        const { data } = await (await fetch('/api/admin/guards')).json()

        guards.set(data.results)
        allPassed.set(data.allPassed)
        loading.set(false)
      }

      async function loadListings() {
        const { data } = await (await fetch(`/api/admin/listings?q=${encodeURIComponent(query())}`)).json()

        rows.set(data)
      }

      function onQuery(value) {
        query.set(value)

        clearTimeout(pending)
        pending = setTimeout(loadListings, 250)
      }

      async function setHidden(slug, hidden) {
        const response = await send(`/api/admin/listings/${slug}/${hidden ? 'hide' : 'restore'}`)

        if (!response.ok) {
          error.set((await response.json()).message)
          return
        }

        error.set('')
        loadListings()
      }

      loadGuards()
      loadListings()
    </script>
    @include('footer')
  </body>
</html>
