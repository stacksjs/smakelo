<script server>
/*
 * The operator's screen.
 *
 * Two jobs. First, show whether the promises this site makes about itself are
 * actually true right now, checked against the database rather than against
 * the code that is supposed to enforce them. Second, let somebody take a
 * listing down, because the most likely message this demo will ever receive is
 * a restaurant asking why it is here.
 */
import { currentLocale, t } from '../../app/Actions/Locale/translate'

/*
 * The strings this page's own script writes, already translated.
 *
 * Built here and carried to the markup on a data attribute, the same way the
 * rest of this app hands the client a payload. Written inline in the markup
 * instead, stx sometimes reads it as a client expression and leaves the
 * literal `{{ JSON.stringify(` in the attribute, which is a page whose script
 * silently falls back to English. The shared strings are in partials/head.stx.
 */
const clientStrings = JSON.stringify({
  'guard.payments_name': t('guard.payments_name'),
  'guard.payments_matters': t('guard.payments_matters'),
  'guard.payments_live_key': t('guard.payments_live_key', { count: '{count}' }),
  'guard.payments_test_keys': t('guard.payments_test_keys', { count: '{count}' }),
  'guard.payments_no_provider': t('guard.payments_no_provider', { count: '{count}' }),
  'guard.reviews_name': t('guard.reviews_name'),
  'guard.reviews_matters': t('guard.reviews_matters'),
  'guard.reviews_clean': t('guard.reviews_clean', { count: '{count}' }),
  'guard.reviews_attached': t('guard.reviews_attached', { count: '{count}' }),
  'guard.orders_name': t('guard.orders_name'),
  'guard.orders_matters': t('guard.orders_matters'),
  'guard.orders_clean': t('guard.orders_clean', { count: '{count}' }),
  'guard.orders_placed': t('guard.orders_placed', { count: '{count}' }),
  'guard.contact_name': t('guard.contact_name'),
  'guard.contact_matters': t('guard.contact_matters'),
  'guard.contact_reserved': t('guard.contact_reserved', { count: '{count}' }),
  'guard.contact_reachable': t('guard.contact_reachable', { count: '{count}' }),
  'guard.noindex_name': t('guard.noindex_name'),
  'guard.noindex_matters': t('guard.noindex_matters'),
  'guard.noindex_present': t('guard.noindex_present', { count: '{count}' }),
  'guard.noindex_missing': t('guard.noindex_missing', { count: '{count}' }),
  'guard.robots_name': t('guard.robots_name'),
  'guard.robots_matters': t('guard.robots_matters'),
  'guard.robots_disallows': t('guard.robots_disallows', { count: '{count}' }),
  'guard.robots_missing': t('guard.robots_missing', { count: '{count}' }),
  'guard.holding': t('guard.holding'),
  'guard.broken': t('guard.broken'),
  'admin.all_holding': t('admin.all_holding'),
  'admin.something_wrong': t('admin.something_wrong'),
  'admin.put_back': t('admin.put_back'),
  'admin.take_down': t('admin.take_down'),
})

/* The empty state's own sentence; see partials/operator-empty.stx. */
const operatorNothing = t('operator.not_operations')

const pageTitle = t('meta.admin_title')
const pageDescription = t('meta.admin_description')
const canonicalPath = '/admin'
</script>

<!DOCTYPE html>
<html lang="{{ currentLocale() }}">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-4xl" data-stx-content>
      <div class="pt-12 pb-24 sm:pb-40">
        <h1 class="text-[clamp(2rem,4.5vw,3rem)] font-semibold tracking-[-0.035em]">{{ t('admin.title') }}</h1>

        {{-- What this page's own script writes, already translated. --}}
        <div hidden data-i18n-strings="{{ clientStrings }}"></div>

        <div class="mt-6">
          @include('operator-empty')
        </div>

        <p :if="allowed()" class="mt-3 max-w-xl text-[15px] leading-relaxed" style="color: var(--ink-soft)">
          {{ t('admin.guards_lede') }}
        </p>

        <section :if="allowed()" class="mt-10">
          <div class="flex flex-wrap gap-4 justify-between items-baseline">
            <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('admin.guards') }}</h2>
            <p :if="guards()" class="text-[13px]" :style="allPassed() ? 'color: var(--ink-soft)' : 'color: var(--accent); font-weight: 600'">
              {{ allPassed() ? say('admin.all_holding', 'All holding') : say('admin.something_wrong', 'Something is wrong') }}
            </p>
          </div>

          <p :if="loading()" class="mt-4 text-[15px]" style="color: var(--ink-soft)">{{ t('admin.checking') }}</p>

          <div class="mt-4 space-y-2">
            <div :for="guard in guards()" class="p-1.5 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
              <div class="p-5 rounded-[calc(1.25rem-0.375rem)]">
                <div class="flex gap-4 justify-between items-baseline">
                  <p class="text-[15px] font-medium">{{ guardName(guard) }}</p>
                  <span
                    class="px-2.5 py-1 text-[11px] rounded-full shrink-0"
                    :style="guard.ok ? 'background: var(--accent-soft); color: var(--accent)' : 'background: var(--ink); color: var(--paper)'"
                  >{{ guard.ok ? say('guard.holding', 'holding') : say('guard.broken', 'broken') }}</span>
                </div>

                <p class="mt-2 text-[14px] leading-relaxed" style="color: var(--ink-soft)">{{ guardDetail(guard) }}</p>
                <p :if="!guard.ok" class="mt-2 text-[13px] leading-relaxed" style="color: var(--accent)">{{ guardMatters(guard) }}</p>
              </div>
            </div>
          </div>
        </section>

        <section :if="allowed()" class="mt-12">
          <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('admin.listings') }}</h2>

          <p class="mt-3 max-w-xl text-[14px] leading-relaxed" style="color: var(--ink-soft)">
            {{ t('admin.listings_lede') }}
          </p>

          <input
            type="search"
            placeholder="{{ t('admin.find_listing') }}"
            :value="query()"
            @input="onQuery($event.target.value)"
            class="px-4 py-3 mt-5 w-full text-[15px] rounded-full"
            style="background: var(--paper); border: 1px solid var(--line)"
          >

          <p :if="error()" class="mt-3 text-[13px]" style="color: var(--accent)">{{ error() }}</p>

          <div class="mt-5 space-y-2">
            <div :for="row in rows()" class="flex flex-wrap gap-4 items-center p-4 rounded-[1.25rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
              <div class="flex-1 min-w-[200px]" :style="row.hidden ? 'opacity: 0.5' : ''">
                <a :href="'/places/' + row.slug" class="text-[15px] font-medium transition-opacity duration-500 hover:opacity-70">{{ row.name }}</a>
                <p class="mt-0.5 text-[12px]" style="color: var(--ink-soft)">
                  {{ row.city }} · {{ row.type }}{{ row.isPartner ? ' · partner' : '' }}{{ row.isClaimed ? ' · claimed' : '' }}
                </p>
              </div>

              <span :if="row.hidden" class="px-2.5 py-1 text-[11px] rounded-full" style="border: 1px solid var(--line); color: var(--ink-soft)">{{ t('admin.hidden') }}</span>

              <button
                @click="setHidden(row.slug, !row.hidden)"
                class="px-4 py-2 text-[13px] rounded-full transition-all duration-500"
                :style="row.hidden ? 'background: var(--ink); color: var(--paper)' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
              >{{ row.hidden ? say('admin.put_back', 'Put it back') : say('admin.take_down', 'Take it down') }}</button>
            </div>
          </div>
        </section>
      </div>
    </main>

    <script client>
      import { get, may, me, send } from '../functions/session'

      /*
       * The words this script writes, in the language the server served.
       *
       * The English text is the second argument rather than a fallback to the
       * key, so a string no holder carries reads as English rather than as its
       * own name. The page's holder is in the markup above; the shared bundle
       * is in partials/head.stx.
       */
      function say(key, english) {
        return window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, english) : english
      }

      /*
       * What a guard is called, what it found, and why it matters.
       *
       * The API answers with facts - which check, whether it holds, which of
       * its messages applies and the numbers that message needs - and the
       * words live here, because this screen may be rendering in any of three
       * languages and a process serving JSON has no way to know which.
       */
      function guardName(guard) {
        return say(`guard.${guard.key}_name`, String(guard.key ?? ''))
      }

      function guardMatters(guard) {
        return say(`guard.${guard.key}_matters`, '')
      }

      function guardDetail(guard) {
        let text = say(`guard.${guard.key}_${guard.detailKey}`, '')

        for (const [name, value] of Object.entries(guard.detailValues || {}))
          text = text.replace(`{${name}}`, value)

        return text
      }

      const guards = state([])
      const allPassed = state(true)
      const loading = state(true)
      const rows = state([])
      const query = state('')
      const error = state('')

      /* Who is signed in; see functions/session.ts. */
      const signedIn = state(false)
      const denied = state(false)

      /* This screen is about the platform rather than about one business, so
         there is nothing to switch between - but partials/operator-empty is
         shared with the screens that have. */
      const mine = state([])
      const slug = state('')
      const allowed = state(false)

      function operatorLink() {
        return '/admin'
      }

      let pending = null

      async function loadGuards() {
        const response = await apiGet('/api/admin/guards')

        if (!response.ok) {
          denied.set(true)
          return
        }

        const { data } = await response.json()

        guards.set(data.results)
        allPassed.set(data.allPassed)
        loading.set(false)
      }

      async function loadListings() {
        const response = await apiGet(`/api/admin/listings?q=${encodeURIComponent(query())}`)

        if (!response.ok) {
          denied.set(true)
          return
        }

        const { data } = await response.json()

        rows.set(data)
      }

      function onQuery(value) {
        query.set(value)

        clearTimeout(pending)
        pending = setTimeout(loadListings, 250)
      }

      async function setHidden(slug, hidden) {
        const response = await send(`/api/admin/listings/${slug}/${hidden ? 'hide' : 'restore'}`)

        if (!response.ok) {
          error.set((await response.json()).message)
          return
        }

        error.set('')
        loadListings()
      }

      /*
       * Ask who this is once, then load. Both calls 403 for anybody but
       * operations, and firing them before the answer is known means two
       * refusals in the console on every page load by somebody who is simply
       * not an operator.
       */
      async function load() {
        const account = await me()

        signedIn.set(Boolean(account))

        if (!may(account, 'guards.read')) {
          // Not `denied`: nobody asked for somebody else's business here, they
          // asked for a screen their account does not open. operator-empty
          // tells those two apart.
          loading.set(false)
          return
        }

        allowed.set(true)

        await Promise.all([loadGuards(), loadListings()])
      }

      load()
    </script>
    @include('footer')
  </body>
</html>
