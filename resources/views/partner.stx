    state: t('partner.built'),
    href: '/places/nonna-pia',
  },
  {
    name: t('partner.ops_title'),
    icon: 'i-hugeicons-checkmark-circle-02',
    detail: t('partner.ops_body'),
    state: t('partner.built'),
