<script server>
/*
 * The merchant side, stated rather than built.
 *
 * The partner portal is real work that is not finished, and the listing pages
 * link here from "Claim this business". A page that says what it will be beats
 * a link into a 404, and beats a fake sign-up form that collects a real
 * business's details for a demo that will never call them back.
 */
const pageTitle = 'For businesses - Smakelo'
const pageDescription = 'What a business gets from Smakelo, and what is still being built.'
const canonicalPath = '/partner'

const surfaces = [
  {
    name: 'Menu',
    detail: 'Sections, items, and modifier groups that ask the questions an order actually needs answered. Available in the data model and on the customer side today.',
    state: 'Built',
  },
  {
    name: 'Orders board',
    detail: 'Incoming orders as they arrive, with kitchen tickets printed to a receipt printer.',
    state: 'Next',
  },
  {
    name: 'Tables and codes',
    detail: 'A code per table that opens the menu, opens a tab, and takes rounds until someone asks for the bill.',
    state: 'Next',
  },
  {
    name: 'Couriers',
    detail: 'Platform couriers, or your own staff. Live position, arrival, and the handover.',
    state: 'In progress',
  },
  {
    name: 'Payouts',
    detail: 'Stripe Connect: the customer pays once, the platform keeps its fee, the rest settles to you.',
    state: 'Built',
  },
]
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-4xl">
      <section class="pt-16 pb-16 sm:pt-24">
        <span class="inline-block px-3 py-1 text-[10px] font-medium tracking-[0.2em] uppercase rounded-full" style="background: var(--accent-soft); color: var(--accent)">
          For businesses
        </span>

        <h1 class="mt-6 text-[clamp(2.25rem,5vw,3.5rem)] font-semibold leading-[1.04] tracking-[-0.035em] text-balance">
          The merchant side, honestly.
        </h1>

        <p class="mt-6 max-w-2xl text-[17px] leading-relaxed" style="color: var(--ink-soft)">
          Smakelo is a demonstration, so there is nothing to sign up for and nobody
          to call you back. If your business is listed here, it was taken from open
          data and it cannot take an order through this site. Here is what the
          merchant side does and does not do yet.
        </p>
      </section>

      <section class="pb-24 sm:pb-40">
        <div class="space-y-3">
          @foreach (surfaces as surface)
            <div class="p-1.5 rounded-[1.5rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
              <div class="flex gap-6 justify-between items-start p-6 rounded-[calc(1.5rem-0.375rem)]">
                <div class="min-w-0">
                  <p class="text-[16px] font-semibold">{{ surface.name }}</p>
                  <p class="mt-2 text-[14px] leading-relaxed" style="color: var(--ink-soft)">{{ surface.detail }}</p>
                </div>
                <span class="px-2.5 py-1 text-[11px] rounded-full shrink-0" style="border: 1px solid var(--line); color: var(--ink-soft)">
                  {{ surface.state }}
                </span>
              </div>
            </div>
          @endforeach
        </div>

        <p class="mt-10 text-[14px] leading-relaxed" style="color: var(--ink-soft)">
          If you run one of the places listed here and would rather it were not,
          that is a reasonable thing to want. The listing comes from OpenStreetMap
          and Foursquare Open Source Places; say so and it comes down.
        </p>
      </section>
    </main>

    <footer class="border-t" style="border-color: var(--line)">
      <div class="mx-auto px-4 sm:px-8 py-12 max-w-4xl text-[13px]" style="color: var(--ink-soft)">
        <p>
          Smakelo is a demonstration built on <a href="https://github.com/stacksjs/stacks" class="underline underline-offset-4">Stacks</a>.
          Nothing here can be bought.
        </p>
      </div>
    </footer>
  </body>
</html>
