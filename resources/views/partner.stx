<script server>
/*
 * The merchant side.
 *
 * Each row links into the screen it describes, as one of the invented partners
 * would see it, and says plainly where something is not finished. The listing
 * pages link here from "Claim this business", so this is also what a real
 * business owner would land on - which is why there is no sign-up form
 * collecting their details for a demo that will never call them back.
 */
import { currentLocale, t } from '../../app/Actions/Locale/translate'

const pageTitle = t('meta.partner_title')
const pageDescription = t('meta.partner_description')
const canonicalPath = '/partner'

const surfaces = [
  {
    name: t('partner.menu_title'),
