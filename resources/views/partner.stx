    icon: 'i-hugeicons-delivery-truck-01',
    detail: t('partner.couriers_body'),
    state: t('partner.built'),
    href: '/track',
  },
  {
    name: t('partner.reviews_title'),
    icon: 'i-hugeicons-star',
