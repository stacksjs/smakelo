<script server>
/*
 * Your orders.
 *
 * There are no accounts, so this is the list of orders placed from this
 * browser. A guest normally has only the tracking link, which lives in
 * whichever tab they closed; recording who placed the order means the list can
 * simply be shown.
 */
const pageTitle = 'Orders - Smakelo'
const pageDescription = 'What you ordered.'
const canonicalPath = '/orders'
</script>

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-3xl">
      <div id="orders-root" class="pt-12 pb-24 sm:pb-40">
        <h1 class="text-[clamp(2rem,4.5vw,3rem)] font-semibold tracking-[-0.035em]">Orders</h1>
        <p class="mt-3 text-[15px]" style="color: var(--ink-soft)">Loading…</p>
      </div>
    </main>

    <script client>
      const root = document.getElementById('orders-root')

      const money = (cents, currency) => `${currency === 'eur' ? '€' : '$'}${(cents / 100).toFixed(2)}`

      const escapeHtml = value => String(value).replace(/[&<>"']/g, ch => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', '\'': '&#39;',
      }[ch]))

      function visitorToken() {
        let token = localStorage.getItem('smakelo.visitor')

        if (!token) {
          token = Array.from(crypto.getRandomValues(new Uint8Array(16)), b => b.toString(16).padStart(2, '0')).join('')
          localStorage.setItem('smakelo.visitor', token)
        }

        return token
      }

      // An order is finished when it has been handed over. Anything else is
      // still worth a tracking link.
      const LIVE = ['PENDING', 'PROCESSING', 'SHIPPED', 'OUT_FOR_DELIVERY']

      async function load() {
        const { data } = await (await fetch('/api/orders/mine', { headers: { 'x-visitor': visitorToken() } })).json()

        root.innerHTML = `
          <h1 class="text-[clamp(2rem,4.5vw,3rem)] font-semibold tracking-[-0.035em]">Orders</h1>
          <p class="mt-3 max-w-xl text-[15px] leading-relaxed" style="color: var(--ink-soft)">
            Placed from this browser. There are no accounts here, so a different
            browser is a different list.
          </p>

          ${data.length === 0
            ? `<div class="p-8 mt-10 text-center rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
                 <p class="text-[15px]" style="color: var(--ink-soft)">You have not ordered anything yet.</p>
                 <a href="/" class="inline-block mt-4 text-[14px] underline underline-offset-4">Find somewhere</a>
               </div>`
            : `<div class="mt-10 space-y-3">${data.map(card).join('')}</div>`}`
      }

      function card(order) {
        const live = LIVE.includes(order.status)

        return `
          <div class="p-1.5 rounded-[1.5rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
            <div class="p-6 rounded-[calc(1.5rem-0.375rem)]">
              <div class="flex flex-wrap gap-4 justify-between items-baseline">
                <a href="/places/${order.businessSlug}" class="text-[16px] font-semibold transition-opacity duration-500 hover:opacity-70">${escapeHtml(order.businessName)}</a>
                <span class="text-[15px] tabular-nums">${money(order.totalCents, order.currency)}</span>
              </div>

              <p class="mt-2 text-[14px]" style="color: var(--ink-soft)">${order.items.map(escapeHtml).join(', ')}</p>

              <div class="flex flex-wrap gap-3 items-center mt-5">
                <span class="px-2.5 py-1 text-[11px] rounded-full" style="${live ? 'background: var(--accent-soft); color: var(--accent)' : 'border: 1px solid var(--line); color: var(--ink-soft)'}">
                  ${escapeHtml(order.status.toLowerCase().replace(/_/g, ' '))}
                </span>
                <span class="text-[12px]" style="color: var(--ink-soft)">${escapeHtml(order.orderType.toLowerCase().replace('_', ' '))}</span>
                ${live && order.trackingToken
                  ? `<a href="/track?code=${order.trackingToken}" class="ml-auto text-[13px] underline underline-offset-4">Track it</a>`
                  : `<a href="/places/${order.businessSlug}" class="ml-auto text-[13px] underline underline-offset-4">Write a review</a>`}
              </div>
            </div>
          </div>`
      }

      load()
    </script>
  </body>
</html>
