<script server>
/*
 * Your orders.
 *
 * There are no accounts, so this is the list of orders placed from this
 * browser. A guest normally has only the tracking link, which lives in
 * whichever tab they closed; recording who placed the order means the list can
 * simply be shown.
 */
import { currentLocale, t } from '../../app/Actions/Locale/translate'

const pageTitle = t('meta.orders_title')
const pageDescription = t('meta.orders_description')
const canonicalPath = '/orders'
</script>

<!DOCTYPE html>
<html lang="{{ currentLocale() }}">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-3xl" data-stx-content>
      <div class="pt-12 pb-24 sm:pb-40">
        <h1 class="text-[clamp(2rem,4.5vw,3rem)] font-semibold tracking-[-0.035em]">{{ t('orders.title') }}</h1>

        <p class="mt-3 max-w-xl text-[15px] leading-relaxed" style="color: var(--ink-soft)">
          Placed from this browser. There are no accounts here, so a different
          browser is a different list.
        </p>

        <p :if="loading()" class="mt-10 text-[15px]" style="color: var(--ink-soft)">{{ t('common.loading') }}…</p>

        <div :if="!loading() && orders().length === 0" class="p-8 mt-10 text-center rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03)">
          <p class="text-[15px]" style="color: var(--ink-soft)">{{ t('orders.ordered_nothing') }}</p>
          <a href="/" class="inline-block mt-4 text-[14px] underline underline-offset-4">{{ t('orders.empty_cta') }}</a>
        </div>

        <div class="mt-10 space-y-3">
          <div :for="order in orders()" class="p-1.5 rounded-[1.5rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
            <div class="p-6 rounded-[calc(1.5rem-0.375rem)]">
              <div class="flex flex-wrap gap-4 justify-between items-center">
                <div class="flex gap-4 items-center min-w-0">
                  <div class="cover flex justify-center items-center w-12 h-12 rounded-[0.9rem] shrink-0" :style="'--h: ' + order.hue + '; --h2: ' + order.hueEnd">
                    <i class="cover-mark w-5 h-5" :class="order.iconClass"></i>
                    <img class="cover-photo" :src="order.photoThumb" alt="" loading="lazy" decoding="async" width="160" height="160">
                  </div>
                  <a :href="'/places/' + order.businessSlug" class="text-[16px] font-semibold transition-opacity duration-500 hover:opacity-70">{{ order.businessName }}</a>
                </div>
                <span class="text-[15px] tabular-nums">{{ money(order.totalCents, order.currency) }}</span>
              </div>

              <p class="mt-2 text-[14px]" style="color: var(--ink-soft)">{{ order.items.join(', ') }}</p>

              <div class="flex flex-wrap gap-3 items-center mt-5">
                <span
                  class="px-2.5 py-1 text-[11px] rounded-full"
                  :style="isLive(order) ? 'background: var(--accent-soft); color: var(--accent)' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
                >{{ readable(order.status) }}</span>

                <span class="text-[12px]" style="color: var(--ink-soft)">{{ readable(order.orderType) }}</span>

                <a :if="isLive(order) && order.trackingToken" :href="'/track?code=' + order.trackingToken" class="ml-auto text-[13px] underline underline-offset-4">{{ t('orders.track') }}</a>
                <a :if="!isLive(order)" :href="'/places/' + order.businessSlug" class="ml-auto text-[13px] underline underline-offset-4">{{ t('orders.write_review') }}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script client>
      import { money, visitorToken } from '../functions/session'

      const orders = state([])
      const loading = state(true)

      // An order is finished when it has been handed over. Anything else is
      // still worth a tracking link.
      const LIVE = ['PENDING', 'PROCESSING', 'SHIPPED', 'OUT_FOR_DELIVERY']

      function isLive(order) {
        return LIVE.includes(order.status)
      }

      function readable(value) {
        return String(value ?? '').toLowerCase().replace(/_/g, ' ')
      }

      async function load() {
        const response = await fetch('/api/orders/mine', { headers: { 'x-visitor': visitorToken() } })
        const { data } = await response.json()

        orders.set(data)
        loading.set(false)
      }

      load()
    </script>
    @include('footer')
  </body>
</html>
