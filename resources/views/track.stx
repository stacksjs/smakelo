<script server>
/*
 * Where your order is.
 *
 * Reached as `/track?code=<token>`. The code is the whole authentication: it is
 * long, random, and belongs to one order, which is the same trade every
 * delivery service makes for a link somebody opens on a phone without
 * signing in.
 */
import { currentLocale, t } from '../../app/Actions/Locale/translate'

/*
 * The strings this page's own script writes, already translated.
 *
 * Built here and carried to the markup on a data attribute, the same way the
 * rest of this app hands the client a payload. Written inline in the markup
 * instead, stx sometimes reads it as a client expression and leaves the
 * literal `{{ JSON.stringify(` in the attribute, which is a page whose script
 * silently falls back to English. The shared strings are in partials/head.stx.
 */
const clientStrings = JSON.stringify({
  'status.pending': t('status.pending'),
  'status.processing': t('status.processing'),
  'status.out_for_delivery': t('status.out_for_delivery'),
  'status.delivered': t('status.delivered'),
  'tracking.about_minutes': t('tracking.about_minutes', { minutes: '{minutes}' }),
  'tracking.your_address': t('tracking.your_address'),
})

const pageTitle = t('meta.track_title')
const pageDescription = t('meta.track_description')
const canonicalPath = '/track'
</script>

<!DOCTYPE html>
<html lang="{{ currentLocale() }}">
  <head>
    @include('head')
  </head>

  <body>
    @include('chrome')

    <main class="mx-auto px-4 sm:px-8 max-w-4xl" data-stx-content>
      <div class="pt-12 pb-24 sm:pb-40">
        {{-- What this page's own script writes, already translated. --}}
        <div hidden data-i18n-strings="{{ clientStrings }}"></div>

        <p :if="loading()" class="text-[15px]" style="color: var(--ink-soft)">{{ t('tracking.looking') }}</p>

        <p :if="!loading() && !code()" class="text-[15px]">
          {{ t('tracking.no_code_prefix') }} <a class="underline underline-offset-4" href="/discover">{{ t('nav.discover') }}</a> {{ t('tracking.no_code_suffix') }}
        </p>

        <p :if="!loading() && code() && !order()" class="text-[15px]">{{ t('tracking.not_found') }}</p>

        <div :if="order()">
          <p class="text-[13px]" style="color: var(--ink-soft)">{{ order().business ? order().business.name : '' }}</p>
          <h1 class="mt-1 text-[clamp(2rem,4.5vw,3rem)] font-semibold tracking-[-0.035em]">{{ t('tracking.title') }}</h1>

          {{-- The map is set up once and then only moved. It sits outside any
            binding that could re-render it: tearing down a map every five
            seconds would throw away the tiles it just fetched. --}}
          <div class="p-2 mt-8 rounded-[2rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 24px 48px -24px rgba(20,17,15,0.16)">
            <div id="track-map" class="h-[320px] w-full rounded-[calc(2rem-0.5rem)] overflow-hidden" style="background: var(--paper)"></div>
          </div>

          <ol class="mt-8 space-y-3">
            <li :for="step in steps()" class="flex gap-3 items-center text-[15px]">
              <span
                class="inline-flex justify-center items-center w-6 h-6 rounded-full shrink-0"
                :style="step.done ? 'background: var(--accent); color: #fff' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
              >
                <i :if="step.done" class="w-3 h-3 i-hugeicons-tick-02"></i>
              </span>
              <span :style="step.done ? '' : 'color: var(--ink-soft)'">{{ step.label }}</span>
            </li>
          </ol>

          <dl class="pt-6 mt-8 space-y-2 text-[14px] border-t" style="border-color: var(--line)">
            <div class="flex justify-between">
              <dt style="color: var(--ink-soft)">{{ t('tracking.arriving') }}</dt>
              <dd>{{ arriving() }}</dd>
            </div>
            <div :if="order().courier" class="flex justify-between">
              <dt style="color: var(--ink-soft)">{{ t('tracking.courier') }}</dt>
              <dd>{{ order().courier.name }}</dd>
            </div>
            <div :if="order().deliveryAddress" class="flex justify-between">
              <dt style="color: var(--ink-soft)">{{ t('tracking.to') }}</dt>
              <dd>{{ order().deliveryAddress }}</dd>
            </div>
            <div class="flex justify-between">
              <dt style="color: var(--ink-soft)">{{ t('tracking.total') }}</dt>
              <dd class="tabular-nums">{{ money(order().totalCents, order().currency) }}</dd>
            </div>
          </dl>
        </div>
      </div>
    </main>

    <script client>
      import { Marker, TsMap, vectorTileLayer } from 'ts-maps'
      import { basemap, keepSized } from '../functions/map'
      import { money } from '../functions/session'

      /*
       * The words this script writes, in the language the server served.
       *
       * The English text is the second argument rather than a fallback to the
       * key, so a string no holder carries reads as English rather than as its
       * own name. The page's holder is in the markup above; the shared bundle
       * is in partials/head.stx.
       */
      function say(key, english) {
        return window.Smakelo && window.Smakelo.t ? window.Smakelo.t(key, english) : english
      }

      const order = state(null)
      const loading = state(true)
      const code = state('')

      let map = null
      let courierMarker = null

      const STAGES = [
        { status: 'PENDING', label: say('status.pending', 'Order received') },
        { status: 'PROCESSING', label: say('status.processing', 'Being prepared') },
        { status: 'OUT_FOR_DELIVERY', label: say('status.out_for_delivery', 'On the way') },
        { status: 'DELIVERED', label: say('status.delivered', 'Delivered') },
      ]

      const steps = derived(() => {
        const current = order()
        const reached = current ? STAGES.findIndex(stage => stage.status === current.status) : -1

        return STAGES.map((stage, index) => ({ ...stage, done: reached >= index }))
      })

      const arriving = derived(() => {
        const current = order()

        if (!current)
          return ''

        if (current.status === 'DELIVERED')
          return say('status.delivered', 'Delivered')

        if (current.stop && current.stop.etaAt) {
          const minutes = Math.max(1, Math.round((new Date(current.stop.etaAt) - Date.now()) / 60000))

          return say('tracking.about_minutes', 'about {minutes} min').replace('{minutes}', minutes)
        }

        return say('tracking.about_minutes', 'about {minutes} min').replace('{minutes}', current.estimatedMinutes)
      })

      async function tick() {
        const found = new URLSearchParams(location.search).get('code') || ''

        code.set(found)

        if (!found) {
          loading.set(false)
          return
        }

        const response = await fetch(`/api/orders/track/${encodeURIComponent(found)}`)

        if (!response.ok) {
          order.set(null)
          loading.set(false)
          return
        }

        const { data } = await response.json()

        order.set(data)
        loading.set(false)

        // The map lives outside the reactive tree, so it is driven by hand.
        // Its container is inside an `:if`, so it does not exist until the
        // order arrives and the runtime has rendered that branch; a single
        // rAF was not enough and the map silently never appeared.
        whenPresent('track-map', () => {
          setupMap(data)
          moveCourier(data)
        })

        // Stop asking once there is nothing left to change.
        if (data.status !== 'DELIVERED' && data.status !== 'CANCELLED')
          setTimeout(tick, 5000)
      }

      /**
       * Run once the element exists.
       *
       * Gives up after a second: if the branch never rendered, the order has no
       * business to centre on, and retrying forever would hide that.
       */
      function whenPresent(id, done, attempts = 20) {
        if (document.getElementById(id)) {
          done()
          return
        }

        if (attempts > 0)
          setTimeout(() => whenPresent(id, done, attempts - 1), 50)
      }

      function setupMap(current) {
        const el = document.getElementById('track-map')

        if (map || !el || !current.business)
          return

        map = new TsMap(el, { center: [current.business.latitude, current.business.longitude], zoom: 14 })

        basemap(vectorTileLayer, map, el)

        new Marker([current.business.latitude, current.business.longitude])
          .addTo(map)
          .bindPopup(current.business.name)

        if (current.destination)
          new Marker([current.destination.latitude, current.destination.longitude]).addTo(map).bindPopup(say('tracking.your_address', 'Your address'))

        keepSized(map, el)
      }

      function moveCourier(current) {
        if (!map || !current.courier || current.courier.latitude == null)
          return

        const position = [current.courier.latitude, current.courier.longitude]

        // Move the existing marker rather than adding another. Adding one per
        // poll leaves a trail of stale couriers across the city.
        if (courierMarker)
          courierMarker.setLatLng(position)
        else
          courierMarker = new Marker(position).addTo(map).bindPopup(current.courier.name)

        map.panTo(position)
      }

      tick()
    </script>
    @include('footer')
  </body>
</html>
