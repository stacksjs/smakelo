{{-- The footer, on every page.

  Everything the nav does not carry. The nav is three links - discover, your
  orders, your saved list - because those are the things somebody moves
  between while using the site. The merchant side, the legal pages and the
  language switch are things you go looking for once, and a nav that lists
  them competes with itself.

  Four columns on a desktop, stacked on a phone, and the language switch under
  all of them where it reads as a property of the site rather than a fifth
  navigation choice. --}}

<footer class="border-t" style="border-color: var(--line)">
  <div class="mx-auto px-4 sm:px-8 py-14 max-w-7xl">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <a href="/" class="inline-flex gap-2.5 items-center">
          <span class="inline-flex justify-center items-center w-8 h-8 rounded-full" style="background: var(--accent)">
            <i class="w-3.5 h-3.5 text-white i-hugeicons-location-01"></i>
          </span>
          <span class="text-[17px] font-semibold tracking-[-0.02em]">Smakelo</span>
        </a>

        <p class="mt-3 max-w-[28ch] text-[13px] leading-relaxed" style="color: var(--ink-soft)">
          {{ t('footer.tagline', { regions: 'Los Angeles, Wuppertal, Gescher' }) }}
        </p>
      </div>

      <div>
        <h2 class="text-[12px] font-semibold tracking-[0.14em] uppercase" style="color: var(--ink-soft)">{{ t('footer.browse') }}</h2>
        <ul class="flex flex-col gap-2.5 mt-4 text-[14px]">
          <li><a href="/discover" class="transition-opacity duration-500 hover:opacity-70">{{ t('nav.discover') }}</a></li>
          <li><a href="/orders" class="transition-opacity duration-500 hover:opacity-70">{{ t('nav.orders') }}</a></li>
          <li><a href="/saved" class="transition-opacity duration-500 hover:opacity-70">{{ t('nav.favorites') }}</a></li>
          <li><a href="/shares" class="transition-opacity duration-500 hover:opacity-70">{{ t('nav.shares') }}</a></li>
          <li><a href="/account" class="transition-opacity duration-500 hover:opacity-70">{{ t('nav.account') }}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-[12px] font-semibold tracking-[0.14em] uppercase" style="color: var(--ink-soft)">{{ t('footer.for_business') }}</h2>
        <ul class="flex flex-col gap-2.5 mt-4 text-[14px]">
          <li><a href="/partner" class="transition-opacity duration-500 hover:opacity-70">{{ t('footer.list_your_place') }}</a></li>
          <li><a href="/manage" class="transition-opacity duration-500 hover:opacity-70">{{ t('footer.manage_place') }}</a></li>
          <li><a href="/kitchen" class="transition-opacity duration-500 hover:opacity-70">{{ t('footer.kitchen_screen') }}</a></li>
          <li><a href="/courier" class="transition-opacity duration-500 hover:opacity-70">{{ t('footer.courier') }}</a></li>
          <li><a href="/earnings" class="transition-opacity duration-500 hover:opacity-70">{{ t('footer.earnings') }}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-[12px] font-semibold tracking-[0.14em] uppercase" style="color: var(--ink-soft)">{{ t('footer.about') }}</h2>
        <ul class="flex flex-col gap-2.5 mt-4 text-[14px]">
          <li><a href="/claims" class="transition-opacity duration-500 hover:opacity-70">{{ t('footer.claim_listing') }}</a></li>
          <li><a href="https://github.com/stacksjs/stacks" class="transition-opacity duration-500 hover:opacity-70">{{ t('footer.built_on') }}</a></li>
          <li><a href="https://www.openstreetmap.org/copyright" class="transition-opacity duration-500 hover:opacity-70">{{ t('footer.map_data') }}</a></li>
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap gap-6 justify-between items-center pt-8 mt-12 border-t" style="border-color: var(--line)">
      <p class="max-w-2xl text-[12px] leading-relaxed" style="color: var(--ink-soft)">
        {{ t('footer.sources') }}
      </p>

      {{-- Three languages, named in their own. A flag would be wrong: German is
        not Germany, and Dutch is not only the Netherlands.

        Each href is a locale root - `/en/`, `/de/`, `/nl/` - so the switch
        works with scripting off. English is spelled with its prefix here even
        though its canonical URLs carry none: the server rewrites in-page links
        into the locale it is serving, and a bare `/` on a German page would
        be rewritten to `/de/`, leaving the English option pointing at German.

        The views server finds this element by id (`pickerSelector` in
        config/site.ts), marks the current language on it, and turns a click
        into a client-side hop to the unprefixed English URL. Neither half
        needs the other to be correct. --}}
      <nav id="lang-switch" aria-label="{{ t('footer.language') }}" class="flex gap-1 items-center text-[12px]">
        <a href="/en/" data-lang="en" hreflang="en" class="lang-option px-3 py-2 rounded-full transition-all duration-500">EN</a>
        <a href="/de/" data-lang="de" hreflang="de" class="lang-option px-3 py-2 rounded-full transition-all duration-500">DE</a>
        <a href="/nl/" data-lang="nl" hreflang="nl" class="lang-option px-3 py-2 rounded-full transition-all duration-500">NL</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  /* The current language, marked in CSS rather than by a script.

     The server sets `aria-current` on the language being served and updates it
     on a client-side hop, so the state is already in the markup and in the
     accessibility tree. Styling from the attribute rather than assigning
     `style.background` from our own script means one source of truth and no
     flash of the wrong language being highlighted before a script runs. */
  .lang-option {
    color: var(--ink-soft);
    background: transparent;
  }

  .lang-option[aria-current='true'] {
    background: var(--ink);
    color: var(--paper);
  }
</style>
