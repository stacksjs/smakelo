{{-- The footer, on every page.

  Everything the nav does not carry. The nav is three links - discover, your
  orders, your saved list - because those are the things somebody moves
  between while using the site. The merchant side, the legal pages and the
  language switch are things you go looking for once, and a nav that lists
  them competes with itself.

  Four columns on a desktop, stacked on a phone, and the language switch under
  all of them where it reads as a property of the site rather than a fifth
  navigation choice. --}}

<footer class="border-t" style="border-color: var(--line)">
  <div class="mx-auto px-4 sm:px-8 py-14 max-w-7xl">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <a href="/" class="inline-flex gap-2.5 items-center">
          <span class="inline-flex justify-center items-center w-8 h-8 rounded-full" style="background: var(--accent)">
            <i class="w-3.5 h-3.5 text-white i-hugeicons-location-01"></i>
          </span>
          <span class="text-[17px] font-semibold tracking-[-0.02em]">Smakelo</span>
        </a>

        <p class="mt-3 max-w-[28ch] text-[13px] leading-relaxed" style="color: var(--ink-soft)">
          Restaurants, coffee shops and farms across Los Angeles.
        </p>
      </div>

      <div>
        <h2 class="text-[12px] font-semibold tracking-[0.14em] uppercase" style="color: var(--ink-soft)">Browse</h2>
        <ul class="flex flex-col gap-2.5 mt-4 text-[14px]">
          <li><a href="/discover" data-i18n="nav.discover" class="transition-opacity duration-500 hover:opacity-70">Discover</a></li>
          <li><a href="/orders" data-i18n="nav.orders" class="transition-opacity duration-500 hover:opacity-70">Orders</a></li>
          <li><a href="/saved" data-i18n="nav.favorites" class="transition-opacity duration-500 hover:opacity-70">Saved</a></li>
          <li><a href="/shares" data-i18n="nav.shares" class="transition-opacity duration-500 hover:opacity-70">Shares</a></li>
          <li><a href="/account" class="transition-opacity duration-500 hover:opacity-70">Account</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-[12px] font-semibold tracking-[0.14em] uppercase" style="color: var(--ink-soft)">For businesses</h2>
        <ul class="flex flex-col gap-2.5 mt-4 text-[14px]">
          <li><a href="/partner" data-i18n="nav.partner" class="transition-opacity duration-500 hover:opacity-70">List your place</a></li>
          <li><a href="/manage" class="transition-opacity duration-500 hover:opacity-70">Manage a place</a></li>
          <li><a href="/kitchen" class="transition-opacity duration-500 hover:opacity-70">Kitchen screen</a></li>
          <li><a href="/courier" class="transition-opacity duration-500 hover:opacity-70">Courier</a></li>
          <li><a href="/earnings" class="transition-opacity duration-500 hover:opacity-70">Earnings</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-[12px] font-semibold tracking-[0.14em] uppercase" style="color: var(--ink-soft)">About</h2>
        <ul class="flex flex-col gap-2.5 mt-4 text-[14px]">
          <li><a href="/claims" class="transition-opacity duration-500 hover:opacity-70">Claim a listing</a></li>
          <li><a href="https://github.com/stacksjs/stacks" class="transition-opacity duration-500 hover:opacity-70">Built on Stacks</a></li>
          <li><a href="https://www.openstreetmap.org/copyright" class="transition-opacity duration-500 hover:opacity-70">Map data</a></li>
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap gap-6 justify-between items-center pt-8 mt-12 border-t" style="border-color: var(--line)">
      <p class="max-w-2xl text-[12px] leading-relaxed" style="color: var(--ink-soft)">
        Listings from OpenStreetMap and Foursquare Open Source Places.
        Reviews, orders and accounts are invented.
      </p>

      {{-- Three languages, named in their own. A flag would be wrong: German is
        not Germany, and Dutch is not only the Netherlands. --}}
      <div class="flex gap-1 items-center text-[12px]" id="lang-switch">
        <a href="?lang=en" data-lang="en" class="px-3 py-2 rounded-full transition-all duration-500">EN</a>
        <a href="?lang=de" data-lang="de" class="px-3 py-2 rounded-full transition-all duration-500">DE</a>
        <a href="?lang=nl" data-lang="nl" class="px-3 py-2 rounded-full transition-all duration-500">NL</a>
      </div>
    </div>
  </div>
</footer>

<script>
  /* Mark the language in use, so the switcher says where you are. */
  ;(function () {
    try {
      const current = (window.Smakelo && window.Smakelo.locale) || 'en'

      for (const link of document.querySelectorAll('#lang-switch [data-lang]')) {
        const on = link.dataset.lang === current

        link.style.background = on ? 'var(--ink)' : 'transparent'
        link.style.color = on ? 'var(--paper)' : 'var(--ink-soft)'
        link.setAttribute('aria-current', on ? 'true' : 'false')
      }
    }
    catch {}
  })()
</script>
