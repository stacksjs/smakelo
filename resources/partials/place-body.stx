<script server>
/*
 * This partial imports what it uses.
 *
 * A partial inherits the including page's scope, and leaning on it for `t`
 * makes every page responsible for importing something only the partial needs
 * - a page that forgets renders key names. Its own import cannot be forgotten.
 */
import { t } from '../../app/Actions/Locale/translate'
</script>

{{-- The place page's content.

  Included by every generated view under resources/views/places/, each of which
  supplies `vm` (see app/Actions/Business/place-view.ts) plus the three names the
  head partial reads. A partial inherits the including page's scope, so this
  reads plain properties and calls nothing.

  The document skeleton is in the generated view rather than here: stx stamps
  its setup marker onto the `<body>` of the page it compiles, and with the body
  inside a partial it found none, so no binding on this page ever hydrated. --}}
    <main class="mx-auto px-4 sm:px-8 max-w-7xl" data-stx-content>
      {{-- What this partial's script writes, already translated. Every place
        page includes this file, so the strings ride with it rather than being
        repeated across four hundred generated pages. --}}
      <div hidden data-i18n-strings="{{ clientStrings }}"></div>

      <a href="/" class="inline-flex gap-2 items-center pt-10 text-[13px] transition-opacity duration-500 hover:opacity-70" style="color: var(--ink-soft)">
        <i class="w-3.5 h-3.5 i-hugeicons-arrow-left-01"></i>
        {{ t('place.back_to_discover') }}
      </a>

      {{-- The cover band: a photograph of what this kind of kitchen sends
        out, over the business's own colour. See Business/imagery.ts. --}}
      <div class="cover flex overflow-hidden relative justify-center items-center mt-6 h-56 rounded-[1.75rem] sm:h-72" data-blur="{{ vm.photoBlur }}" style="--h: {{ vm.hue }}; --h2: {{ vm.hueEnd }}">
        <i class="cover-mark w-14 h-14 sm:w-16 sm:h-16 {{ vm.iconClass }}"></i>
        <img class="cover-photo" src="{{ vm.photo }}" srcset="{{ vm.photoSrcset }}" sizes="(min-width: 1280px) 1200px, 100vw" alt="" fetchpriority="high" decoding="async" width="1600" height="640">
        <span class="cover-scrim"></span>
        <span class="absolute right-5 bottom-4 text-[13px] font-semibold tracking-[0.18em] text-white" style="opacity: .8; text-shadow: 0 1px 3px rgba(0,0,0,.45)">{{ vm.monogram }}</span>
      </div>

      <section class="grid grid-cols-1 gap-10 items-start pt-8 pb-16 lg:grid-cols-12">
        <div class="lg:col-span-7">
          {{-- The business's mark, lifted so it overlaps the photograph above.

            Derived from the name like the hue and the initials it is made of,
            and deliberately plain: nobody designed a logo for these places,
            and dressing a generated tile up as one would be inventing a brand
            for a real business. --}}
          <div class="flex relative gap-4 items-end -mt-14 mb-5">
            <span class="logo-mark" style="--h: {{ vm.hue }}; --h2: {{ vm.hueEnd }}" aria-hidden="true">{{ vm.monogram }}</span>
          </div>

          <div class="flex flex-wrap gap-2 items-center">
            <span class="px-3 py-1 text-[10px] font-medium tracking-[0.2em] uppercase rounded-full" style="background: var(--accent-soft); color: var(--accent)">
              {{ vm.type }}
            </span>
            @if (vm.isPartner)
              <span class="px-3 py-1 text-[10px] font-medium tracking-[0.16em] uppercase rounded-full" style="border: 1px solid var(--line); color: var(--ink-soft)">
                {{ t('search.takes_orders') }}
              </span>
            @endif
          </div>

          <h1 class="mt-5 text-[clamp(2.25rem,5.5vw,3.75rem)] font-semibold leading-[1.02] tracking-[-0.035em]">
            {{ vm.name }}
          </h1>

          <p class="mt-4 text-[17px] leading-relaxed" style="color: var(--ink-soft)">
            {{ vm.description }}
          </p>

          <div class="flex flex-wrap gap-x-5 gap-y-2 items-center mt-6 text-[14px]" style="color: var(--ink-soft)">
            @if (vm.hasRating)
              <span class="inline-flex gap-2 items-center">
                <span class="stars text-[15px]">★★★★★<span style="width: {{ vm.ratingPercent }}%">★★★★★</span></span>
                <strong style="color: var(--ink)">{{ vm.ratingAverage }}</strong>
                <span>{{ vm.ratingLabel }}</span>
              </span>
            @endif
            <span>{{ vm.cuisine }}</span>
            <span>{{ vm.priceLabel }}</span>
            <span>{{ vm.statusLabel }}</span>
          </div>

          <p class="mt-4 text-[14px]" style="color: var(--ink-soft)">
            {{ vm.location }}
          </p>

          {{-- Saving is private and says nothing about the business, so a real
            listing can be saved as freely as an invented partner. --}}
          <button
            @click="toggleSave()"
            class="inline-flex gap-2 items-center px-4 py-2 mt-6 text-[13px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]"
            :style="saved() ? 'background: var(--accent-soft); color: var(--accent); border: 1px solid transparent' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
          >
            <i class="w-3.5 h-3.5 i-hugeicons-bookmark-02"></i>
            <span>{{ saved() ? say('business.saved', 'Saved') : say('business.save', 'Save') }}</span>
          </button>
        </div>

        <div class="lg:col-span-5">
          <div class="p-2 rounded-[2rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 24px 48px -24px rgba(20,17,15,0.16)">
            <div id="place-map" data-point="{{ vm.mapPoint }}" class="h-[240px] sm:h-[260px] w-full rounded-[calc(2rem-0.5rem)] overflow-hidden" style="background: var(--paper)"></div>
          </div>

          {{-- The tiles' attribution, which the map's own control used to
            carry. It is off now, the way it is on discover, so the credit
            moves to a line of text - which is where the licence wants it and
            where it is not sitting on top of the map. --}}
          <p class="mt-3 text-[11px]" style="color: var(--ink-soft)">
            {{ t('discover.attribution') }}
          </p>
        </div>
      </section>

      <div class="grid grid-cols-1 gap-10 pb-24 lg:grid-cols-12 sm:pb-40">
        <div class="lg:col-span-7">
          @if (vm.menu.length > 0)
            <section>
              <div class="flex flex-wrap gap-4 justify-between items-center">
                <h2 class="text-[28px] font-semibold tracking-[-0.03em]">{{ t('business.menu') }}</h2>

                {{-- The basket, from the page the menu is on.

                  This was a link to /order?business=<slug>, which rendered the
                  same menu a second time behind a query string. There is one
                  menu now and it is this one. --}}
                <button
                  :if="menuReady()"
                  @click="openCart()"
                  class="inline-flex gap-3 items-center px-5 py-2.5 text-[14px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] group"
                  style="background: var(--accent); color: #fff"
                >
                  <span>{{ t('cart.your_order') }}</span>
                  <span
                    class="flex justify-center items-center px-2 h-7 min-w-7 text-[13px] tabular-nums rounded-full"
                    style="background: rgba(255,255,255,0.2)"
                    :text="cartCount()"
                  ></span>
                </button>
              </div>

              @foreach (vm.menu as section)
                <div class="mt-8">
                  <h3 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ section.section }}</h3>

                  <div class="mt-4 space-y-3">
                    @foreach (section.items as item)
                      <div class="p-1.5 rounded-[1.5rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
                        <div class="flex gap-4 items-start p-4 rounded-[calc(1.5rem-0.375rem)] sm:gap-5 sm:p-5">
                          {{-- A picture of the kind of dish. Stock, and chosen
                            from the dish's own name, so it is honest about
                            being illustrative rather than a photograph of this
                            kitchen's plate.

                            Tappable, because a photograph is the thing on a
                            menu row people reach for first. It opens the same
                            drawer the name does. --}}
                          <button
                            type="button"
                            @click="openItem({{ item.id }})"
                            class="cover flex flex-none justify-center items-center w-20 h-20 rounded-[1rem] transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] sm:w-24 sm:h-24"
                            data-blur="{{ item.photoBlur }}"
                            style="--h: {{ vm.hue }}; --h2: {{ vm.hueEnd }}"
                            aria-label="{{ item.name }}"
                          >
                            <i class="cover-mark w-6 h-6 {{ vm.iconClass }}"></i>
                            <img class="cover-photo" src="{{ item.photo }}" srcset="{{ item.photoSrcset }}" sizes="96px" alt="" loading="lazy" decoding="async" width="400" height="280">
                          </button>

                          <div class="flex-1 min-w-0">
                            <button type="button" @click="openItem({{ item.id }})" class="text-left transition-opacity duration-500 hover:opacity-70">
                              <p class="text-[15px] font-medium">{{ item.name }}</p>
                            </button>
                            <p class="mt-1.5 text-[14px] leading-relaxed line-clamp-2" style="color: var(--ink-soft)">{{ item.description }}</p>
                            <p class="mt-2 text-[15px] font-medium tabular-nums">{{ item.price }}</p>
                          </div>

                          {{-- Add, or change how many.

                            Both states are rendered and one is shown, rather
                            than one control that changes shape: a stepper that
                            appears where an "Add" button was is the same
                            element moving under the finger that just pressed
                            it.

                            Held back until the menu API answers, because the
                            modifier groups these buttons need are not in the
                            server-rendered row - a button pressed before then
                            would look ordinary and do nothing. --}}
                          <div class="flex-none self-center" :if="menuReady()">
                            <button
                              :if="qtyOf({{ item.id }}) === 0"
                              @click="addOne({{ item.id }})"
                              class="flex gap-1.5 items-center px-4 h-9 text-[13px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.95]"
                              style="border: 1px solid var(--line); color: var(--ink)"
                              aria-label="{{ t('cart.add') }} {{ item.name }}"
                            >
                              <i class="w-3.5 h-3.5 i-hugeicons-plus-sign"></i>
                              <span>{{ t('cart.add') }}</span>
                            </button>

                            <div
                              :if="qtyOf({{ item.id }}) > 0"
                              class="flex gap-1 items-center p-1 rounded-full"
                              style="background: var(--accent-soft)"
                            >
                              <button
                                @click="removeOne({{ item.id }})"
                                class="flex justify-center items-center w-7 h-7 rounded-full transition-all duration-500 active:scale-90"
                                style="color: var(--accent)"
                                aria-label="{{ t('cart.remove_one') }} {{ item.name }}"
                              >
                                <i class="w-3.5 h-3.5 i-hugeicons-minus-sign"></i>
                              </button>

                              <span class="w-6 text-[14px] font-medium tabular-nums text-center" style="color: var(--accent)" :text="qtyOf({{ item.id }})"></span>

                              <button
                                @click="addOne({{ item.id }})"
                                class="flex justify-center items-center w-7 h-7 rounded-full transition-all duration-500 active:scale-90"
                                style="background: var(--accent); color: #fff"
                                aria-label="{{ t('cart.add_one') }} {{ item.name }}"
                              >
                                <i class="w-3.5 h-3.5 i-hugeicons-plus-sign"></i>
                              </button>
                            </div>
                          </div>
                        </div>
                      </div>
                    @endforeach
                  </div>
                </div>
              @endforeach
            </section>
          @else
            {{-- A real business that never signed up. Saying so plainly is the
              honest version of an absent order button. --}}
            <section class="p-1.5 rounded-[2rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 18px 36px -22px rgba(20,17,15,0.14)">
              <div class="p-8 rounded-[calc(2rem-0.375rem)]">
                <h2 class="text-[20px] font-semibold tracking-[-0.02em]">{{ t('place.no_menu') }}</h2>
                <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--ink-soft)">
                  {{ vm.notPartnerBody }}
                </p>
                <button
                  :if="!claim().open && !claim().sent"
                  @click="setClaim('open', true)"
                  class="inline-flex gap-3 items-center px-5 py-2.5 mt-6 text-[14px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] group"
                  style="background: var(--ink); color: var(--paper)"
                >
                  <span>{{ t('place.claim_mine') }}</span>
                  <span class="flex justify-center items-center w-7 h-7 rounded-full transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-px" style="background: rgba(255,255,255,0.14)">
                    <i class="w-3.5 h-3.5 i-hugeicons-arrow-up-right-01"></i>
                  </span>
                </button>

                <div :if="claim().open && !claim().sent" class="p-6 mt-6 rounded-[1.5rem]" style="background: var(--paper); border: 1px solid var(--line)">
                  <p class="text-[14px] leading-relaxed" style="color: var(--ink-soft)">
                    {{ vm.claimBody }}
                  </p>

                  <input
                    placeholder="{{ t('place.form_name') }}"
                    maxlength="120"
                    :value="claim().name"
                    @input="setClaim('name', $event.target.value)"
                    class="px-4 py-3 mt-4 w-full text-[15px] rounded-[1rem]"
                    style="background: var(--paper-raised); border: 1px solid var(--line)"
                  >
                  <input
                    type="email"
                    placeholder="{{ t('place.form_reply_to') }}"
                    maxlength="200"
                    :value="claim().email"
                    @input="setClaim('email', $event.target.value)"
                    class="px-4 py-3 mt-3 w-full text-[15px] rounded-[1rem]"
                    style="background: var(--paper-raised); border: 1px solid var(--line)"
                  >
                  <textarea
                    rows="3"
                    placeholder="{{ t('place.form_what_happens') }}"
                    maxlength="2000"
                    :value="claim().message"
                    @input="setClaim('message', $event.target.value)"
                    class="px-4 py-3 mt-3 w-full text-[15px] rounded-[1rem]"
                    style="background: var(--paper-raised); border: 1px solid var(--line)"
                  ></textarea>

                  <p :if="claim().error" class="mt-3 text-[13px]" style="color: var(--accent)">{{ claim().error }}</p>

                  <button @click="sendClaim()" class="px-5 py-2.5 mt-4 text-[14px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]" style="background: var(--ink); color: var(--paper)">
                    {{ t('place.claim_send') }}
                  </button>
                </div>

                <p :if="claim().sent" class="p-6 mt-6 text-[14px] leading-relaxed rounded-[1.5rem]" style="background: var(--accent-soft); color: var(--ink)">
                  {{ t('place.claim_sent') }}
                </p>
              </div>
            </section>
          @endif

          {{-- Farms only, and only when the farm actually runs shares. --}}
          <section :if="plans().length > 0" class="mt-16">
            <h2 class="text-[28px] font-semibold tracking-[-0.03em]">{{ t('place.take_share') }}</h2>
            <p class="mt-3 max-w-xl text-[15px] leading-relaxed" style="color: var(--ink-soft)">
              {{ t('place.share_lede') }}
            </p>

            <div class="grid grid-cols-1 gap-4 mt-8 sm:grid-cols-2">
              <div :for="plan in plans()" class="p-1.5 rounded-[1.5rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 14px 28px -20px rgba(20,17,15,0.12)">
                <div class="flex flex-col p-6 h-full rounded-[calc(1.5rem-0.375rem)]">
                  <div class="flex gap-4 justify-between items-baseline">
                    <p class="text-[16px] font-semibold">{{ plan.name }}</p>
                    <p class="text-[15px] tabular-nums shrink-0">{{ money(plan.priceCents) }}</p>
                  </div>

                  <p class="mt-2 text-[14px] leading-relaxed" style="color: var(--ink-soft)">{{ plan.description }}</p>

                  <div class="flex flex-wrap gap-2 items-center pt-5 mt-auto">
                    <span class="px-2.5 py-1 text-[11px] rounded-full" style="background: var(--accent-soft); color: var(--accent)">{{ cadence(plan.cadence) }}</span>
                    <span class="px-2.5 py-1 text-[11px] rounded-full" style="border: 1px solid var(--line); color: var(--ink-soft)">{{ everyDay(plan.dayOfWeek) }}</span>
                    <span :if="plan.feeds" class="px-2.5 py-1 text-[11px] rounded-full" style="border: 1px solid var(--line); color: var(--ink-soft)">{{ plan.feeds }}</span>
                    <button @click="setShare('plan', plan)" class="px-4 py-2 ml-auto text-[13px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]" style="background: var(--ink); color: var(--paper)">{{ t('place.join') }}</button>
                  </div>
                </div>
              </div>
            </div>

            <div :if="share().plan && !share().joined" class="p-6 mt-4 rounded-[1.5rem]" style="background: var(--paper); border: 1px solid var(--line)">
              <p class="text-[15px] font-semibold">{{ share().plan.name }}</p>
              <p class="mt-1 text-[13px]" style="color: var(--ink-soft)">
                {{ boxLine(share().plan) }}
              </p>

              <input
                placeholder="{{ t('place.form_name') }}"
                maxlength="60"
                :value="share().name"
                @input="setShare('name', $event.target.value)"
                class="px-4 py-3 mt-4 w-full text-[15px] rounded-[1rem]"
                style="background: var(--paper-raised); border: 1px solid var(--line)"
              >

              <div class="flex flex-wrap gap-4 mt-3 text-[14px]">
                <label class="flex gap-2 items-center">
                  <input type="radio" name="fulfilment" :checked="share().fulfilment === 'pickup'" @change="setShare('fulfilment', 'pickup')"> {{ t('place.collect_from_farm') }}
                </label>
                <label :if="share().plan.offersDelivery" class="flex gap-2 items-center">
                  <input type="radio" name="fulfilment" :checked="share().fulfilment === 'delivery'" @change="setShare('fulfilment', 'delivery')"> {{ t('shares.delivered') }}
                </label>
              </div>

              <input
                :if="share().fulfilment === 'delivery'"
                placeholder="{{ t('order.address') }}"
                maxlength="255"
                :value="share().address"
                @input="setShare('address', $event.target.value)"
                class="px-4 py-3 mt-3 w-full text-[15px] rounded-[1rem]"
                style="background: var(--paper-raised); border: 1px solid var(--line)"
              >

              <p :if="share().error" class="mt-3 text-[13px]" style="color: var(--accent)">{{ share().error }}</p>

              <button @click="joinShare()" class="px-5 py-2.5 mt-4 text-[14px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]" style="background: var(--accent); color: #fff">
                {{ t('place.join_share') }}
              </button>
            </div>

            <p :if="share().joined" class="p-6 mt-4 text-[14px] leading-relaxed rounded-[1.5rem]" style="background: var(--accent-soft); color: var(--ink)">
              {{ joinedLine(share().joined.nextBoxAt) }}
              <a href="/shares" class="underline underline-offset-4">{{ t('place.your_shares') }}</a>.
              {{ t('place.joined_tail') }}
            </p>
          </section>

          <section class="mt-16">
            <div class="flex flex-wrap gap-4 justify-between items-baseline">
              <h2 class="text-[28px] font-semibold tracking-[-0.03em]">{{ t('business.reviews') }}</h2>
              <p :if="stats() && stats().count > 0" class="text-[14px]" style="color: var(--ink-soft)">
                {{ ratingSummary(stats()) }}
              </p>
            </div>

            <div :if="stats() && stats().count > 0" class="mt-6 space-y-1.5 max-w-xs">
              <div :for="bar in barsFrom(stats())" class="flex gap-3 items-center text-[12px]" style="color: var(--ink-soft)">
                <span class="w-3 tabular-nums text-right">{{ bar.star }}</span>
                <span class="overflow-hidden flex-1 h-1.5 rounded-full" style="background: var(--line)">
                  <span class="block h-full rounded-full" :style="'width: ' + bar.percent + '%; background: var(--accent)'"></span>
                </span>
                <span class="w-5 tabular-nums text-right">{{ bar.count }}</span>
              </div>
            </div>

            <p :if="!loadingReviews() && reviews().length === 0" class="mt-6 text-[15px]" style="color: var(--ink-soft)">{{ t('place.no_reviews_yet') }}</p>

            <div class="mt-6 space-y-4">
              <article :for="review in reviews()" class="p-1.5 rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.03), 0 16px 32px -22px rgba(20,17,15,0.12)">
                <div class="p-6 rounded-[calc(1.75rem-0.375rem)]">
                  <div class="flex gap-4 items-start">
                    {{-- Initials in a colour of their own. The honest version
                      of a face: a stock portrait would be somebody who never
                      wrote this. --}}
                    <div class="cover flex justify-center items-center w-10 h-10 rounded-full shrink-0" :style="'--h: ' + review.authorHue + '; --h2: ' + ((review.authorHue + 38) % 360)">
                      <span class="cover-mark text-[13px] font-semibold">{{ review.authorInitials }}</span>
                    </div>

                    <div class="flex-1 min-w-0">
                      <div class="flex flex-wrap gap-3 justify-between items-baseline">
                        <p class="text-[15px] font-semibold">{{ review.title || say('review.untitled', 'Untitled') }}</p>
                        <span class="shrink-0 text-[13px] tracking-[0.1em]" style="color: var(--accent)">{{ stars(review.rating) }}</span>
                      </div>

                      <p class="mt-1 text-[12px]" style="color: var(--ink-soft)">
                        {{ review.authorName }}{{ review.verified ? ' · ' + say('review.verified', 'ordered through Smakelo') : '' }}
                      </p>
                    </div>
                  </div>

                  <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--ink-soft)">{{ review.body }}</p>

                  <p :if="review.dishes" class="mt-3 text-[13px]" style="color: var(--ink-soft)">{{ dishesLine(review.dishes) }}</p>

                  <div :if="review.ownerResponse" class="pl-4 mt-5 border-l" style="border-color: var(--line)">
                    <p class="text-[12px] font-medium tracking-[0.14em] uppercase" style="color: var(--ink-soft)">{{ t('review.owner_response') }}</p>
                    <p class="mt-2 text-[14px] leading-relaxed" style="color: var(--ink-soft)">{{ review.ownerResponse }}</p>
                  </div>

                  <div class="flex gap-4 items-center mt-5">
                    <span :if="review.mine" class="text-[12px]" style="color: var(--ink-soft)">{{ t('place.your_review') }}</span>
                    <button
                      :if="!review.mine"
                      @click="vote(review.id)"
                      class="text-[12px] transition-opacity duration-500 hover:opacity-70"
                      :style="review.votedByMe ? 'color: var(--accent)' : 'color: var(--ink-soft)'"
                    >{{ review.votedByMe ? say('review.helpful_yours', 'You found this helpful') : say('review.helpful', 'Helpful') }}</button>
                    <span class="text-[12px]" style="color: var(--ink-soft)">{{ helpfulCount(review.helpfulCount) }}</span>
                  </div>
                </div>
              </article>
            </div>

            {{-- Only the invented partners can be reviewed. A real place listed
              from open data agreed to nothing, and the page says so rather than
              hiding the composer without explanation. --}}
            <p :if="!canReview()" class="mt-8 max-w-lg text-[14px] leading-relaxed" style="color: var(--ink-soft)">
              {{ vm.reviewsClosed }}
            </p>

            <p :if="canReview() && wroteOne()" class="mt-8 text-[14px]" style="color: var(--ink-soft)">
              {{ t('place.reviewed_once') }}
            </p>

            <div :if="canReview() && !wroteOne()" class="p-1.5 mt-10 rounded-[1.75rem]" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 18px 36px -22px rgba(20,17,15,0.14)">
              <div class="p-7 rounded-[calc(1.75rem-0.375rem)]">
                <h3 class="text-[18px] font-semibold tracking-[-0.02em]">{{ t('review.write') }}</h3>
                <p class="mt-2 text-[13px] leading-relaxed" style="color: var(--ink-soft)">
                  {{ t('place.review_prompt') }}
                </p>

                {{-- Five bare stars said nothing to a screen reader and named
                  nothing on the page. The label is what the group is for, and
                  each star says which one it is. --}}
                <p class="mt-5 text-[12px] font-medium tracking-[0.14em] uppercase" style="color: var(--ink-soft)">{{ t('review.rating') }}</p>

                <div class="flex gap-1 mt-2" role="group" aria-label="{{ t('review.rating') }}">
                  <button
                    :for="star in [1, 2, 3, 4, 5]"
                    type="button"
                    @click="setComposer('rating', star)"
                    :aria-label="starLabel(star)"
                    :aria-pressed="star <= composer().rating ? 'true' : 'false'"
                    class="p-1 text-[22px] leading-none transition-transform duration-500 hover:scale-110"
                    :style="star <= composer().rating ? 'color: var(--accent)' : 'color: var(--line)'"
                  >★</button>
                </div>

                <input
                  placeholder="{{ t('place.form_name') }}"
                  maxlength="60"
                  :value="composer().authorName"
                  @input="setComposer('authorName', $event.target.value)"
                  class="px-4 py-3 mt-5 w-full text-[15px] rounded-[1rem]"
                  style="background: var(--paper); border: 1px solid var(--line)"
                >
                <input
                  placeholder="{{ t('review.title_placeholder') }}"
                  maxlength="120"
                  :value="composer().title"
                  @input="setComposer('title', $event.target.value)"
                  class="px-4 py-3 mt-3 w-full text-[15px] rounded-[1rem]"
                  style="background: var(--paper); border: 1px solid var(--line)"
                >
                <textarea
                  rows="4"
                  placeholder="{{ t('review.body_placeholder') }}"
                  maxlength="4000"
                  :value="composer().body"
                  @input="setComposer('body', $event.target.value)"
                  class="px-4 py-3 mt-3 w-full text-[15px] rounded-[1rem]"
                  style="background: var(--paper); border: 1px solid var(--line)"
                ></textarea>
                <input
                  placeholder="{{ t('review.dishes_placeholder') }}"
                  maxlength="200"
                  :value="composer().dishes"
                  @input="setComposer('dishes', $event.target.value)"
                  class="px-4 py-3 mt-3 w-full text-[15px] rounded-[1rem]"
                  style="background: var(--paper); border: 1px solid var(--line)"
                >

                <p :if="composer().error" class="mt-3 text-[13px]" style="color: var(--accent)">{{ composer().error }}</p>

                <button @click="postReview()" class="px-5 py-2.5 mt-5 text-[14px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]" style="background: var(--ink); color: var(--paper)">
                  {{ t('place.review_post') }}
                </button>
              </div>
            </div>
          </section>
        </div>

        <aside class="lg:col-span-5">
          <div class="p-1.5 rounded-[2rem] lg:sticky lg:top-24" style="background: var(--paper-raised); box-shadow: 0 1px 2px rgba(20,17,15,0.04), 0 18px 36px -22px rgba(20,17,15,0.14)">
            <div class="p-7 rounded-[calc(2rem-0.375rem)]">
              <h2 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('business.hours') }}</h2>

              <dl class="mt-4 space-y-2 text-[14px]">
                @foreach (vm.week as day)
                  <div class="flex gap-6 justify-between">
                    <dt style="color: var(--ink-soft)">{{ day.name }}</dt>
                    <dd class="tabular-nums text-right">{{ day.text }}</dd>
                  </div>
                @endforeach
              </dl>

              @if (vm.fulfilment.length > 0)
                <div class="pt-6 mt-6 border-t" style="border-color: var(--line)">
                  <h3 class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('place.how_to_get') }}</h3>
                  <ul class="mt-3 space-y-1.5 text-[14px]" style="color: var(--ink-soft)">
                    @foreach (vm.fulfilment as option)
                      <li>{{ option }}</li>
                    @endforeach
                  </ul>
                </div>
              @endif
            </div>
          </div>
        </aside>
      </div>
    </main>

    {{-- One dish, opened to be configured.

      DoorDash and Uber Eats both put this in a sheet rather than expanding the
      row, and for the same reason: the choices for a burrito are longer than
      the row is tall, and pushing the rest of the menu down to make room loses
      the reader's place in it. --}}
    <Drawer
      :open="itemOpen()"
      @close="closeItem()"
      size="xl"
      panelStyle="background: var(--paper-raised); color: var(--ink)"
      backdropClass="bg-black/40"
    >
      <div :if="config()">
        <div class="cover flex overflow-hidden relative justify-center items-center -mt-6 h-44 rounded-[1.25rem]" :data-blur="config().item.photoBlur" style="--h: {{ vm.hue }}; --h2: {{ vm.hueEnd }}">
          <i class="cover-mark w-10 h-10" :class="config().item.iconClass"></i>
          <img class="cover-photo" :src="config().item.photo" alt="" decoding="async" width="400" height="280">
        </div>

        <h2 class="mt-5 text-[22px] font-semibold tracking-[-0.02em]">{{ config().item.name }}</h2>
        <p class="mt-2 text-[14px] leading-relaxed" style="color: var(--ink-soft)">{{ config().item.description }}</p>
        <p :if="config().item.allergens.length > 0" class="mt-2 text-[12px]" style="color: var(--ink-soft)">{{ allergenLine(config().item.allergens) }}</p>

        {{-- What has to be chosen, and what may be. --}}
        <div :for="group in config().item.groups" class="pt-5 mt-5 border-t" style="border-color: var(--line)">
          <p class="text-[13px] font-medium">
            {{ group.name }}
            <span class="ml-1 text-[12px]" style="color: var(--ink-soft)">{{ groupRule(group) }}</span>
          </p>
          <p :if="group.description" class="mt-1 text-[13px]" style="color: var(--ink-soft)">{{ group.description }}</p>

          <div class="flex flex-wrap gap-2 mt-3">
            <button
              :for="option in group.options"
              @click="toggleChoice(group, option.id)"
              class="px-3.5 py-2 text-[13px] rounded-full transition-all duration-500"
              :style="chosenIn(group.id, option.id) ? 'background: var(--ink); color: var(--paper)' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
            >{{ option.name }}{{ optionPrice(option) }}</button>
          </div>
        </div>

        {{-- A note to the kitchen.

          The order API has taken a per-line note all along and nothing ever
          sent one, so "no onions" had nowhere to go but a review. --}}
        <div class="pt-5 mt-5 border-t" style="border-color: var(--line)">
          <label class="text-[13px] font-medium" for="item-note">{{ t('cart.note_label') }}</label>
          <textarea
            id="item-note"
            rows="2"
            maxlength="300"
            placeholder="{{ t('cart.note_placeholder') }}"
            :value="config().note"
            @input="setConfig('note', $event.target.value)"
            class="px-4 py-3 mt-2 w-full text-[14px] rounded-[1rem] resize-none"
            style="background: var(--paper); border: 1px solid var(--line); color: var(--ink)"
          ></textarea>
        </div>

        <p :if="config().error" class="px-4 py-3 mt-4 text-[13px] rounded-2xl" style="background: var(--accent-soft); color: var(--accent)">{{ config().error }}</p>

        <div class="flex gap-3 items-center pt-5 mt-5 border-t" style="border-color: var(--line)">
          <div class="flex gap-1 items-center p-1 rounded-full shrink-0" style="border: 1px solid var(--line)">
            <button
              @click="setConfigQuantity(config().quantity - 1)"
              class="flex justify-center items-center w-8 h-8 rounded-full transition-all duration-500 active:scale-90"
              style="color: var(--ink-soft)"
              aria-label="{{ t('cart.remove_one') }}"
            >
              <i class="w-3.5 h-3.5 i-hugeicons-minus-sign"></i>
            </button>
            <span class="w-7 text-[15px] font-medium tabular-nums text-center">{{ config().quantity }}</span>
            <button
              @click="setConfigQuantity(config().quantity + 1)"
              class="flex justify-center items-center w-8 h-8 rounded-full transition-all duration-500 active:scale-90"
              style="color: var(--ink-soft)"
              aria-label="{{ t('cart.add_one') }}"
            >
              <i class="w-3.5 h-3.5 i-hugeicons-plus-sign"></i>
            </button>
          </div>

          <button
            @click="addConfigured()"
            class="flex flex-1 gap-3 justify-between items-center px-5 py-3 text-[14px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]"
            style="background: var(--accent); color: #fff"
          >
            <span>{{ t('cart.add_to_order') }}</span>
            <span class="tabular-nums">{{ configPrice() }}</span>
          </button>
        </div>
      </div>
    </Drawer>

    {{-- The order itself. --}}
    <Drawer
      :open="cartOpen()"
      @close="closeCart()"
      size="xl"
      panelStyle="background: var(--paper-raised); color: var(--ink)"
      backdropClass="bg-black/40"
    >
      {{-- After it is placed: what happens next, and paying for it. --}}
      <div :if="placed()">
        <h2 class="text-[22px] font-semibold tracking-[-0.02em]">{{ t('checkout.order_placed') }}</h2>
        <p class="mt-3 text-[14px] leading-relaxed" style="color: var(--ink-soft)">{{ placedBody(menu().business.name) }}</p>

        <p class="mt-6 text-[13px]" style="color: var(--ink-soft)">{{ t('order.total') }}</p>
        <p class="text-[30px] font-semibold tracking-[-0.03em] tabular-nums">{{ price(placed().pricing.totalCents) }}</p>

        <div :if="payment().configured === false" class="p-5 mt-6 rounded-[1.25rem]" style="background: var(--paper)">
          <p class="text-[12px] font-medium tracking-[0.16em] uppercase" style="color: var(--ink-soft)">{{ t('checkout.payment') }}</p>
          <p class="mt-2 text-[14px] leading-relaxed" style="color: var(--ink-soft)">{{ payment().reason }}</p>
        </div>

        <div :if="payment().configured" class="p-5 mt-6 rounded-[1.25rem]" style="background: var(--paper)">
          <p class="inline-block px-3 py-1 text-[10px] font-medium tracking-[0.2em] uppercase rounded-full" style="background: var(--accent-soft); color: var(--accent)">
            {{ t('checkout.stripe_test') }}
          </p>
          <p class="mt-3 text-[13px] leading-relaxed" style="color: var(--ink-soft)">{{ t('checkout.stripe_card') }}</p>

          <div id="card-element" class="p-4 mt-4 rounded-[1rem]" style="background: var(--paper-raised); border: 1px solid var(--line)"></div>

          <button @click="payNow()" class="px-5 py-2.5 mt-4 text-[14px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]" style="background: var(--accent); color: #fff">
            {{ t('checkout.pay_test_mode') }}
          </button>

          <p class="mt-3 text-[13px]" style="color: var(--ink-soft)">{{ payment().status }}</p>
        </div>

        <a
          :href="'/track?code=' + placed().trackingToken"
          class="inline-flex gap-3 items-center px-5 py-3 mt-6 text-[14px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] group"
          style="background: var(--ink); color: var(--paper)"
        >
          <span>{{ t('checkout.track_it') }}</span>
          <span class="flex justify-center items-center w-7 h-7 rounded-full transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5" style="background: rgba(255,255,255,0.14)">
            <i class="w-3.5 h-3.5 i-hugeicons-arrow-right-01"></i>
          </span>
        </a>
      </div>

      <div :if="!placed()">
        <h2 class="text-[22px] font-semibold tracking-[-0.02em]">{{ t('cart.your_order') }}</h2>
        <p class="mt-1 text-[13px]" style="color: var(--ink-soft)">{{ vm.name }}</p>

        <p :if="cartCount() === 0" class="mt-6 text-[14px]" style="color: var(--ink-soft)">{{ t('checkout.nothing_yet') }}</p>

        {{-- What is in it. --}}
        <ul :if="cartCount() > 0" class="mt-6 space-y-4">
          <li :for="line in cartLines()" class="flex gap-3 items-start">
            <div class="cover flex flex-none justify-center items-center w-14 h-14 rounded-[0.85rem]" :data-blur="line.photoBlur" style="--h: {{ vm.hue }}; --h2: {{ vm.hueEnd }}">
              <img class="cover-photo" :src="line.photo" alt="" decoding="async" width="400" height="280">
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex gap-3 justify-between items-baseline">
                <p class="text-[14px] font-medium">{{ line.name }}</p>
                <p class="text-[14px] tabular-nums shrink-0">{{ linePrice(line) }}</p>
              </div>

              <p :if="line.labels.length > 0" class="mt-0.5 text-[12px]" style="color: var(--ink-soft)">{{ line.labels.join(', ') }}</p>
              <p :if="line.notes" class="mt-0.5 text-[12px] italic" style="color: var(--ink-soft)">{{ line.notes }}</p>

              <div class="flex gap-3 items-center mt-2">
                <div class="flex gap-1 items-center p-0.5 rounded-full" style="border: 1px solid var(--line)">
                  <button
                    @click="setLineQuantity(line.index, line.quantity - 1)"
                    class="flex justify-center items-center w-6 h-6 rounded-full transition-all duration-500 active:scale-90"
                    style="color: var(--ink-soft)"
                    aria-label="{{ t('cart.remove_one') }}"
                  >
                    <i class="w-3 h-3 i-hugeicons-minus-sign"></i>
                  </button>
                  <span class="w-5 text-[13px] tabular-nums text-center">{{ line.quantity }}</span>
                  <button
                    @click="setLineQuantity(line.index, line.quantity + 1)"
                    class="flex justify-center items-center w-6 h-6 rounded-full transition-all duration-500 active:scale-90"
                    style="color: var(--ink-soft)"
                    aria-label="{{ t('cart.add_one') }}"
                  >
                    <i class="w-3 h-3 i-hugeicons-plus-sign"></i>
                  </button>
                </div>

                <button @click="removeLine(line.index)" class="text-[12px] transition-opacity duration-500 hover:opacity-60" style="color: var(--ink-soft)">
                  {{ t('checkout.remove') }}
                </button>
              </div>
            </div>
          </li>
        </ul>

        <div :if="cartCount() > 0">
          {{-- How they want it. --}}
          <div class="pt-5 mt-6 border-t" style="border-color: var(--line)">
            <p class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('cart.how') }}</p>
            <div class="flex flex-wrap gap-2 mt-3">
              <button
                :for="mode in fulfilmentChoices()"
                @click="setFulfilment(mode.value)"
                class="px-4 py-2 text-[13px] rounded-full transition-all duration-500"
                :style="checkout().fulfilment === mode.value ? 'background: var(--ink); color: var(--paper)' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
              >{{ mode.label }}</button>
            </div>
          </div>

          {{-- Only for delivery. An address field on a pickup order is a
            question with no reason behind it. --}}
          <div :if="checkout().fulfilment === 'delivery'" class="pt-5 mt-5 border-t" style="border-color: var(--line)">
            <p class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('checkout.deliver_to') }}</p>

            <div :if="addresses().length > 0" class="flex flex-wrap gap-2 mt-3">
              <button
                :for="address in addresses()"
                @click="chooseAddress(address)"
                class="px-3.5 py-2 text-[13px] rounded-full transition-all duration-500"
                :style="checkout().address && checkout().address.id === address.id ? 'background: var(--ink); color: var(--paper)' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
              >{{ address.label }} · {{ address.line }}</button>
            </div>

            <input
              placeholder="{{ t('checkout.street_number') }}"
              maxlength="255"
              :value="checkout().addressLine"
              @input="setCheckout('addressLine', $event.target.value)"
              class="px-4 py-3 mt-3 w-full text-[14px] rounded-[1rem]"
              style="background: var(--paper); border: 1px solid var(--line); color: var(--ink)"
            >

            <div class="flex flex-wrap gap-2 items-center mt-2">
              <input
                placeholder="{{ t('checkout.label_it') }}"
                maxlength="40"
                :value="checkout().addressLabel"
                @input="setCheckout('addressLabel', $event.target.value)"
                class="px-4 py-2.5 flex-1 min-w-[140px] text-[13px] rounded-full"
                style="background: var(--paper); border: 1px solid var(--line); color: var(--ink)"
              >
              <button @click="saveAddress()" class="px-4 py-2.5 text-[13px] rounded-full transition-all duration-500" style="border: 1px solid var(--line); color: var(--ink-soft)">{{ t('checkout.save_it') }}</button>
            </div>

            <p :if="checkout().addressError" class="mt-2 text-[13px]" style="color: var(--accent)">{{ checkout().addressError }}</p>
          </div>

          {{-- A note for the whole order, alongside the per-dish ones. --}}
          <div class="pt-5 mt-5 border-t" style="border-color: var(--line)">
            <label class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)" for="order-note">{{ t('cart.order_note') }}</label>
            <textarea
              id="order-note"
              rows="2"
              maxlength="500"
              placeholder="{{ t('cart.order_note_placeholder') }}"
              :value="checkout().note"
              @input="setCheckout('note', $event.target.value)"
              class="px-4 py-3 mt-2 w-full text-[14px] rounded-[1rem] resize-none"
              style="background: var(--paper); border: 1px solid var(--line); color: var(--ink)"
            ></textarea>
          </div>

          <div class="pt-5 mt-5 border-t" style="border-color: var(--line)">
            <p class="text-[12px] font-medium tracking-[0.18em] uppercase" style="color: var(--ink-soft)">{{ t('order.tip') }}</p>
            <div class="flex flex-wrap gap-2 mt-3">
              <button
                :for="option in tipChoices()"
                @click="setTip(option.cents)"
                class="px-3.5 py-2 text-[13px] rounded-full transition-all duration-500"
                :style="checkout().tipCents === option.cents ? 'background: var(--ink); color: var(--paper)' : 'border: 1px solid var(--line); color: var(--ink-soft)'"
              >{{ option.label }}</button>
            </div>
          </div>

          <p :if="cartError()" class="px-4 py-3 mt-5 text-[13px] rounded-2xl" style="background: var(--accent-soft); color: var(--accent)">{{ cartError() }}</p>

          {{-- Every number here came from the server. --}}
          <dl :if="quote()" class="pt-5 mt-5 space-y-2 text-[14px] border-t" style="border-color: var(--line)">
            <div class="flex justify-between">
              <dt style="color: var(--ink-soft)">{{ t('order.subtotal') }}</dt>
              <dd class="tabular-nums">{{ price(quote().subtotalCents) }}</dd>
            </div>
            <div :if="quote().deliveryFeeCents" class="flex justify-between">
              <dt style="color: var(--ink-soft)">{{ t('order.delivery_fee') }}</dt>
              <dd class="tabular-nums">{{ price(quote().deliveryFeeCents) }}</dd>
            </div>
            <div class="flex justify-between">
              <dt style="color: var(--ink-soft)">{{ t('order.service_fee') }}</dt>
              <dd class="tabular-nums">{{ price(quote().serviceFeeCents) }}</dd>
            </div>
            <div class="flex justify-between">
              <dt style="color: var(--ink-soft)">{{ t('order.tax') }}</dt>
              <dd class="tabular-nums">{{ price(quote().taxCents) }}</dd>
            </div>
            <div :if="quote().tipCents" class="flex justify-between">
              <dt style="color: var(--ink-soft)">{{ t('order.tip') }}</dt>
              <dd class="tabular-nums">{{ price(quote().tipCents) }}</dd>
            </div>
            <div class="flex justify-between pt-3 text-[16px] font-semibold border-t" style="border-color: var(--line)">
              <dt>{{ t('order.total') }}</dt>
              <dd class="tabular-nums">{{ price(quote().totalCents) }}</dd>
            </div>
          </dl>

          <button
            :if="quote()"
            @click="placeOrder()"
            class="flex gap-3 justify-center items-center px-5 py-3.5 mt-6 w-full text-[14px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]"
            style="background: var(--accent); color: #fff"
          >{{ t('order.place_order') }}</button>

          <p :if="quote()" class="mt-3 mb-2 text-[11px] text-center" style="color: var(--ink-soft)">{{ t('checkout.test_mode') }}</p>
        </div>
      </div>
    </Drawer>

    {{-- The basket, always within reach.

      Fixed rather than in the flow, because the menu is the length of a menu
      and a basket you have to scroll back up to is one people lose track of.
      Hidden while it is empty: there is nothing to look at, and nothing to
      press. --}}
    <button
      :if="cartCount() > 0 && !cartOpen() && !placed()"
      @click="openCart()"
      class="flex fixed right-4 bottom-4 z-40 gap-3 items-center px-5 py-3.5 text-[14px] font-medium rounded-full transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] sm:right-8 sm:bottom-8"
      style="background: var(--ink); color: var(--paper); box-shadow: 0 8px 30px -8px rgba(20,17,15,0.45)"
    >
      <span class="flex justify-center items-center px-2 h-6 min-w-6 text-[12px] font-semibold tabular-nums rounded-full" style="background: rgba(255,255,255,0.18)" :text="cartCount()"></span>
      <span>{{ t('cart.your_order') }}</span>
      <span :if="quote()" class="tabular-nums" style="opacity: .75">{{ price(quote().totalCents) }}</span>
    </button>

    @include('footer')
