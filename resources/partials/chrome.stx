{{-- The nav and the demo banner, on every page.

  The banner is not decoration. This site lists real businesses next to
  invented menus, reviews and prices, and takes payment details that go to
  Stripe's sandbox. Anyone who lands here deserves to know that in the first
  second, before they read a review of a restaurant they might actually visit.
  It sits above the fold, states plainly which half is real, and can be
  dismissed for the session but not turned off. --}}

<div class="sticky top-0 z-40 border-b backdrop-blur-xl" style="border-color: var(--line); background: color-mix(in srgb, var(--paper) 82%, transparent);">
  <div class="mx-auto px-4 sm:px-8 max-w-7xl">
    <div class="flex gap-3 justify-between items-center py-3 text-[13px] leading-snug">
      <p class="flex gap-2.5 items-start" style="color: var(--ink-soft)">
        <span class="mt-0.5 inline-flex shrink-0 items-center justify-center h-5 w-5 rounded-full" style="background: var(--accent-soft); color: var(--accent)">
          <i class="w-3 h-3 i-hugeicons-information-circle"></i>
        </span>
        <span data-i18n="demo.banner">
          <strong style="color: var(--ink)">A demonstration.</strong>
          The places are real. The menus, reviews, orders and payments are not, and nothing here can be bought.
        </span>
      </p>
    </div>
  </div>
</div>

<header class="mx-auto px-4 sm:px-8 pt-8 max-w-7xl">
  <nav class="flex gap-6 justify-between items-center">
    <a href="/" class="group inline-flex gap-2.5 items-center">
      <span class="inline-flex justify-center items-center w-9 h-9 rounded-full transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-105" style="background: var(--accent)">
        <i class="w-4 h-4 text-white i-hugeicons-location-01"></i>
      </span>
      <span class="text-[19px] font-semibold tracking-[-0.02em]">Smakelo</span>
    </a>

    <div class="hidden gap-8 items-center text-[14px] sm:flex" style="color: var(--ink-soft)">
      <a href="/" data-i18n="nav.discover" class="transition-colors duration-500 hover:opacity-70">Discover</a>
      <a href="/orders" data-i18n="nav.orders" class="transition-colors duration-500 hover:opacity-70">Orders</a>
      <a href="/saved" data-i18n="nav.favorites" class="transition-colors duration-500 hover:opacity-70">Saved</a>
      <a href="/shares" data-i18n="nav.shares" class="transition-colors duration-500 hover:opacity-70">Shares</a>
      <a href="/partner" data-i18n="nav.partner" class="transition-colors duration-500 hover:opacity-70">For businesses</a>
      <a href="/about" data-i18n="nav.about" class="transition-colors duration-500 hover:opacity-70">About this demo</a>

      {{-- Three languages, named in their own. A flag would be wrong: German is
        not Germany, and Dutch is not only the Netherlands. --}}
      <div class="flex gap-1 items-center pl-1 text-[12px]" id="lang-switch">
        <a href="?lang=en" data-lang="en" class="px-3 py-2 rounded-full transition-all duration-500">EN</a>
        <a href="?lang=de" data-lang="de" class="px-3 py-2 rounded-full transition-all duration-500">DE</a>
        <a href="?lang=nl" data-lang="nl" class="px-3 py-2 rounded-full transition-all duration-500">NL</a>
      </div>
    </div>
  </nav>
</header>

<script>
  /* Mark the language in use, so the switcher says where you are. */
  ;(function () {
    try {
      const current = (window.Smakelo && window.Smakelo.locale) || 'en'

      for (const link of document.querySelectorAll('#lang-switch [data-lang]')) {
        const on = link.dataset.lang === current

        link.style.background = on ? 'var(--ink)' : 'transparent'
        link.style.color = on ? 'var(--paper)' : 'var(--ink-soft)'
        link.setAttribute('aria-current', on ? 'true' : 'false')
      }
    }
    catch {}
  })()
</script>
