<script server>
/*
 * The head imports what it uses.
 *
 * A partial inherits the including page's scope, and this one leaned on it
 * for `t` and `currentLocale` - which made every page responsible for
 * importing something only the head needs, and a page that forgot shipped a
 * bundle of key names to its own scripts. `pageTitle` and the rest still come
 * from the page, because those are the page's to decide.
 */
import { currentLocale, t } from '../../app/Actions/Locale/translate'
</script>

{{-- Shared <head> for every Smakelo page.

  Partials inherit the including page's scope, so a page sets pageTitle,
  pageDescription and canonicalPath in its own <script server> and this reads
  them. --}}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ pageDescription }}">
<title>{{ pageTitle }}</title>

{{-- Nothing here may be indexed. The listings name real Los Angeles businesses
  and sit beside invented reviews, menus and prices; a search result putting
  that fiction in front of somebody looking for the real restaurant is the one
  outcome this demo must not have. Belt and braces with /robots.txt, which
  disallows everything. --}}
<meta name="robots" content="noindex, nofollow, noarchive, noimageindex">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0c0b0a" media="(prefers-color-scheme: dark)">

{{-- Geist for everything. Preconnect so the first paint is not waiting on
  a font handshake. --}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

{{-- Cover photography is served from Unsplash's image CDN, one host for every
  card on the page, so the handshake is worth getting out of the way early. --}}
<link rel="preconnect" href="https://images.unsplash.com" crossorigin>

{{-- Map tiles, likewise. Only the pages with a map pay for the tiles, but the
  handshake is cheap and the map is the slowest thing on the page it is on. --}}
<link rel="preconnect" href="https://basemaps.cartocdn.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&display=swap">

{{-- The map's own stylesheet, which positions its tiles and panes. Linked
  here rather than imported by the pages that use a map: `import
  'ts-maps/styles.css'` from a `<script client>` resolves and is then dropped
  by the views build, so those rules never reached the page at all. Loaded on
  every page for one stylesheet's worth of bytes, which is cheaper than three
  pages each forgetting it. See resources/assets/styles/ts-maps.css. --}}
<link rel="stylesheet" href="/assets/styles/ts-maps.css">

<style>
  :root {
    --ink: #14110f;
    --ink-soft: #5c534c;
    --paper: #faf9f7;
    --paper-raised: #ffffff;
    --line: rgba(20, 17, 15, 0.08);
    /* Warmed and brightened a little. The old burnt orange sat back on a page
       that is mostly cream, so the one colour meant to lead the eye - the save
       heart, the price bars, the primary button - read as another brown. This
       still belongs beside the photographs rather than shouting over them. */
    --accent: #d1541f;
    --accent-soft: #fbe9df;

    /* A second, cooler accent for things that are information rather than
       action: distances, times, counts. Reaching for the orange on those made
       every one of them look like something to press. */
    --info: #2f6f6b;
    --info-soft: #e2f0ee;

    /* The rating green. A separate hue from the accent on purpose: a rating is
       a fact about a place, and painting it in the brand colour makes it read
       as something the site is claiming rather than something it is
       reporting. */
    --mint: #dcf2e7;
    --mint-ink: #0d8055;

    /* Selected controls invert. Two names rather than reusing --ink/--paper so
       dark mode can swap them without every rule needing to know. */
    --sel: #14110f;
    --sel-ink: #ffffff;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #f5f2ef;
      --ink-soft: #a89f97;
      --paper: #0c0b0a;
      --paper-raised: #171513;
      --line: rgba(245, 242, 239, 0.10);
      --accent: #f0854f;
      --accent-soft: rgba(240, 133, 79, 0.16);

      --info: #7fc9c2;
      --info-soft: rgba(127, 201, 194, 0.14);

      /* The chip keeps its light ground in the dark: it is a small bright
         token, and inverting it turns the one green thing on the card into
         another grey rectangle. */
      --mint: #d3efe2;
      --mint-ink: #0a6b47;

      --sel: #f5f2ef;
      --sel-ink: #14110f;
    }
  }

  html { -webkit-text-size-adjust: 100%; }

  body {
    font-family: Geist, ui-sans-serif, system-ui, sans-serif;
    background: var(--paper);
    color: var(--ink);
    font-feature-settings: 'cv11', 'ss01';
    -webkit-font-smoothing: antialiased;
  }

  /* Cards rise as they enter the viewport.

     Done with a scroll-driven animation rather than an IntersectionObserver,
     which is a deliberate retreat: the observer version hid every card up front
     and revealed them from script, so the one time the client bundle failed to
     evaluate, the page served a 200 with an empty grid and said nothing about
     it. Here the animation is the only thing that can go missing. A browser
     without `animation-timeline` support runs the @supports block not at all,
     the cards never animate, and the page is simply a page. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .reveal {
        animation: rise-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --- The map -------------------------------------------------------------

     The one place a third-party stylesheet paints, so it gets the app's
     radius, hairline and buttons rather than the library's defaults. */
  .tsmap-container { background: var(--paper-raised); }

  /* Nothing is filtered on top of the basemap.

     It used to be: the map was somebody else's raster, so light mode
     desaturated it to stop it fighting the photographs and dark mode inverted
     it, because inverting was the only way to get a dark map out of a light
     picture. The tiles are vector now and draw themselves from a palette per
     theme, so a filter here does not adjust the map - it corrupts it. Left in
     place, the dark rule turned an already-dark map light again, which read
     exactly like the palette being ignored.

     See resources/functions/basemap-style.ts for the colours. */

  /* --- Markers --------------------------------------------------------------

     Two shapes, because the two maps ask different questions.

     A results map answers "where are they", and sixty teardrops over a city is
     a wall of identical shapes with no information in any of them. A dot
     carries the one distinction that changes what you can do when you arrive:
     filled means the place takes orders, hollow means it can only be read
     about.

     A place page answers "where is this one", and there a dot is too shy - it
     reads as a smudge on the map rather than as the answer to the only
     question the map is there for. So that gets a pin: a shape with a point,
     which says *here* rather than *hereabouts*.

     The wrapper is the library's positioned box and must stay unstyled; the
     span inside is ours. */
  .pin-wrap { background: none; border: none; }

  .pin {
    display: block;
    width: 14px;
    height: 14px;
    margin: 2px;
    border-radius: 999px;
    background: var(--paper-raised);
    border: 2.5px solid var(--ink);
    box-shadow: 0 1px 4px rgba(20, 17, 15, 0.35);
    transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .pin-partner {
    background: var(--accent);
    border-color: var(--paper-raised);
  }

  .pin-wrap:hover .pin,
  .pin-wrap:focus-visible .pin { transform: scale(1.35); }

  /* A teardrop: a circle with one corner squared off, turned 45°, so the
     square corner becomes the point. The inner dot is counter-rotated to sit
     upright, because a rotated hole reads as a mistake.

     Both parts are placed against the icon box rather than left in flow, and
     the numbers are not arbitrary: a 26px square turned 45° is 36.8px across
     its diagonal, so it hangs 5.4px below where an unrotated one would end.
     `top: 6px` in a 38px box puts the point on the bottom edge, which is where
     the marker is anchored - and the anchor is what the map treats as the
     coordinate. Centre it instead and the pin points half its own height up
     the street. */
  .pin-marker {
    position: absolute;
    left: 50%;
    top: 6px;
    display: block;
    width: 26px;
    height: 26px;
    border-radius: 999px 999px 999px 2px;
    transform: translateX(-50%) rotate(45deg);
    background: var(--accent);
    border: 2px solid var(--paper-raised);
    box-shadow: 0 3px 10px rgba(20, 17, 15, 0.4);
  }

  .pin-marker::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--paper-raised);
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* The ground it stands on. Without it the pin floats: a point touching a
     street is ambiguous about which side of the street it means. */
  .pin-shadow {
    position: absolute;
    left: 50%;
    bottom: 0;
    display: block;
    width: 12px;
    height: 4px;
    border-radius: 999px;
    background: rgba(20, 17, 15, 0.28);
    filter: blur(1.5px);
    transform: translateX(-50%);
  }

  /* The icon box the two sit in. The library positions this; everything above
     is placed against it. */
  .pin-wrap:has(.pin-marker) { position: relative; }

  /* The popup is a small card, so it is built out of the same parts as the
     large ones rather than the library's white box with a tail. */
  .tsmap-popup-content-wrapper,
  .tsmap-popup-tip {
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow: 0 2px 10px rgba(20, 17, 15, 0.18);
  }

  .tsmap-popup-content-wrapper { border-radius: 14px; }

  .tsmap-popup-content {
    margin: 12px 14px;
    font-size: 13px;
    line-height: 1.5;
  }

  .tsmap-popup-content a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .tsmap-popup-content a:hover { text-decoration: underline; }

  /* --- Covers --------------------------------------------------------------

     A cover is a photograph laid over a coloured ground. The ground is the
     part that always renders: the hue arrives as a custom property, so the
     markup carries two numbers rather than a whole gradient and light and dark
     can light it differently without the server knowing which one is on. It
     shows through while the photograph decodes, and it is what remains if the
     photograph never arrives - a coloured tile with a monogram on it, rather
     than a broken-image glyph.

     See app/Actions/Business/imagery.ts for which photograph a business gets
     and why the library is curated by hand.

     Every cover image is `alt=""`. The photograph is stock - of the kind of
     food the place serves, not of the place - so an alt of the business name
     would tell a screen-reader user it is a picture of that business, which is
     the same fabrication the reviews guard draws a line at. The name is in the
     heading beside it either way, so there is nothing to lose by going quiet
     here. */
  .cover {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 22% 26%, hsl(var(--h) 78% 93% / 0.95), transparent 58%),
      linear-gradient(140deg, hsl(var(--h) 62% 88%), hsl(var(--h2) 54% 78%));
  }

  /* A faint grid, so a flat gradient reads as a surface rather than a swatch. */
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(hsl(var(--h) 40% 30% / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--h) 40% 30% / 0.05) 1px, transparent 1px);
    background-size: 22px 22px;
    pointer-events: none;
  }

  .cover-photo {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Fades in on decode rather than snapping, so a grid of sixty does not
       flicker its way down the page as each one lands. */
    opacity: 0;
    transition: opacity 700ms cubic-bezier(0.32, 0.72, 0, 1), transform 700ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .cover-photo[data-loaded] { opacity: 1; }

  /* A broken or blocked image leaves the ground and the monogram, which is
     already a complete cover. Without this the browser draws its own alt
     placeholder on top of them. */
  .cover-photo[data-failed] { display: none; }

  .group:hover .cover-photo { transform: scale(1.04); }

  /* Badges sit on the photograph, and a photograph is not a known colour.
     A scrim under them is cheaper than measuring the pixels behind. */
  .cover-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.28), rgba(0, 0, 0, 0) 38%, rgba(0, 0, 0, 0) 62%, rgba(0, 0, 0, 0.34));
  }

  .cover-mark { color: hsl(var(--h) 46% 26%); }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .cover {
      background:
        radial-gradient(circle at 22% 26%, hsl(var(--h) 42% 30% / 0.9), transparent 58%),
        linear-gradient(140deg, hsl(var(--h) 34% 22%), hsl(var(--h2) 30% 16%));
    }

    :root:not([data-theme='light']) .cover::after {
      background-image:
        linear-gradient(hsl(var(--h) 60% 80% / 0.05) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--h) 60% 80% / 0.05) 1px, transparent 1px);
    }

    :root:not([data-theme='light']) .cover-mark { color: hsl(var(--h) 60% 82%); }
  }

  /* --- Stars ---------------------------------------------------------------

     A rating is the first thing anybody reads on a listing, and "4.5" is a
     number while ★★★★½ is a judgement. Drawn as a clipped overlay rather than
     as five separate glyphs, so a 4.3 is actually 4.3 wide instead of being
     rounded to the nearest half by the markup. */
  .stars {
    position: relative;
    display: inline-block;
    color: var(--line);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .stars > span {
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: var(--accent);
  }

  /* --- The discover surface ------------------------------------------------

     Filters, map and results. One grid, three named areas, and a data
     attribute for the map switch so the toggle is a single attribute write
     rather than three class lists kept in step.

     The breakpoints do the responsive work rather than inline styles, because
     the map switch and the viewport both want a say in the column count and
     only CSS can hear both. */
  .discover {
    display: grid;
    gap: 20px;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .discover { grid-template-columns: 248px minmax(0, 1fr); }

    /* The rail and the map hold still; the results are the only thing that
       scrolls, which is what makes filtering feel like it happens to the list
       rather than to the page. */
    .discover-rail,
    .discover-map {
      position: sticky;
      top: 24px;
    }

    .discover-map { height: calc(100vh - 190px); min-height: 460px; }
  }

  /* Below this the map would be a letterbox between two full-width columns,
     so it keeps its own row and the results run under both. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .discover[data-map='on'] .discover-map { grid-column: 2; }
    .discover[data-map='on'] .discover-list { grid-column: 2; }
  }

  @media (min-width: 1280px) {
    .discover[data-map='on'] { grid-template-columns: 248px minmax(0, 1fr) 340px; }
    .discover[data-map='off'] { grid-template-columns: 248px minmax(0, 1fr); }

    .discover[data-map='on'] .discover-list {
      position: sticky;
      top: 24px;
      max-height: calc(100vh - 190px);
      overflow-y: auto;
      scrollbar-width: thin;
    }
  }

  .discover-map[hidden] { display: none; }

  /* On a phone the map sits between the filters and the results, at a height
     that is a map rather than a strip - and proportional to the screen, since
     340px is half a small phone and a quarter of a large one. Capped so it
     never pushes the first result off the bottom. */
  .discover-map { height: min(58vh, 420px); }

  .discover-results {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }

  /* With the map on, the results are a single narrow column beside it. With it
     off they are the whole width and go back to being a grid. */
  @media (min-width: 640px) {
    .discover[data-map='off'] .discover-results { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 1280px) {
    .discover[data-map='off'] .discover-results { grid-template-columns: repeat(3, 1fr); }
  }

  /* Cuisine and price fold away on a phone: four hundred pixels of controls
     above the first result is a filter panel wearing the page as a hat. */
  .rail-more { display: none; }
  .discover[data-more='on'] .rail-more { display: flex; }

  @media (min-width: 1024px) {
    .rail-more { display: flex; }
    .rail-toggle { display: none; }
  }

  /* The price slider, drawn rather than left to the browser: the native track
     is a different shape and colour in every engine, and this one sits
     directly under a histogram it has to line up with. */
  .price-range {
    -webkit-appearance: none;
    appearance: none;
    height: 20px;
    background: transparent;
    cursor: pointer;
  }

  .price-range::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 999px;
    background: var(--line);
  }

  .price-range::-moz-range-track {
    height: 4px;
    border-radius: 999px;
    background: var(--line);
  }

  .price-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    margin-top: -6px;
    border: none;
    border-radius: 999px;
    background: var(--sel);
    box-shadow: 0 1px 4px rgba(20, 17, 15, 0.3);
  }

  .price-range::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: none;
    border-radius: 999px;
    background: var(--sel);
    box-shadow: 0 1px 4px rgba(20, 17, 15, 0.3);
  }

  /* --- Filter controls -----------------------------------------------------

     The vocabulary the discover rail is built from: a section heading, a pill,
     a checkbox, a segment, a switch. Written once here rather than as utility
     soup at each call site, because there are five of them on one screen and
     they have to agree about radius, height and what "selected" looks like.

     Selected is an inversion in every one of them - the control takes the ink
     colour and its label goes to paper. That is a single idea the eye learns
     once, and --sel/--sel-ink let dark mode flip it without any rule below
     mentioning a colour. */

  /* "Map View", "Price Range": the noun in full weight, the qualifier lighter.
     One heading that reads as two words rather than a label shouting twice.

     An optional icon in front, at the muted weight, so a column of headings
     can be found by shape before it is read. It sits in the flow rather than
     absolutely, so a heading that wraps keeps its icon on the first line. */
  .rail-head {
    display: flex;
    gap: 7px;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .rail-head span {
    font-weight: 400;
    color: var(--ink-soft);
  }

  .rail-head > i {
    flex: none;
    width: 15px;
    height: 15px;
    color: var(--ink-soft);
  }

  /* A meta row: a small icon and a value, repeated. Used on the cards for the
     time and the fee, where two bare numbers separated by a dot needed reading
     to tell apart and two icons do not. */
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: center;
    font-size: 13px;
    color: var(--ink-soft);
  }

  .meta-row > span {
    display: inline-flex;
    gap: 5px;
    align-items: center;
  }

  .meta-row i {
    flex: none;
    width: 13px;
    height: 13px;
    opacity: 0.75;
  }

  .pill {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 500;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    color: var(--ink);
    cursor: pointer;
    transition: background 400ms cubic-bezier(0.32, 0.72, 0, 1), color 400ms cubic-bezier(0.32, 0.72, 0, 1), border-color 400ms;
  }

  .pill:hover { border-color: color-mix(in srgb, var(--ink) 22%, transparent); }

  .pill[aria-pressed='true'] {
    background: var(--sel);
    color: var(--sel-ink);
    border-color: var(--sel);
  }

  /* A rounded square rather than a tick in a circle, because it sits at the end
     of a text row and a circle there reads as a radio - one of these, not any
     of these. */
  .check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 9px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    color: transparent;
    cursor: pointer;
    transition: background 300ms, color 300ms, border-color 300ms;
  }

  .check[aria-pressed='true'] {
    background: var(--sel);
    border-color: var(--sel);
    color: var(--sel-ink);
  }

  /* The tick is a character rather than an icon: the set has no bare
     checkmark, only ones already inside a circle or a square, and this one is
     already in a square of its own. */
  .check {
    font-size: 14px;
    line-height: 1;
  }

  /* The map's follow toggle carries an accent check rather than an ink one -
     it is the only control that changes what the map means rather than what
     the list contains. */
  .follow-check[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* The cuisine list is longer than its box on purpose: a hard bottom edge
     says "that is all of them", and a fade says "there is more, scroll".
     Masked rather than faded to a background colour so it works on both
     themes without knowing which is on. */
  .fade-list {
    overflow-y: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(to bottom, #000 0, #000 calc(100% - 34px), transparent 100%);
  }

  .fade-list::-webkit-scrollbar { display: none; }

  /* Star rating: four buttons that behave as one control, so they are drawn as
     one strip with shared borders rather than four loose pills. */
  .seg {
    display: flex;
    gap: 8px;
  }

  .seg > button {
    flex: 1;
    padding: 10px 0;
    font-size: 13px;
    font-weight: 500;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    cursor: pointer;
    transition: background 300ms, color 300ms, border-color 300ms;
  }

  .seg > button[aria-pressed='true'] {
    background: var(--sel);
    color: var(--sel-ink);
    border-color: var(--sel);
  }

  /* The one control that is accent-coloured rather than ink: it turns a whole
     pane of the layout on and off, which is a bigger thing than a filter. */
  .switch {
    position: relative;
    width: 46px;
    height: 26px;
    flex: none;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: var(--line);
    cursor: pointer;
    transition: background 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .switch::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--paper-raised);
    box-shadow: 0 1px 3px rgba(20, 17, 15, 0.28);
    transition: transform 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .switch[aria-pressed='true'] { background: var(--accent); }
  .switch[aria-pressed='true']::after { transform: translateX(20px); }

  /* --- Rating chip ---------------------------------------------------------

     The number, once, in green, on the card and in the map popup. The five
     drawn stars stay on the place page where there is room to read them; in a
     list of sixteen results they are sixteen rows of identical glyphs and the
     only part anybody scans is the digit. */
  .rating-chip {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    padding: 3px 8px 3px 6px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 8px;
    background: var(--mint);
    color: var(--mint-ink);
  }

  /* --- Save -----------------------------------------------------------------

     Sits on the photograph, so it carries its own ground. Unsaved is a white
     disc with a hollow heart; saved fills with the accent. */
  .save {
    position: absolute;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: none;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    color: var(--ink);
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(20, 17, 15, 0.18);
    transition: transform 400ms cubic-bezier(0.32, 0.72, 0, 1), background 300ms, color 300ms;
  }

  .save:hover { transform: scale(1.08); }
  .save[aria-pressed='true'] { background: var(--accent); color: #fff; }

  /* --- Map furniture -------------------------------------------------------

     Zoom, locate and the follow-the-map toggle are ours rather than the
     library's, so they match the buttons everywhere else on the page. They
     float over the canvas, which is a photograph of a city and not a known
     colour, so each one carries an opaque ground and a shadow. */
  .map-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: none;
    background: var(--paper-raised);
    color: var(--ink);
    cursor: pointer;
    transition: background 300ms;
  }

  .map-btn:hover { background: color-mix(in srgb, var(--ink) 6%, var(--paper-raised)); }

  .map-stack {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 2px 10px rgba(20, 17, 15, 0.18);
  }

  .map-stack > .map-btn + .map-btn { border-top: 1px solid var(--line); }

  .map-solo {
    border-radius: 12px;
    box-shadow: 0 2px 10px rgba(20, 17, 15, 0.18);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; filter: none; transition: none; }
    * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
</style>

{{-- Icon safelist.

  Crosswind generates an icon's CSS by finding the class as a literal in the
  source. Cards and category tiles build theirs at runtime from the business's
  cuisine (`'i-hugeicons-' + card.icon`), which no scanner can see, so every
  such class is written out once here. Without this the markup is correct, the
  class is applied, and the icon is simply invisible.

  Kept in the head partial so one list covers every page that renders a card. --}}
<div hidden aria-hidden="true">
  <i class="i-hugeicons-restaurant-01"></i><i class="i-hugeicons-coffee-01"></i>
  <i class="i-hugeicons-plant-01"></i><i class="i-hugeicons-bread-01"></i>
  <i class="i-hugeicons-shopping-basket-01"></i><i class="i-hugeicons-drink"></i>
