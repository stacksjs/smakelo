{{-- Shared <head> for every Smakelo page.

  Partials inherit the including page's scope, so a page sets pageTitle,
  pageDescription and canonicalPath in its own <script server> and this reads
  them. --}}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ pageDescription }}">
<title>{{ pageTitle }}</title>

{{-- Nothing here may be indexed. The listings name real Los Angeles businesses
  and sit beside invented reviews, menus and prices; a search result putting
  that fiction in front of somebody looking for the real restaurant is the one
  outcome this demo must not have. Belt and braces with /robots.txt, which
  disallows everything. --}}
<meta name="robots" content="noindex, nofollow, noarchive, noimageindex">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0c0b0a" media="(prefers-color-scheme: dark)">

{{-- Geist for everything. Preconnect so the first paint is not waiting on
  a font handshake. --}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

{{-- Cover photography is served from Unsplash's image CDN, one host for every
  card on the page, so the handshake is worth getting out of the way early. --}}
<link rel="preconnect" href="https://images.unsplash.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&display=swap">

<style>
  :root {
    --ink: #14110f;
    --ink-soft: #5c534c;
    --paper: #faf9f7;
    --paper-raised: #ffffff;
    --line: rgba(20, 17, 15, 0.08);
    --accent: #b4532a;
    --accent-soft: #f3e6df;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #f5f2ef;
      --ink-soft: #a89f97;
      --paper: #0c0b0a;
      --paper-raised: #171513;
      --line: rgba(245, 242, 239, 0.10);
      --accent: #e0794a;
      --accent-soft: rgba(224, 121, 74, 0.14);
    }
  }

  html { -webkit-text-size-adjust: 100%; }

  body {
    font-family: Geist, ui-sans-serif, system-ui, sans-serif;
    background: var(--paper);
    color: var(--ink);
    font-feature-settings: 'cv11', 'ss01';
    -webkit-font-smoothing: antialiased;
  }

  /* Cards rise as they enter the viewport.

     Done with a scroll-driven animation rather than an IntersectionObserver,
     which is a deliberate retreat: the observer version hid every card up front
     and revealed them from script, so the one time the client bundle failed to
     evaluate, the page served a 200 with an empty grid and said nothing about
     it. Here the animation is the only thing that can go missing. A browser
     without `animation-timeline` support runs the @supports block not at all,
     the cards never animate, and the page is simply a page. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .reveal {
        animation: rise-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* The map is the one place a third-party stylesheet paints, so it gets the
     app's radius and hairline rather than the library's defaults. */
  .tsmap-container { background: var(--paper-raised); }

  /* --- Covers --------------------------------------------------------------

     A cover is a photograph laid over a coloured ground. The ground is the
     part that always renders: the hue arrives as a custom property, so the
     markup carries two numbers rather than a whole gradient and light and dark
     can light it differently without the server knowing which one is on. It
     shows through while the photograph decodes, and it is what remains if the
     photograph never arrives - a coloured tile with a monogram on it, rather
     than a broken-image glyph.

     See app/Actions/Business/imagery.ts for which photograph a business gets
     and why the library is curated by hand.

     Every cover image is `alt=""`. The photograph is stock - of the kind of
     food the place serves, not of the place - so an alt of the business name
     would tell a screen-reader user it is a picture of that business, which is
     the same fabrication the reviews guard draws a line at. The name is in the
     heading beside it either way, so there is nothing to lose by going quiet
     here. */
  .cover {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 22% 26%, hsl(var(--h) 78% 93% / 0.95), transparent 58%),
      linear-gradient(140deg, hsl(var(--h) 62% 88%), hsl(var(--h2) 54% 78%));
  }

  /* A faint grid, so a flat gradient reads as a surface rather than a swatch. */
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(hsl(var(--h) 40% 30% / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--h) 40% 30% / 0.05) 1px, transparent 1px);
    background-size: 22px 22px;
    pointer-events: none;
  }

  .cover-photo {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Fades in on decode rather than snapping, so a grid of sixty does not
       flicker its way down the page as each one lands. */
    opacity: 0;
    transition: opacity 700ms cubic-bezier(0.32, 0.72, 0, 1), transform 700ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .cover-photo[data-loaded] { opacity: 1; }

  /* A broken or blocked image leaves the ground and the monogram, which is
     already a complete cover. Without this the browser draws its own alt
     placeholder on top of them. */
  .cover-photo[data-failed] { display: none; }

  .group:hover .cover-photo { transform: scale(1.04); }

  /* Badges sit on the photograph, and a photograph is not a known colour.
     A scrim under them is cheaper than measuring the pixels behind. */
  .cover-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.28), rgba(0, 0, 0, 0) 38%, rgba(0, 0, 0, 0) 62%, rgba(0, 0, 0, 0.34));
  }

  .cover-mark { color: hsl(var(--h) 46% 26%); }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .cover {
      background:
        radial-gradient(circle at 22% 26%, hsl(var(--h) 42% 30% / 0.9), transparent 58%),
        linear-gradient(140deg, hsl(var(--h) 34% 22%), hsl(var(--h2) 30% 16%));
    }

    :root:not([data-theme='light']) .cover::after {
      background-image:
        linear-gradient(hsl(var(--h) 60% 80% / 0.05) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--h) 60% 80% / 0.05) 1px, transparent 1px);
    }

    :root:not([data-theme='light']) .cover-mark { color: hsl(var(--h) 60% 82%); }
  }

  /* --- Stars ---------------------------------------------------------------

     A rating is the first thing anybody reads on a listing, and "4.5" is a
     number while ★★★★½ is a judgement. Drawn as a clipped overlay rather than
     as five separate glyphs, so a 4.3 is actually 4.3 wide instead of being
     rounded to the nearest half by the markup. */
  .stars {
    position: relative;
    display: inline-block;
    color: var(--line);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .stars > span {
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; filter: none; transition: none; }
    * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
</style>

{{-- Icon safelist.

  Crosswind generates an icon's CSS by finding the class as a literal in the
  source. Cards and category tiles build theirs at runtime from the business's
  cuisine (`'i-hugeicons-' + card.icon`), which no scanner can see, so every
  such class is written out once here. Without this the markup is correct, the
  class is applied, and the icon is simply invisible.

  Kept in the head partial so one list covers every page that renders a card. --}}
<div hidden aria-hidden="true">
  <i class="i-hugeicons-restaurant-01"></i><i class="i-hugeicons-coffee-01"></i>
  <i class="i-hugeicons-plant-01"></i><i class="i-hugeicons-bread-01"></i>
  <i class="i-hugeicons-shopping-basket-01"></i><i class="i-hugeicons-drink"></i>
  <i class="i-hugeicons-sushi-01"></i><i class="i-hugeicons-noodles"></i>
  <i class="i-hugeicons-rice-bowl-01"></i><i class="i-hugeicons-pizza-01"></i>
  <i class="i-hugeicons-hamburger-01"></i><i class="i-hugeicons-egg-fried"></i>
  <i class="i-hugeicons-taco-01"></i><i class="i-hugeicons-fish-food"></i>
  <i class="i-hugeicons-shellfish"></i><i class="i-hugeicons-steak"></i>
  <i class="i-hugeicons-salad"></i><i class="i-hugeicons-organic-food"></i>
  <i class="i-hugeicons-vegetarian-food"></i><i class="i-hugeicons-ice-cream-01"></i>
  <i class="i-hugeicons-tea"></i><i class="i-hugeicons-croissant"></i>
  <i class="i-hugeicons-carrot"></i><i class="i-hugeicons-apple-01"></i>
  <i class="i-hugeicons-french-fries-01"></i><i class="i-hugeicons-cheese"></i>
  <i class="i-hugeicons-user-circle"></i><i class="i-hugeicons-google"></i>
  <i class="i-hugeicons-apple"></i><i class="i-hugeicons-github"></i>
  <i class="i-hugeicons-facebook-01"></i><i class="i-hugeicons-bookmark-02"></i>
  <i class="i-hugeicons-delivery-truck-01"></i><i class="i-hugeicons-star"></i>
  <i class="i-hugeicons-money-bag-02"></i><i class="i-hugeicons-checkmark-circle-02"></i>
  <i class="i-hugeicons-bicycle-01"></i><i class="i-hugeicons-plant-01"></i>
</div>

<script>
  /*
   * Cover photographs: fade them in, and stand out of the way when one fails.
   *
   * Delegated on the document rather than bound per image, because the cards
   * are rendered from a signal after this runs and there is nothing to bind to
   * yet. Capture phase, because `load` and `error` do not bubble.
   *
   * Only the `error` event marks a cover failed. The tempting shortcut -
   * treating `complete && !naturalWidth` as a failure - cannot tell a broken
   * image from a lazy one that has not started yet: both report exactly that,
   * and every card passes through the second state on the tick it is inserted.
   * Reading it as failure hid all sixty photographs behind their fallback.
   *
   * So the sweep only ever confirms success, for the case the listeners cannot
   * catch: an image served from cache that finished before they were attached.
   */
  ;(function () {
    function loaded(image) {
      if (image && image.classList && image.classList.contains('cover-photo'))
        image.setAttribute('data-loaded', '')
    }

    function failed(image) {
      if (image && image.classList && image.classList.contains('cover-photo'))
        image.setAttribute('data-failed', '')
    }

    document.addEventListener('load', function (event) { loaded(event.target) }, true)
    document.addEventListener('error', function (event) { failed(event.target) }, true)

    function sweep() {
      for (const image of document.querySelectorAll('.cover-photo:not([data-loaded])'))
        if (image.complete && image.naturalWidth > 0)
          loaded(image)
    }

    document.addEventListener('DOMContentLoaded', sweep)

    // Signal-rendered grids arrive after that, so sweep again whenever the
    // document grows. An observer rather than a poll: the cards land in one
    // burst when a search resolves, and a timer either misses that burst or
    // runs forever waiting for it.
    new MutationObserver(sweep).observe(document.documentElement, { childList: true, subtree: true })
  })()
</script>

<script>
  /*
   * Make sure this page has a CSRF token before anything tries to POST.
   *
   * The framework seeds this cookie from the router, but these pages are served
   * as built static files and never pass through that step, so in production
   * the cookie was simply absent and every POST answered 403 while the page
   * looked perfect. (Edge caching hid it further: a cached response cannot
   * carry a per-visitor Set-Cookie at all.)
   *
   * Minting it here is sound rather than a bypass. The check is a stateless
   * double submit - the server compares the cookie against the header and
   * requires them to match - and its security rests on the same-origin policy:
   * a page on another origin can neither read this cookie nor set one for this
   * domain, so it cannot produce a request where the two agree. What the
   * framework mints server-side buys nothing extra under that comparison.
   *
   * SameSite=Lax and a two-hour life, matching what the server would have set.
   */
  (function () {
    try {
      if (document.cookie.includes('X-CSRF-Token='))
        return

      const bytes = new Uint8Array(32)
      crypto.getRandomValues(bytes)
      const token = Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('')
      const secure = location.protocol === 'https:' ? '; Secure' : ''

      document.cookie = `X-CSRF-Token=${token}; Path=/; Max-Age=7200; SameSite=Lax${secure}`
    }
    catch {
      // A browser refusing cookies gets a 403 on submit, which is the honest
      // outcome; it must not take the whole page down on the way there.
    }
  })()
</script>

<script>
  /*
   * Language.
   *
   * The pages are built once and served as static files, so translation happens
   * in the browser: a dictionary is fetched for the chosen language and every
   * element carrying a `data-i18n` key is filled from it. The keys live in
   * `locales/*.yml`, which `buddy build:locales` compiles into
   * `public/locales/*.json`.
   *
   * English is what the markup already says, so a failed fetch, an unknown key
   * or a browser with scripting off all leave a page that reads correctly in
   * English rather than a page of empty boxes. That is the whole reason the
   * English text is in the HTML rather than being filled in from a dictionary
   * too.
   *
   * The interface is translated. The invented restaurant descriptions, menus
   * and reviews are not: they are content, and machine-translating a menu is
   * how a demonstration starts lying about what a kitchen serves.
   */
  window.Smakelo = window.Smakelo || {}

  ;(function () {
    const SUPPORTED = ['en', 'de', 'nl']

    function chosen() {
      const asked = new URLSearchParams(location.search).get('lang')

      if (asked && SUPPORTED.includes(asked)) {
        try {
          localStorage.setItem('smakelo.lang', asked)
        }
        catch {}

        return asked
      }

      try {
        const saved = localStorage.getItem('smakelo.lang')

        if (saved && SUPPORTED.includes(saved))
          return saved
      }
      catch {}

      // Only the language part: a Swiss German browser should get German
      // rather than falling through to English on the region tag.
      const browser = (navigator.language || 'en').slice(0, 2).toLowerCase()

      return SUPPORTED.includes(browser) ? browser : 'en'
    }

    const locale = chosen()

    window.Smakelo.locale = locale
    window.Smakelo.dictionary = {}
    window.Smakelo.t = (key, fallback) => window.Smakelo.dictionary[key] || fallback || key

    document.documentElement.lang = locale

    if (locale === 'en')
      return

    fetch(`/locales/${locale}.json`)
      .then(response => response.ok ? response.json() : {})
      .then((dictionary) => {
        window.Smakelo.dictionary = dictionary
        apply()

        // Surfaces that render themselves later ask for this rather than
        // guessing when the dictionary arrived.
        document.dispatchEvent(new CustomEvent('smakelo:locale', { detail: { locale, dictionary } }))
      })
      .catch(() => undefined)

    function apply() {
      for (const element of document.querySelectorAll('[data-i18n]')) {
        const text = window.Smakelo.dictionary[element.dataset.i18n]

        if (text)
          element.textContent = text
      }

      // Placeholders and titles need the same treatment, keyed separately so
      // one element can translate both its text and its placeholder.
      for (const element of document.querySelectorAll('[data-i18n-placeholder]')) {
        const text = window.Smakelo.dictionary[element.dataset.i18nPlaceholder]

        if (text)
          element.setAttribute('placeholder', text)
      }
    }

    window.Smakelo.applyTranslations = apply
  })()
</script>
