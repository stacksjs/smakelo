  <i class="i-hugeicons-bicycle-01"></i><i class="i-hugeicons-plant-01"></i>
</div>

<script>
  /*
   * Cover photographs: paint a placeholder, then fade the real one in.
   *
   * Every processed image carries a SplatHash - sixteen bytes summarising the
   * picture - on `data-blur`. Decoding one gives a blurred version of the
   * photograph to sit in the frame until the file arrives, so a card is never
   * an empty rectangle and never jumps when the image lands.
   *
   * The hash travels rather than the decoded image because the decoded form is
   * a few kilobytes each, and a page of sixty cards cannot carry sixty of
   * those in its markup. Twenty-four characters can.
   *
   * Decoded lazily, as each image is seen, rather than all at once on load:
   * sixty decodes up front is work done for cards most visitors never scroll
   * to, on the main thread, while the page is still trying to become
   * interactive.
   *
   * Only `error` marks a cover failed. The tempting shortcut - treating
   * `complete && !naturalWidth` as failure - cannot tell a broken image from a
   * lazy one that has not started: both report exactly that, and every card
   * passes through the second state on the tick it is inserted. Reading it as
   * failure once hid all sixty photographs behind their fallback.
   */
  /*
   * The decoder is fetched when the first placeholder is actually wanted.
   *
   * `import()` rather than a static import, for two reasons. It is the right
   * shape: nothing here runs until an image frame comes into view, so a module
   * the page blocks on at parse time would be paid for by every visitor
   * including the ones who never scroll. And a static import only works at the
   * top level of a module, which this script cannot rely on being - the
   * template pipeline decides how it is wrapped, and inside a function the
   * static form is a SyntaxError that stops the whole block from running.
   */
  let decoder = null

  function splathash() {
    decoder = decoder || import('/js/splathash.js')

    return decoder
  }

  function loaded(image) {
    if (image && image.classList && image.classList.contains('cover-photo'))
      image.setAttribute('data-loaded', '')
  }

  function failed(image) {
    if (image && image.classList && image.classList.contains('cover-photo'))
      image.setAttribute('data-failed', '')
  }

  document.addEventListener('load', function (event) { loaded(event.target) }, true)
  document.addEventListener('error', function (event) { failed(event.target) }, true)

  /* One frame's worth of placeholders at a time. A screen holds a handful;
     decoding the rest can wait for the scroll that asks for them. */
  const waiting = new WeakSet()

  const seen = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting)
        continue

      seen.unobserve(entry.target)
      paint(entry.target)
    }
  }, { rootMargin: '400px' })

  function paint(frame) {
    const hash = frame.dataset.blur

    if (!hash)
      return

    splathash().then(function (module) {
      frame.style.backgroundImage = `url("${module.splatHashToDataURL(module.splatHashFromBase64(hash))}")`
      frame.style.backgroundSize = 'cover'
      frame.style.backgroundPosition = 'center'
    }).catch(function () {
      // A hash that will not decode, or a decoder that will not load, leaves
      // the coloured ground - which is a complete backdrop on its own. The
      // decoder throws on a malformed hash rather than painting noise, which
      // is why this is a no-op and not a broken frame.
    })
  }

  function sweep() {
    for (const image of document.querySelectorAll('.cover-photo:not([data-loaded])')) {
      if (image.complete && image.naturalWidth > 0)
        loaded(image)
    }

    for (const frame of document.querySelectorAll('.cover[data-blur]')) {
      if (waiting.has(frame))
        continue

      waiting.add(frame)
      seen.observe(frame)
    }
  }

  document.addEventListener('DOMContentLoaded', sweep)

  // Signal-rendered grids arrive after that, so sweep again whenever the
  // document grows. An observer rather than a poll: the cards land in one
  // burst when a search resolves, and a timer either misses that burst or
  // runs forever waiting for it.
  new MutationObserver(sweep).observe(document.documentElement, { childList: true, subtree: true })

  sweep()
</script>

<script>
  /*
   * Make sure this page has a CSRF token before anything tries to POST.
   *
   * The framework seeds this cookie from the router, but these pages are served
   * as built static files and never pass through that step, so in production
   * the cookie was simply absent and every POST answered 403 while the page
   * looked perfect. (Edge caching hid it further: a cached response cannot
   * carry a per-visitor Set-Cookie at all.)
   *
   * Minting it here is sound rather than a bypass. The check is a stateless
   * double submit - the server compares the cookie against the header and
   * requires them to match - and its security rests on the same-origin policy:
   * a page on another origin can neither read this cookie nor set one for this
   * domain, so it cannot produce a request where the two agree. What the
   * framework mints server-side buys nothing extra under that comparison.
   *
   * SameSite=Lax and a two-hour life, matching what the server would have set.
   */
  (function () {
    try {
      if (document.cookie.includes('X-CSRF-Token='))
        return

      const bytes = new Uint8Array(32)
      crypto.getRandomValues(bytes)
      const token = Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('')
      const secure = location.protocol === 'https:' ? '; Secure' : ''

      document.cookie = `X-CSRF-Token=${token}; Path=/; Max-Age=7200; SameSite=Lax${secure}`
    }
    catch {
      // A browser refusing cookies gets a 403 on submit, which is the honest
      // outcome; it must not take the whole page down on the way there.
    }
  })()
</script>

{{-- Language, for the parts of the page a script writes.

  Everything the server rendered is already in the visitor's language: the
  views server resolves the locale from the URL prefix, the cookie or the
  Accept-Language header, and `t()` in a template answers in it. See
  config/site.ts.

  What is left is the handful of strings a client script produces after the
  page has loaded - a map popup, a card built from a search result, an error
  under a form. Those cannot call `t()`, so the server hands them down here,
  already translated, as one small object.

  Carried on a data attribute rather than written into a `<script>`: stx does
  not interpolate inside script tags, so a `{{ currentLocale() }}` in one reaches the
  browser as the four literal characters. Every other server-to-client handoff
  in this app goes through a data attribute for the same reason.

  This holder carries the strings every page needs. A page with a vocabulary
  of its own - the kitchen board, the courier screen, the checkout - adds a
  second holder of its own with `data-i18n-strings`, and the lookup below
  merges them. Shipping every operator screen's wording to every visitor's
  home page would be a few kilobytes spent on words that page will never
  show.

  The interface is translated. The invented restaurant descriptions, menus and
  reviews are not: they are content, and machine-translating a menu is how a
  demonstration starts lying about what a kitchen serves. --}}
<div
  id="smakelo-i18n"
  hidden
  data-locale="{{ currentLocale() }}"
  data-i18n-strings="{{ JSON.stringify({
    'search.open_now': t('search.open_now'),
    'search.takes_orders': t('search.takes_orders'),
    'search.no_results': t('search.no_results'),
    'search.nearby': t('search.nearby'),
    'business.open': t('business.open'),
    'business.closed': t('business.closed'),
    'business.save': t('business.save'),
    'business.saved': t('business.saved'),
    'business.hours_unknown': t('business.hours_unknown'),
    'business.no_reviews': t('business.no_reviews'),
    'order.delivery': t('order.delivery'),
    'order.pickup': t('order.pickup'),
    'order.dine_in': t('order.dine_in'),
    'common.loading': t('common.loading'),
    'common.error': t('common.error'),
    'common.retry': t('common.retry'),
    'types.restaurant': t('types.restaurant'),
    'types.cafe': t('types.cafe'),
    'types.farm': t('types.farm'),
    'types.bakery': t('types.bakery'),
    'types.bar': t('types.bar'),
    'types.grocery': t('types.grocery'),
    'home.subscribe_button': t('home.subscribe_button'),
    'home.subscribe_busy': t('home.subscribe_busy'),
    'home.subscribe_bad_email': t('home.subscribe_bad_email'),
    'home.subscribe_failed': t('home.subscribe_failed'),
    'search.all_types': t('search.all_types'),
    'place.open_now': t('place.open_now'),
    'discover.result': t('discover.result'),
    'discover.results': t('discover.results'),
    'discover.any_price': t('discover.any_price'),
    'discover.average': t('discover.average'),
    'discover.more_filters': t('discover.more_filters'),
    'discover.fewer_filters': t('discover.fewer_filters'),
    'discover.show_closed': t('discover.show_closed', { count: '{count}' }),
    'discover.popup_order': t('discover.popup_order'),
    'discover.popup_details': t('discover.popup_details'),
    'business.save_name': t('business.save_name', { name: '{name}' }),
  }) }}"
></div>

<script>
  ;(function () {
    window.Smakelo = window.Smakelo || {}
    window.Smakelo.locale = (document.getElementById('smakelo-i18n') || {}).dataset?.locale || 'en'

    var strings = null

    /*
     * Every holder on the page, merged.
     *
     * Collected on demand rather than here, because this script runs in the
     * <head> and a page's own holder is further down the document - at the
     * moment this line executes it does not exist yet. Nothing asks for a
     * string before the client scripts run, which is well after the body has
     * been parsed.
     */
    function collect() {
      var merged = {}
      var holders = document.querySelectorAll('[data-i18n-strings]')

      for (var i = 0; i < holders.length; i++) {
        try {
          var parsed = JSON.parse(holders[i].dataset.i18nStrings || '{}')

          for (var key in parsed)
            merged[key] = parsed[key]
        }
        catch (error) {
          // An unparseable holder leaves its keys on their English fallbacks,
          // which is a page in one language rather than a page of key names.
        }
      }

      strings = merged
      window.Smakelo.strings = merged

      return merged
    }

    /*
     * The lookup a client script calls.
     *
     * Takes the English text as its second argument rather than falling back
     * to the key, so a string no holder carries renders as English rather
     * than as `search.open_now`. A page in the wrong language is a bug; a
     * page showing its own key names is a broken page.
     */
    window.Smakelo.t = function (key, english) {
      var table = strings || collect()

      return table[key] || english || key
    }

    // A client-side hop swaps the body, and with it the page's own holder.
    function forget() {
      strings = null
    }

    window.addEventListener('stx:navigate', forget)
    window.addEventListener('popstate', forget)
  })()
</script>
