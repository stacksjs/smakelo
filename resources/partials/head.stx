  <i class="i-hugeicons-money-bag-02"></i><i class="i-hugeicons-checkmark-circle-02"></i>
  <i class="i-hugeicons-favourite"></i><i class="i-hugeicons-plus-sign"></i>
  <i class="i-hugeicons-minus-sign"></i><i class="i-hugeicons-target-02"></i>
  <i class="i-hugeicons-arrow-expand-01"></i><i class="i-hugeicons-cancel-01"></i>
